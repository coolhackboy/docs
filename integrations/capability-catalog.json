{
  "openapi": "3.1.0",
  "info": {
    "title": "PoYo Capability Catalog and Tasks API",
    "version": "1.0.0",
    "description": "Capability Catalog and common asynchronous generation operations used by PoYo MCP, CLI, and Agent Skills."
  },
  "servers": [
    {
      "url": "https://api.poyo.ai"
    }
  ],
  "paths": {
    "/v1/catalog/models": {
      "get": {
        "operationId": "listModelCapabilities",
        "summary": "Search enabled model capabilities",
        "parameters": [
          {
            "name": "service_type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["chat", "generate"]
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tags",
            "in": "query",
            "description": "Repeat this parameter to require multiple tags.",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Capability page"
          }
        }
      }
    },
    "/v1/catalog/models/{model_id}": {
      "get": {
        "operationId": "getModelCapability",
        "summary": "Get one model capability",
        "parameters": [
          {
            "name": "model_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Model capability"
          },
          "404": {
            "description": "Model capability not found"
          }
        }
      }
    },
    "/v1/catalog/categories": {
      "get": {
        "operationId": "listModelCategories",
        "summary": "List model categories",
        "responses": {
          "200": {
            "description": "Category summaries"
          }
        }
      }
    },
    "/api/generate/status/{task_id}": {
      "get": {
        "operationId": "getGenerationTask",
        "summary": "Get generation task status",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task status and outputs"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
