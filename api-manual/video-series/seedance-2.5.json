{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - Seedance 2.5 API",
    "description": "Generate videos with Seedance 2.5 from text, frames, or multimodal references",
    "version": "1.0.0"
  },
  "servers": [{"url": "https://api.poyo.ai", "description": "Production server"}],
  "security": [{"BearerAuth": []}],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "Submit a Seedance 2.5 video task",
        "operationId": "submitSeedance25Task",
        "tags": ["Seedance 2.5"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/SubmitRequest"},
              "examples": {
                "text-to-video": {"value": {"model": "seedance-2.5", "input": {"prompt": "A cinematic aerial view of a city at night", "duration": 5, "resolution": "720p", "aspect_ratio": "16:9", "generate_audio": true}}},
                "first-last-frame": {"value": {"model": "seedance-2.5", "input": {"prompt": "Transition smoothly between the two frames", "image_urls": ["https://example.com/first.jpg", "https://example.com/last.jpg"], "duration": 5, "resolution": "720p"}}},
                "reference-to-video": {"value": {"model": "seedance-2.5", "input": {"prompt": "Use @Video1 for motion and @Audio1 for rhythm", "reference_video_urls": ["https://example.com/reference.mp4"], "reference_audio_urls": ["https://example.com/reference.wav"], "duration": 5, "resolution": "480p"}}}
              }
            }
          }
        },
        "responses": {"200": {"description": "Task submitted successfully"}}
      }
    }
  },
  "components": {
    "securitySchemes": {"BearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "API Key"}},
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": ["model", "input"],
        "properties": {
          "model": {"type": "string", "enum": ["seedance-2.5"]},
          "callback_url": {"type": "string", "format": "uri"},
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prompt", "duration", "resolution"],
            "properties": {
              "prompt": {"type": "string", "minLength": 1},
              "image_urls": {"type": "array", "maxItems": 2, "items": {"type": "string", "format": "uri"}},
              "reference_image_urls": {"type": "array", "maxItems": 30, "items": {"type": "string", "format": "uri"}},
              "reference_video_urls": {"type": "array", "maxItems": 10, "items": {"type": "string", "format": "uri"}},
              "reference_audio_urls": {"type": "array", "maxItems": 10, "items": {"type": "string", "format": "uri"}},
              "resolution": {"type": "string", "enum": ["480p", "720p"]},
              "duration": {"type": "integer", "minimum": 4, "maximum": 30},
              "aspect_ratio": {"type": "string", "enum": ["auto", "21:9", "16:9", "4:3", "1:1", "3:4", "9:16"]},
              "generate_audio": {"type": "boolean"}
            }
          }
        }
      }
    }
  }
}
