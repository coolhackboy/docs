{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - Seedance 2.5 API",
    "description": "The Seedance 2.5 API generates a 4–30 second video from text, first and last frames, or image, video, and audio references at 480p, 720p, or 1080p.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "Submit a Seedance 2.5 video task",
        "operationId": "submitSeedance25Task",
        "tags": [
          "Seedance 2.5"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "text-to-video": {
                  "value": {
                    "model": "seedance-2.5",
                    "input": {
                      "prompt": "A cinematic aerial view of a city at night",
                      "duration": 5,
                      "resolution": "1080p",
                      "aspect_ratio": "16:9",
                      "generate_audio": true
                    }
                  }
                },
                "first-last-frame": {
                  "value": {
                    "model": "seedance-2.5",
                    "input": {
                      "prompt": "Transition smoothly between the two frames",
                      "image_urls": [
                        "https://example.com/first.jpg",
                        "https://example.com/last.jpg"
                      ],
                      "duration": 5,
                      "resolution": "720p"
                    }
                  }
                },
                "reference-to-video": {
                  "value": {
                    "model": "seedance-2.5",
                    "input": {
                      "prompt": "Use @Video1 for motion and @Audio1 for rhythm",
                      "reference_video_urls": [
                        "https://example.com/reference.mp4"
                      ],
                      "reference_audio_urls": [
                        "https://example.com/reference.wav"
                      ],
                      "duration": 5,
                      "resolution": "480p"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted successfully"
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "All API endpoints require Bearer Token authentication.\n\nCreate an API key: sign in to PoYo, open **Dashboard → API Key** at [poyo.ai/dashboard/api-key](https://poyo.ai/dashboard/api-key), and click to create a key.\n\nAdd it to the request header:\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "seedance-2.5"
            ]
          },
          "callback_url": {
            "type": "string",
            "format": "uri"
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "prompt",
              "duration",
              "resolution"
            ],
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "image_urls": {
                "type": "array",
                "maxItems": 2,
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "reference_image_urls": {
                "type": "array",
                "maxItems": 30,
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "reference_video_urls": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "reference_audio_urls": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "480p",
                  "720p",
                  "1080p"
                ]
              },
              "duration": {
                "type": "integer",
                "minimum": 4,
                "maximum": 30
              },
              "aspect_ratio": {
                "type": "string",
                "enum": [
                  "auto",
                  "21:9",
                  "16:9",
                  "4:3",
                  "1:1",
                  "3:4",
                  "9:16"
                ]
              },
              "generate_audio": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "Business status code. `200` means success; any other value means the request failed. Always check this field: some validation errors return HTTP 200 with `code: 400` in the body.\n\n- `200`: Success\n- `400`: Invalid request parameters\n- `401`: Missing or invalid API key\n- `402`: Insufficient credits\n- `403`: Permission denied\n- `404`: Resource not found\n- `408`: Request timeout\n- `429`: Rate limit exceeded\n- `500`: Internal server error\n- `502`: Upstream service error\n- `503`: Service unavailable\n\nSee [Error Codes](/api-manual/error-codes) for details."
          },
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error"
              }
            }
          }
        }
      }
    }
  }
}
