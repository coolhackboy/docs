{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - Wan 3.0 Video API",
    "description": "Wan 3.0 text, image, and multimodal reference video generation.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "Production server"
    }
  ],
  "security": [{"BearerAuth": []}],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "Submit a Wan 3.0 Video Task",
        "description": "Generate video from text, start/end frames, or multimodal references.",
        "operationId": "submitWan30VideoTask",
        "tags": ["Wan 3.0 Video"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/SubmitRequest"},
              "examples": {
                "standard-text-to-video": {
                  "summary": "Standard text to video",
                  "value": {
                    "model": "wan3.0-text-to-video",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "A kitten runs across a moonlit rooftop while neon signs glow in the distance.",
                      "resolution": "720p",
                      "aspect_ratio": "16:9",
                      "duration": 5,
                      "audio": true
                    }
                  }
                },
                "standard-image-to-video": {
                  "summary": "Standard first and last frames to video",
                  "value": {
                    "model": "wan3.0-image-to-video",
                    "input": {
                      "prompt": "Move from a calm expression into a joyful laugh with a slow camera push-in.",
                      "image_urls": [
                        "https://example.com/first-frame.jpg",
                        "https://example.com/last-frame.jpg"
                      ],
                      "resolution": "1080p",
                      "duration": 8,
                      "audio": true,
                      "seed": 12345
                    }
                  }
                },
                "standard-reference-to-video": {
                  "summary": "Standard multimodal reference to video",
                  "value": {
                    "model": "wan3.0-reference-to-video",
                    "input": {
                      "prompt": "Image1 follows the motion in Video1 while using the rhythm from Audio1.",
                      "reference_image_urls": ["https://example.com/character.png"],
                      "reference_video_urls": ["https://example.com/motion.mp4"],
                      "reference_audio_urls": ["https://example.com/rhythm.mp3"],
                      "resolution": "720p",
                      "aspect_ratio": "adaptive",
                      "duration": 5,
                      "audio": true
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted successfully",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/SubmitResponse"}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "Send your API key as `Authorization: Bearer YOUR_API_KEY`."
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": ["model", "input"],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "wan3.0-text-to-video",
              "wan3.0-image-to-video",
              "wan3.0-reference-to-video"
            ],
            "description": "Wan 3.0 public model identifier."
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "Optional webhook callback URL."
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "prompt": {
                "type": "string",
                "maxLength": 20000,
                "description": "Required for text-to-video and reference-to-video; optional for image-to-video."
              },
              "image_urls": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {"type": "string", "format": "uri"},
                "description": "Image-to-video start frame and optional end frame."
              },
              "reference_image_urls": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {"type": "string", "format": "uri"},
                "description": "Reference images for reference-to-video."
              },
              "reference_video_urls": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {"type": "string", "format": "uri"},
                "description": "Reference videos for reference-to-video."
              },
              "reference_audio_urls": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {"type": "string", "format": "uri"},
                "description": "Reference audio clips for reference-to-video."
              },
              "reference_file_urls": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {"type": "string", "format": "uri"},
                "description": "One reference document. Cannot be combined with reference_link_urls."
              },
              "reference_link_urls": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {"type": "string", "format": "uri"},
                "description": "One publicly accessible webpage. Cannot be combined with reference_file_urls."
              },
              "resolution": {
                "type": "string",
                "enum": ["480p", "720p", "1080p"],
                "default": "720p"
              },
              "aspect_ratio": {
                "type": "string",
                "enum": ["adaptive", "16:9", "4:3", "1:1", "3:4", "9:16"],
                "default": "adaptive"
              },
              "duration": {
                "type": "integer",
                "minimum": 2,
                "maximum": 30,
                "default": 5,
                "description": "Generated video duration in seconds."
              },
              "audio": {
                "type": "boolean",
                "default": true,
                "description": "Whether to generate an output audio track."
              },
              "seed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "enable_safety_checker": {
                "type": "boolean",
                "default": true,
                "description": "Whether to enable content safety checking."
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": ["code", "data"],
        "properties": {
          "code": {"type": "integer", "example": 200},
          "data": {
            "type": "object",
            "required": ["task_id", "status", "created_time"],
            "properties": {
              "task_id": {"type": "string", "example": "task-unified-1787654321-abcd1234"},
              "status": {"type": "string", "enum": ["not_started"]},
              "created_time": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    }
  }
}
