{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - Hailuo 03 API",
    "description": "Generate 2K videos from text, keyframes, or multimodal references",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "Submit Hailuo 03 Task",
        "operationId": "submitHailuo03Task",
        "tags": [
          "Hailuo 03"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "text-to-video": {
                  "summary": "Text to Video",
                  "value": {
                    "model": "hailuo-03",
                    "input": {
                      "prompt": "A cinematic aerial view of a coastal city at sunrise",
                      "duration": 5,
                      "resolution": "2K",
                      "aspect_ratio": "16:9"
                    }
                  }
                },
                "image-to-video": {
                  "summary": "First and Last Frame",
                  "value": {
                    "model": "hailuo-03",
                    "input": {
                      "prompt": "The camera glides forward as daylight turns into sunset",
                      "duration": 8,
                      "resolution": "2K",
                      "image_urls": [
                        "https://storage.poyo.ai/examples/hailuo-03/start.jpg",
                        "https://storage.poyo.ai/examples/hailuo-03/end.jpg"
                      ]
                    }
                  }
                },
                "reference-images": {
                  "summary": "Reference Images",
                  "value": {
                    "model": "hailuo-03",
                    "input": {
                      "prompt": "Image 1 walks through the environment shown in Image 2",
                      "duration": 10,
                      "resolution": "2K",
                      "aspect_ratio": "adaptive",
                      "reference_image_urls": [
                        "https://storage.poyo.ai/examples/hailuo-03/subject.jpg",
                        "https://storage.poyo.ai/examples/hailuo-03/style.jpg"
                      ]
                    }
                  }
                },
                "reference-video": {
                  "summary": "Reference Video",
                  "value": {
                    "model": "hailuo-03",
                    "input": {
                      "prompt": "Use the motion from Video 1",
                      "duration": 5,
                      "resolution": "2K",
                      "reference_video_urls": [
                        "https://storage.poyo.ai/examples/hailuo-03/motion.mp4"
                      ]
                    }
                  }
                },
                "multimodal-reference": {
                  "summary": "Combined Image, Video, and Audio References",
                  "value": {
                    "model": "hailuo-03",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "Image 1 follows the movement in Video 1 with the atmosphere of Audio 1",
                      "duration": 10,
                      "resolution": "2K",
                      "aspect_ratio": "16:9",
                      "reference_image_urls": [
                        "https://storage.poyo.ai/examples/hailuo-03/character.jpg"
                      ],
                      "reference_video_urls": [
                        "https://storage.poyo.ai/examples/hailuo-03/motion.mp4"
                      ],
                      "reference_audio_urls": [
                        "https://storage.poyo.ai/examples/hailuo-03/atmosphere.mp3"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "All API endpoints require Bearer Token authentication.\n\nCreate an API key: sign in to PoYo, open **Dashboard → API Key** at [poyo.ai/dashboard/api-key](https://poyo.ai/dashboard/api-key), and click to create a key.\n\nAdd it to the request header:\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "hailuo-03"
            ],
            "example": "hailuo-03"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "Optional webhook callback URL."
          },
          "input": {
            "$ref": "#/components/schemas/Hailuo03Input"
          }
        }
      },
      "Hailuo03Input": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "Text prompt. Reference assets by modality and order, for example Image 1, Video 1, or Audio 1."
          },
          "duration": {
            "type": "integer",
            "minimum": 5,
            "maximum": 15,
            "default": 5,
            "description": "Generated video duration in seconds."
          },
          "resolution": {
            "type": "string",
            "enum": [
              "2K"
            ],
            "default": "2K"
          },
          "aspect_ratio": {
            "type": "string",
            "enum": [
              "adaptive",
              "21:9",
              "16:9",
              "4:3",
              "1:1",
              "3:4",
              "9:16"
            ],
            "description": "Available for text-to-video and reference-to-video. Image-to-video follows the first image."
          },
          "image_urls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "Starting frame and optional ending frame. Cannot be combined with reference fields."
          },
          "reference_image_urls": {
            "type": "array",
            "maxItems": 9,
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "Subject or style reference images."
          },
          "reference_video_urls": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "Reference video clips. Each clip must be 2–15 seconds and combined duration must not exceed 15 seconds."
          },
          "reference_audio_urls": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "Reference audio clips. Each clip must be 2–15 seconds. Audio requires at least one reference image or video."
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "Business status code. `200` means success; any other value means the request failed. Always check this field: some validation errors return HTTP 200 with `code: 400` in the body.\n\n- `200`: Success\n- `400`: Invalid request parameters\n- `401`: Missing or invalid API key\n- `402`: Insufficient credits\n- `403`: Permission denied\n- `404`: Resource not found\n- `408`: Request timeout\n- `429`: Rate limit exceeded\n- `500`: Internal server error\n- `502`: Upstream service error\n- `503`: Service unavailable\n\nSee [Error Codes](/api-manual/error-codes) for details."
          },
          "message": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "type": "object",
            "properties": {
              "task_id": {
                "type": "string",
                "example": "8FDN1I7M7Q68DDG8"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "Business status code. `200` means success; any other value means the request failed. Always check this field: some validation errors return HTTP 200 with `code: 400` in the body.\n\n- `200`: Success\n- `400`: Invalid request parameters\n- `401`: Missing or invalid API key\n- `402`: Insufficient credits\n- `403`: Permission denied\n- `404`: Resource not found\n- `408`: Request timeout\n- `429`: Rate limit exceeded\n- `500`: Internal server error\n- `502`: Upstream service error\n- `503`: Service unavailable\n\nSee [Error Codes](/api-manual/error-codes) for details."
          },
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error"
              }
            }
          }
        }
      }
    }
  }
}
