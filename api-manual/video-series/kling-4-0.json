{
  "openapi": "3.0.0",
  "info": {
    "title": "Kling 4.0",
    "description": "Generate videos from text, reference images, and reference videos.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "Submit a Kling 4.0 video task",
        "operationId": "submit_kling_4_0",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "text-to-video": {
                  "summary": "Generate video from a text prompt",
                  "value": {
                    "model": "kling-4.0",
                    "input": {
                      "prompt": "A paper boat floats through a miniature city at sunset."
                    }
                  }
                },
                "reference-image": {
                  "summary": "Guide the video with a reference image",
                  "value": {
                    "model": "kling-4.0",
                    "input": {
                      "prompt": "The character in @image_1 walks along a sunlit forest trail.",
                      "reference_image_urls": [
                        "https://example.com/character.png"
                      ],
                      "duration": 10,
                      "resolution": "1080p",
                      "aspect_ratio": "16:9"
                    }
                  }
                },
                "reference-video": {
                  "summary": "Guide movement with a reference video",
                  "value": {
                    "model": "kling-4.0",
                    "input": {
                      "prompt": "Recreate the camera movement from @video_1 in a snowy mountain landscape.",
                      "reference_video_urls": [
                        "https://example.com/camera-motion.mp4"
                      ],
                      "duration": 10
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "kling-4.0"
            ],
            "description": "Public model identifier."
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "Optional webhook URL for task completion or failure notifications."
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "prompt"
            ],
            "description": "Text instructions with up to 10 reference images and up to 5 reference videos. The combined duration of all reference videos must not exceed 30 seconds.",
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000,
                "pattern": "\\S",
                "description": "Video instructions. Use @image_1 and @video_1 to reference the first item in the corresponding reference array. Reference indexes start at 1."
              },
              "duration": {
                "type": "integer",
                "minimum": 3,
                "maximum": 30,
                "default": 5,
                "description": "Output duration in whole seconds."
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "720p",
                  "1080p"
                ],
                "default": "720p",
                "description": "Output video resolution."
              },
              "aspect_ratio": {
                "type": "string",
                "enum": [
                  "auto",
                  "16:9",
                  "9:16",
                  "1:1",
                  "21:9"
                ],
                "description": "Output aspect ratio. When omitted, adapts to supplied materials; without materials, defaults to 16:9."
              },
              "reference_image_urls": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                },
                "description": "Up to 10 publicly accessible HTTP or HTTPS reference image URLs. Reference them as @image_1, @image_2, and so on, in array order."
              },
              "reference_video_urls": {
                "type": "array",
                "maxItems": 5,
                "x-video-duration-seconds": {
                  "minimum": 3,
                  "maximum": 30
                },
                "items": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                },
                "description": "Publicly accessible HTTP or HTTPS reference videos, each lasting 3-30 seconds. Reference them as @video_1, @video_2, and so on, in array order. Provide at most 5 videos with a combined duration of at most 30 seconds."
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1792741800-example"
              },
              "status": {
                "type": "string",
                "enum": [
                  "not_started"
                ],
                "example": "not_started"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2026-10-23T10:30:00"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400
          },
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error"
              }
            }
          }
        }
      }
    }
  }
}
