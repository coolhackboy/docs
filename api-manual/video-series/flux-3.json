{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - Flux 3 Video API",
    "description": "Create videos from text, images, first and last frames, source video, or positioned keyframes.",
    "version": "1.0.0"
  },
  "servers": [{"url": "https://api.poyo.ai", "description": "Production server"}],
  "security": [{"BearerAuth": []}],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "Submit a Flux 3 video task",
        "operationId": "submitFlux3VideoTask",
        "tags": ["Flux 3"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/SubmitRequest"},
              "examples": {
                "text-to-video": {"summary": "Text to video", "value": {"model": "flux-3/text-to-video", "input": {"prompt": "A red panda walks through a sunlit forest", "duration": 5, "resolution": "720p"}}},
                "image-to-video": {"summary": "Image to video", "value": {"model": "flux-3/image-to-video", "input": {"prompt": "The camera slowly moves closer", "image_urls": ["https://example.com/start.png"]}}},
                "first-last-frame": {"summary": "First and last frame", "value": {"model": "flux-3/first-last-frame-to-video", "input": {"prompt": "Transition smoothly between both scenes", "duration": 5, "image_urls": ["https://example.com/start.png", "https://example.com/end.png"]}}},
                "extend-video": {"summary": "Extend video", "value": {"model": "flux-3/extend-video", "input": {"prompt": "Continue tracking as the subject turns", "video_url": "https://example.com/source.mp4"}}},
                "keyframes": {"summary": "Keyframes to video", "value": {"model": "flux-3/keyframes-to-video", "input": {"prompt": "Move smoothly through the keyframes", "duration": 5, "keyframes": [{"image_url": "https://example.com/frame-1.png", "frame_index": 0}, {"image_url": "https://example.com/frame-2.png", "frame_index": 120}]}}}
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Task submitted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SubmitResponse"}}}}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {"BearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "API Key"}},
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": ["model", "input"],
        "properties": {
          "model": {"type": "string", "enum": ["flux-3/text-to-video", "flux-3/image-to-video", "flux-3/first-last-frame-to-video", "flux-3/extend-video", "flux-3/keyframes-to-video"]},
          "callback_url": {"type": "string", "format": "uri"},
          "input": {"$ref": "#/components/schemas/Flux3Input"}
        }
      },
      "Flux3Input": {
        "type": "object",
        "required": ["prompt"],
        "properties": {
          "prompt": {"type": "string", "minLength": 1},
          "duration": {"type": "integer", "minimum": 5, "maximum": 20, "default": 5},
          "resolution": {"type": "string", "enum": ["720p", "1080p"], "default": "720p"},
          "aspect_ratio": {"type": "string", "enum": ["auto", "21:9", "2:1", "16:9", "4:3", "1:1", "3:4", "9:16"], "default": "auto"},
          "sound": {"type": "boolean", "default": true},
          "image_urls": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string"}, "description": "One image for image-to-video or two ordered images for first/last-frame generation."},
          "video_url": {"type": "string", "format": "uri", "description": "MP4 source video, under 50 MB and under 15 seconds."},
          "keyframes": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"$ref": "#/components/schemas/Keyframe"}}
        }
      },
      "Keyframe": {"type": "object", "required": ["image_url", "frame_index"], "properties": {"image_url": {"type": "string"}, "frame_index": {"type": "integer", "minimum": 0}}},
      "SubmitResponse": {"type": "object", "properties": {"code": {"type": "integer", "example": 200}, "data": {"type": "object", "properties": {"task_id": {"type": "string"}, "status": {"type": "string", "example": "not_started"}, "created_time": {"type": "string", "format": "date-time"}}}}}
    }
  }
}
