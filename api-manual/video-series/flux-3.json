{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - Flux 3 Video API",
    "description": "Create videos from text, images, first and last frames, source video, or positioned keyframes.",
    "version": "1.0.0"
  },
  "servers": [{"url": "https://api.poyo.ai", "description": "Production server"}],
  "security": [{"BearerAuth": []}],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "Submit a Flux 3 video task",
        "operationId": "submitFlux3VideoTask",
        "tags": ["Flux 3"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/SubmitRequest"},
              "examples": {
                "text-to-video": {"summary": "Text to video", "value": {"model": "flux-3/text-to-video", "input": {"prompt": "A red panda walks through a sunlit forest", "duration": 5, "resolution": "720p"}}},
                "image-to-video": {"summary": "Image to video", "value": {"model": "flux-3/image-to-video", "input": {"prompt": "The camera slowly moves closer", "image_urls": ["https://example.com/start.png"]}}},
                "first-last-frame": {"summary": "First and last frame", "value": {"model": "flux-3/first-last-frame-to-video", "input": {"prompt": "Transition smoothly between both scenes", "duration": 5, "image_urls": ["https://example.com/start.png", "https://example.com/end.png"]}}},
                "extend-video": {"summary": "Extend video", "value": {"model": "flux-3/extend-video", "input": {"prompt": "Continue tracking as the subject turns", "video_url": "https://example.com/source.mp4"}}},
                "keyframes": {"summary": "Keyframes to video", "value": {"model": "flux-3/keyframes-to-video", "input": {"prompt": "Move smoothly through the keyframes", "duration": 5, "keyframes": [{"image_url": "https://example.com/frame-1.png", "frame_index": 0}, {"image_url": "https://example.com/frame-2.png", "frame_index": 120}]}}}
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Task submitted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SubmitResponse"}}}}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {"BearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "API Key"}},
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": ["model", "input"],
        "properties": {
          "model": {
            "type": "string",
            "description": "Flux 3 workflow to use. The selected model determines which media input field is required.",
            "enum": ["flux-3/text-to-video", "flux-3/image-to-video", "flux-3/first-last-frame-to-video", "flux-3/extend-video", "flux-3/keyframes-to-video"]
          },
          "callback_url": {"type": "string", "format": "uri", "description": "Webhook URL that receives the finished or failed result."},
          "input": {"$ref": "#/components/schemas/Flux3Input"}
        }
      },
      "Flux3Input": {
        "type": "object",
        "required": ["prompt"],
        "properties": {
          "prompt": {"type": "string", "minLength": 1, "description": "Describe the desired scene, motion, and camera behavior (all Flux 3 models)."},
          "duration": {"type": "integer", "minimum": 5, "maximum": 20, "default": 5, "description": "Output duration in seconds (all Flux 3 models)."},
          "resolution": {"type": "string", "enum": ["720p", "1080p"], "default": "720p", "description": "Output resolution (all Flux 3 models)."},
          "aspect_ratio": {"type": "string", "enum": ["auto", "21:9", "2:1", "16:9", "4:3", "1:1", "3:4", "9:16"], "default": "auto", "description": "Output aspect ratio (all Flux 3 models)."},
          "sound": {"type": "boolean", "default": true, "description": "Whether to generate audio (all Flux 3 models)."},
          "image_urls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {"type": "string", "format": "uri"},
            "description": "Source image URLs (image-to-video and first-last-frame-to-video only). Required for these models: provide exactly 1 image for flux-3/image-to-video, or exactly 2 ordered images for flux-3/first-last-frame-to-video. For two images, item 0 is the first frame and item 1 is the last frame.",
            "example": ["https://example.com/start.png"]
          },
          "video_url": {
            "type": "string",
            "format": "uri",
            "description": "Source video URL (flux-3/extend-video only, required). Must be an HTTP(S) MP4 file smaller than 50 MB and shorter than 15 seconds.",
            "example": "https://example.com/source.mp4"
          },
          "keyframes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {"$ref": "#/components/schemas/Keyframe"},
            "description": "Positioned reference images (flux-3/keyframes-to-video only, required). Provide 1–10 keyframes with unique frame_index values on a 24 fps timeline."
          }
        }
      },
      "Keyframe": {
        "type": "object",
        "required": ["image_url", "frame_index"],
        "properties": {
          "image_url": {"type": "string", "format": "uri", "description": "Image URL for this keyframe (flux-3/keyframes-to-video only, required)."},
          "frame_index": {"type": "integer", "minimum": 0, "description": "Unique timeline position from 0 through duration × 24 (flux-3/keyframes-to-video only, required)."}
        }
      },
      "SubmitResponse": {
        "type": "object",
        "properties": {
          "code": {"type": "integer", "example": 200},
          "data": {"type": "object", "properties": {"task_id": {"type": "string"}, "status": {"type": "string", "example": "not_started"}, "created_time": {"type": "string", "format": "date-time"}}}
        }
      }
    }
  }
}
