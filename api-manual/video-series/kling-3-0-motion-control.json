{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - Kling 3.0 Motion Control API",
    "description": "The Kling 3.0 Motion Control API transfers motion from one reference video onto one image at 720p or 1080p. Video orientation allows up to 30 seconds and an optional facial element; image orientation allows up to 10 seconds.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "Submit Kling 3.0 Motion Control Task",
        "description": "Transfer motion from a reference video to a reference image",
        "operationId": "submitKling30MotionControlTask",
        "tags": [
          "Kling 3.0 Motion Control"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "kling-3-0-motion-control": {
                  "summary": "Kling 3.0 Motion Control",
                  "value": {
                    "model": "kling-3.0-motion-control",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "image_urls": [
                        "https://storage.poyo.ai/kling-3.0-motion-control/reference-image-new.png"
                      ],
                      "video_urls": [
                        "https://storage.poyo.ai/kling-3.0-motion-control/reference-video-new.mp4"
                      ],
                      "character_orientation": "video",
                      "resolution": "720p",
                      "prompt": "Keep the identity consistent and reference @Element1 for facial details",
                      "kling_elements": [
                        {
                          "frontal_image_url": "https://example.com/front-face.png",
                          "reference_image_urls": [
                            "https://example.com/face-angle-1.png"
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "All API endpoints require Bearer Token authentication.\n\nCreate an API key: sign in to PoYo, open **Dashboard → API Key** at [poyo.ai/dashboard/api-key](https://poyo.ai/dashboard/api-key), and click to create a key.\n\nAdd it to the request header:\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Kling 3.0 Motion Control model identifier",
            "enum": [
              "kling-3.0-motion-control"
            ]
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "Webhook callback URL for result notifications",
            "example": "https://your-domain.com/callback"
          },
          "input": {
            "type": "object",
            "required": [
              "image_urls",
              "video_urls",
              "character_orientation"
            ],
            "properties": {
              "prompt": {
                "type": "string",
                "description": "Optional prompt for scene details. Can be empty or up to 2,500 characters.",
                "maxLength": 2500,
                "example": "Keep the character movement smooth and natural"
              },
              "image_urls": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "minItems": 1,
                "maxItems": 1,
                "description": "Reference image URL array. Only one image is supported. Supports JPG, JPEG, PNG, max 10MB",
                "example": [
                  "https://storage.poyo.ai/kling-3.0-motion-control/reference-image-new.png"
                ]
              },
              "video_urls": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "minItems": 1,
                "maxItems": 1,
                "description": "Reference video URL array. Only one video is supported. Supports MP4, MOV, max 100MB",
                "example": [
                  "https://storage.poyo.ai/kling-3.0-motion-control/reference-video-new.mp4"
                ]
              },
              "character_orientation": {
                "type": "string",
                "description": "Character orientation mode",
                "enum": [
                  "image",
                  "video"
                ],
                "example": "image"
              },
              "resolution": {
                "type": "string",
                "description": "Output resolution",
                "enum": [
                  "720p",
                  "1080p"
                ],
                "default": "720p",
                "example": "720p"
              },
              "kling_elements": {
                "type": "array",
                "maxItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "frontal_image_url",
                    "reference_image_urls"
                  ],
                  "properties": {
                    "frontal_image_url": {
                      "type": "string",
                      "format": "uri",
                      "description": "Required frontal image URL for the facial element main view. Supports JPG, JPEG, PNG, WebP, max 10MB",
                      "example": "https://example.com/front-face.png"
                    },
                    "reference_image_urls": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "format": "uri"
                      },
                      "minItems": 1,
                      "maxItems": 3,
                      "description": "Additional facial reference image URLs from different angles. 1-3 images are supported",
                      "example": [
                        "https://example.com/face-angle-1.png"
                      ]
                    }
                  }
                },
                "description": "Optional facial consistency element definitions. Only available when `character_orientation` is `video`. Only 1 element is supported and can be referenced in the prompt as `@Element1`. When an element is provided, both `frontal_image_url` and `reference_image_urls` are required",
                "example": [
                  {
                    "frontal_image_url": "https://example.com/front-face.png",
                    "reference_image_urls": [
                      "https://example.com/face-angle-1.png"
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "Business status code. `200` means success; any other value means the request failed. Always check this field: some validation errors return HTTP 200 with `code: 400` in the body.\n\n- `200`: Success\n- `400`: Invalid request parameters\n- `401`: Missing or invalid API key\n- `402`: Insufficient credits\n- `403`: Permission denied\n- `404`: Resource not found\n- `408`: Request timeout\n- `429`: Rate limit exceeded\n- `500`: Internal server error\n- `502`: Upstream service error\n- `503`: Service unavailable\n\nSee [Error Codes](/api-manual/error-codes) for details."
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1757165031-uyujaw3d"
              },
              "status": {
                "type": "string",
                "enum": ["not_started", "running", "finished", "failed"],
                "example": "not_started",
                "description": "Task status. Always `not_started` right after submission. Use [Query Task Status](/api-manual/task-management/status) or `callback_url` to get later states.\n\n- `not_started`: Queued, waiting to be processed\n- `running`: Being generated\n- `finished`: Completed; results are in `files` or `output`\n- `failed`: Failed; details are in `error_message`"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2025-11-12T10:30:00"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "Business status code. `200` means success; any other value means the request failed. Always check this field: some validation errors return HTTP 200 with `code: 400` in the body.\n\n- `200`: Success\n- `400`: Invalid request parameters\n- `401`: Missing or invalid API key\n- `402`: Insufficient credits\n- `403`: Permission denied\n- `404`: Resource not found\n- `408`: Request timeout\n- `429`: Rate limit exceeded\n- `500`: Internal server error\n- `502`: Upstream service error\n- `503`: Service unavailable\n\nSee [Error Codes](/api-manual/error-codes) for details."
          },
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error"
              }
            }
          }
        }
      }
    }
  }
}
