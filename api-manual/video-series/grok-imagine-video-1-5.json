{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - Grok Imagine Video 1.5 API",
    "description": "The Grok Imagine Video 1.5 API generates 1–15 second videos from text or one first-frame image at up to 1080p, or from up to seven reference images at up to 720p.",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "Submit Grok Imagine Video 1.5 Task",
        "description": "Selects text, image, or reference mode from the supplied image field.",
        "operationId": "submitGrokImagineVideo15Task",
        "tags": [
          "Grok Imagine Video 1.5"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "text-to-video": {
                  "summary": "Text to video",
                  "value": {
                    "model": "grok-imagine-video-1.5",
                    "input": {
                      "prompt": "A cinematic city at sunrise",
                      "resolution": "1080p",
                      "duration": 6,
                      "aspect_ratio": "16:9"
                    }
                  }
                },
                "image-to-video": {
                  "summary": "Image to video",
                  "value": {
                    "model": "grok-imagine-video-1.5",
                    "input": {
                      "prompt": "Slow camera push-in",
                      "image_urls": [
                        "https://example.com/first-frame.png"
                      ],
                      "resolution": "1080p",
                      "duration": 6
                    }
                  }
                },
                "reference-to-video": {
                  "summary": "Reference to video",
                  "value": {
                    "model": "grok-imagine-video-1.5",
                    "input": {
                      "prompt": "<IMAGE_0> meets <IMAGE_1> in a neon street",
                      "reference_image_urls": [
                        "https://example.com/character.png",
                        "https://example.com/style.png"
                      ],
                      "resolution": "720p",
                      "duration": 8,
                      "aspect_ratio": "16:9"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "All API endpoints require Bearer Token authentication.\n\nCreate an API key: sign in to PoYo, open **Dashboard → API Key** at [poyo.ai/dashboard/api-key](https://poyo.ai/dashboard/api-key), and click to create a key.\n\nAdd it to the request header:\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "grok-imagine-video-1.5"
            ]
          },
          "callback_url": {
            "type": "string",
            "format": "uri"
          },
          "input": {
            "$ref": "#/components/schemas/GenerationInput"
          }
        }
      },
      "GenerationInput": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "description": "Omit image fields for text-to-video. Use image_urls for one first frame, or reference_image_urls for 1–7 references. The image fields are mutually exclusive.",
        "properties": {
          "prompt": {
            "type": "string",
            "maxLength": 4096,
            "description": "Prompt. In reference mode, use <IMAGE_0>, <IMAGE_1>, etc."
          },
          "image_urls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "Single first-frame image for image-to-video."
          },
          "reference_image_urls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 7,
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "Reference images for reference-to-video."
          },
          "resolution": {
            "type": "string",
            "enum": [
              "480p",
              "720p",
              "1080p"
            ],
            "default": "720p",
            "description": "Reference-to-video supports only 480p and 720p."
          },
          "duration": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15,
            "description": "Defaults to 6, or 8 in reference mode."
          },
          "aspect_ratio": {
            "type": "string",
            "enum": [
              "16:9",
              "4:3",
              "3:2",
              "1:1",
              "2:3",
              "3:4",
              "9:16"
            ],
            "default": "16:9",
            "description": "Only for text and reference modes."
          }
        },
        "allOf": [
          {
            "not": {
              "required": [
                "image_urls",
                "reference_image_urls"
              ]
            }
          }
        ]
      },
      "SubmitResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "Business status code. `200` means success; any other value means the request failed. Always check this field: some validation errors return HTTP 200 with `code: 400` in the body.\n\n- `200`: Success\n- `400`: Invalid request parameters\n- `401`: Missing or invalid API key\n- `402`: Insufficient credits\n- `403`: Permission denied\n- `404`: Resource not found\n- `408`: Request timeout\n- `429`: Rate limit exceeded\n- `500`: Internal server error\n- `502`: Upstream service error\n- `503`: Service unavailable\n\nSee [Error Codes](/api-manual/error-codes) for details."
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "task_id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": ["not_started", "running", "finished", "failed"],
                "description": "Task status. Always `not_started` right after submission. Use [Query Task Status](/api-manual/task-management/status) or `callback_url` to get later states.\n\n- `not_started`: Queued, waiting to be processed\n- `running`: Being generated\n- `finished`: Completed; results are in `files` or `output`\n- `failed`: Failed; details are in `error_message`"
              },
              "created_time": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "Business status code. `200` means success; any other value means the request failed. Always check this field: some validation errors return HTTP 200 with `code: 400` in the body.\n\n- `200`: Success\n- `400`: Invalid request parameters\n- `401`: Missing or invalid API key\n- `402`: Insufficient credits\n- `403`: Permission denied\n- `404`: Resource not found\n- `408`: Request timeout\n- `429`: Rate limit exceeded\n- `500`: Internal server error\n- `502`: Upstream service error\n- `503`: Service unavailable\n\nSee [Error Codes](/api-manual/error-codes) for details."
          },
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error"
              }
            }
          }
        }
      }
    }
  }
}
