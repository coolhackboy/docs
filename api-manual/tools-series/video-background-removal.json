{
  "openapi": "3.0.0",
  "info": {
    "title": "Video Background Removal",
    "description": "Remove the background from a video.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "Submit a video background removal task",
        "operationId": "submit_video_background_removal",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "transparent": {
                  "summary": "Transparent background as WebM",
                  "value": {
                    "model": "poyo-ai/video-background-removal",
                    "input": {
                      "video_url": "https://example.com/dancer.mp4",
                      "background_color": "Transparent",
                      "output_container_and_codec": "webm_vp9",
                      "preserve_audio": true
                    }
                  }
                },
                "green": {
                  "summary": "Green screen as MP4",
                  "value": {
                    "model": "poyo-ai/video-background-removal",
                    "input": {
                      "video_url": "https://example.com/dancer.mp4",
                      "background_color": "Green",
                      "output_container_and_codec": "mp4_h264"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "All API endpoints require Bearer Token authentication.\n\nCreate an API key: sign in to PoYo, open **Dashboard → API Key** at [poyo.ai/dashboard/api-key](https://poyo.ai/dashboard/api-key), and click to create a key.\n\nAdd it to the request header:\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "poyo-ai/video-background-removal"
            ],
            "description": "Public model identifier."
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "Optional webhook URL for task completion or failure notifications."
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "video_url"
            ],
            "properties": {
              "video_url": {
                "type": "string",
                "format": "uri",
                "description": "Source video URL. Must be a publicly accessible HTTP or HTTPS URL."
              },
              "output_container_and_codec": {
                "type": "string",
                "enum": [
                  "mp4_h265",
                  "mp4_h264",
                  "webm_vp9",
                  "mov_h265",
                  "mov_proresks",
                  "mkv_h265",
                  "mkv_h264",
                  "mkv_vp9",
                  "gif"
                ],
                "description": "Output container and codec. Choose a format that supports transparency, such as `webm_vp9` or `mov_proresks`, when `background_color` is `Transparent`. When omitted, the provider default is used."
              },
              "preserve_audio": {
                "type": "boolean",
                "description": "Whether to keep the source audio track. When omitted, the provider default is used."
              },
              "background_color": {
                "type": "string",
                "enum": [
                  "Transparent",
                  "Black",
                  "White",
                  "Gray",
                  "Red",
                  "Green",
                  "Blue",
                  "Yellow",
                  "Cyan",
                  "Magenta",
                  "Orange"
                ],
                "description": "Background to put behind the subject. Values are case-sensitive. When omitted, the provider default is used."
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "Business status code. `200` means success; any other value means the request failed. Always check this field: some validation errors return HTTP 200 with `code: 400` in the body.\n\n- `200`: Success\n- `400`: Invalid request parameters\n- `401`: Missing or invalid API key\n- `402`: Insufficient credits\n- `403`: Permission denied\n- `404`: Resource not found\n- `408`: Request timeout\n- `429`: Rate limit exceeded\n- `500`: Internal server error\n- `502`: Upstream service error\n- `503`: Service unavailable\n\nSee [Error Codes](/api-manual/error-codes) for details."
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1793176000-example"
              },
              "status": {
                "type": "string",
                "enum": ["not_started", "running", "finished", "failed"],
                "example": "not_started",
                "description": "Task status. Always `not_started` right after submission. Use [Query Task Status](/api-manual/task-management/status) or `callback_url` to get later states.\n\n- `not_started`: Queued, waiting to be processed\n- `running`: Being generated\n- `finished`: Completed; results are in `files` or `output`\n- `failed`: Failed; details are in `error_message`"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2026-10-28T10:30:00"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "Business status code. `200` means success; any other value means the request failed. Always check this field: some validation errors return HTTP 200 with `code: 400` in the body.\n\n- `200`: Success\n- `400`: Invalid request parameters\n- `401`: Missing or invalid API key\n- `402`: Insufficient credits\n- `403`: Permission denied\n- `404`: Resource not found\n- `408`: Request timeout\n- `429`: Rate limit exceeded\n- `500`: Internal server error\n- `502`: Upstream service error\n- `503`: Service unavailable\n\nSee [Error Codes](/api-manual/error-codes) for details."
          },
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters"
              },
              "type": {
                "type": "string",
                "example": "validation_error"
              }
            }
          }
        }
      }
    }
  }
}
