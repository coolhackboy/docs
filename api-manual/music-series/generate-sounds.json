{
    "openapi": "3.0.0",
    "info": {
        "title": "PoYo Generate Sounds API",
        "version": "1.0.0",
        "description": "Generate sound effects and ambience from a text prompt."
    },
    "servers": [
        {
            "url": "https://api.poyo.ai"
        }
    ],
    "security": [
        {
            "BearerAuth": []
        }
    ],
    "paths": {
        "/api/generate/submit": {
            "post": {
                "operationId": "submitGenerateSounds",
                "summary": "Generate sound effects",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Request"
                            },
                            "example": {
                                "model": "generate-sounds",
                                "input": {
                                    "prompt": "Rain and distant thunder",
                                    "mv": "V5_5",
                                    "sound_loop": true,
                                    "sound_tempo": 90,
                                    "sound_key": "Cm",
                                    "grab_lyrics": false
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Submitted",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Response"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "BearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "description": "All API endpoints require Bearer Token authentication.\n\nCreate an API key: sign in to PoYo, open **Dashboard → API Key** at [poyo.ai/dashboard/api-key](https://poyo.ai/dashboard/api-key), and click to create a key.\n\nAdd it to the request header:\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
            }
        },
        "schemas": {
            "Request": {
                "type": "object",
                "required": [
                    "model",
                    "input"
                ],
                "properties": {
                    "model": {
                        "type": "string",
                        "enum": [
                            "generate-sounds"
                        ]
                    },
                    "callback_url": {
                        "type": "string",
                        "format": "uri"
                    },
                    "input": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "prompt",
                            "mv"
                        ],
                        "properties": {
                            "prompt": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 500
                            },
                            "mv": {
                                "type": "string",
                                "enum": [
                                    "V5",
                                    "V5_5",
                                    "V6",
                                    "V6_MINI",
                                    "V6_WILD"
                                ]
                            },
                            "sound_loop": {
                                "type": "boolean",
                                "default": false
                            },
                            "sound_tempo": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 300
                            },
                            "sound_key": {
                                "type": "string",
                                "enum": [
                                    "Cm",
                                    "C#m",
                                    "Dm",
                                    "D#m",
                                    "Em",
                                    "Fm",
                                    "F#m",
                                    "Gm",
                                    "G#m",
                                    "Am",
                                    "A#m",
                                    "Bm",
                                    "C",
                                    "C#",
                                    "D",
                                    "D#",
                                    "E",
                                    "F",
                                    "F#",
                                    "G",
                                    "G#",
                                    "A",
                                    "A#",
                                    "B"
                                ]
                            },
                            "grab_lyrics": {
                                "type": "boolean",
                                "default": false
                            }
                        }
                    }
                }
            },
            "Response": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "integer",
                        "example": 200,
                        "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
                        "description": "Business status code. `200` means success; any other value means the request failed. Always check this field: some validation errors return HTTP 200 with `code: 400` in the body.\n\n- `200`: Success\n- `400`: Invalid request parameters\n- `401`: Missing or invalid API key\n- `402`: Insufficient credits\n- `403`: Permission denied\n- `404`: Resource not found\n- `408`: Request timeout\n- `429`: Rate limit exceeded\n- `500`: Internal server error\n- `502`: Upstream service error\n- `503`: Service unavailable\n\nSee [Error Codes](/api-manual/error-codes) for details."
                    },
                    "data": {
                        "type": "object",
                        "required": [
                            "task_id",
                            "status",
                            "created_time"
                        ],
                        "properties": {
                            "task_id": {
                                "type": "string"
                            },
                            "status": {
                                "type": "string",
                                "enum": [
                                    "not_started",
                                    "running",
                                    "finished",
                                    "failed"
                                ],
                                "description": "Task status.\n\n- `not_started`: Queued, waiting to be processed\n- `running`: Being generated\n- `finished`: Completed; results are in `files` or `output`\n- `failed`: Failed; details are in `error_message`"
                            },
                            "created_time": {
                                "type": "string",
                                "format": "date-time"
                            }
                        }
                    }
                }
            }
        }
    }
}
