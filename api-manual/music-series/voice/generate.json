{
  "openapi": "3.0.0",
  "info": {"title": "PoYo Suno Voice Generate API", "version": "1.0.0", "description": "Create a reusable Voice ID from a verification recording."},
  "servers": [{"url": "https://api.poyo.ai"}], "security": [{"BearerAuth": []}],
  "paths": {"/api/generate/submit": {"post": {
    "operationId": "submitSunoVoiceGenerate", "summary": "Generate a Suno Voice ID",
    "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Request"}, "example": {"model": "suno-voice-generate", "input": {"task_id": "voice_validate_task_id", "verify_url": "https://example.com/verification.wav", "voice_name": "My Voice", "style": "pop", "singer_skill_level": "advanced"}}}}},
    "responses": {"200": {"description": "Submitted", "content": {"application/json": {
      "schema": {"$ref": "#/components/schemas/Response"},
      "example": {"code": 200, "data": {"task_id": "voice_generate_task_id", "status": "not_started", "created_time": "2026-08-27T10:00:00"}}
    }}}}
  }}},
  "components": {
    "securitySchemes": {"BearerAuth": {"type": "http", "scheme": "bearer"}},
    "schemas": {"Request": {"type": "object", "required": ["model", "input"], "properties": {
      "model": {"type": "string", "enum": ["suno-voice-generate"]}, "callback_url": {"type": "string", "format": "uri"},
      "input": {"type": "object", "additionalProperties": false, "required": ["task_id", "verify_url"], "properties": {
        "task_id": {"type": "string", "minLength": 1, "description": "Task ID returned by Validate Voice or Regenerate Voice Phrase."}, "verify_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
        "voice_name": {"type": "string"}, "description": {"type": "string"}, "style": {"type": "string"},
        "singer_skill_level": {"type": "string", "enum": ["beginner", "intermediate", "advanced", "professional"]}
      }}
    }}, "Response": {
      "type": "object", "required": ["code", "data"], "properties": {
        "code": {"type": "integer", "example": 200},
        "data": {"type": "object", "required": ["task_id", "status", "created_time"], "properties": {"task_id": {"type": "string"}, "status": {"type": "string", "enum": ["not_started", "running", "finished", "failed"]}, "created_time": {"type": "string", "format": "date-time"}}}
      }
    }}
  }
}
