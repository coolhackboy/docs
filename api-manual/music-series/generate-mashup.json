{
    "openapi": "3.1.0",
    "info": {
        "title": "PoYo Generate Mashup API",
        "version": "1.0.0",
        "description": "Blend exactly two audio tracks into a new composition."
    },
    "servers": [
        {
            "url": "https://api.poyo.ai"
        }
    ],
    "security": [
        {
            "BearerAuth": []
        }
    ],
    "paths": {
        "/api/generate/submit": {
            "post": {
                "operationId": "submitGenerateMashup",
                "summary": "Generate a Suno mashup",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Request"
                            },
                            "example": {
                                "model": "generate-mashup",
                                "callback_url": "https://example.com/webhook",
                                "input": {
                                    "upload_url_list": [
                                        "https://example.com/a.mp3",
                                        "https://example.com/b.mp3"
                                    ],
                                    "custom_mode": true,
                                    "instrumental": true,
                                    "mv": "V5_5",
                                    "style": "cinematic",
                                    "title": "Mashup",
                                    "duration": 120
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Submitted",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Response"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "BearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "description": "All API endpoints require Bearer Token authentication.\n\nCreate an API key: sign in to PoYo, open **Dashboard → API Key** at [poyo.ai/dashboard/api-key](https://poyo.ai/dashboard/api-key), and click to create a key.\n\nAdd it to the request header:\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
            }
        },
        "schemas": {
            "Request": {
                "type": "object",
                "required": [
                    "model",
                    "input"
                ],
                "properties": {
                    "model": {
                        "type": "string",
                        "enum": [
                            "generate-mashup"
                        ]
                    },
                    "callback_url": {
                        "type": "string",
                        "format": "uri"
                    },
                    "input": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "upload_url_list",
                            "mv",
                            "style",
                            "title"
                        ],
                        "properties": {
                            "upload_url_list": {
                                "type": "array",
                                "minItems": 2,
                                "maxItems": 2,
                                "items": {
                                    "type": "string",
                                    "format": "uri",
                                    "pattern": "^https?://"
                                }
                            },
                            "custom_mode": {
                                "type": "boolean",
                                "default": true
                            },
                            "instrumental": {
                                "type": "boolean",
                                "default": true
                            },
                            "mv": {
                                "type": "string",
                                "enum": [
                                    "V4",
                                    "V4_5",
                                    "V4_5ALL",
                                    "V4_5PLUS",
                                    "V5",
                                    "V5_5",
                                    "V6",
                                    "V6_MINI",
                                    "V6_WILD"
                                ]
                            },
                            "prompt": {
                                "type": "string",
                                "minLength": 1
                            },
                            "style": {
                                "type": "string",
                                "minLength": 1
                            },
                            "title": {
                                "type": "string",
                                "minLength": 1
                            },
                            "vocal_gender": {
                                "type": "string",
                                "enum": [
                                    "m",
                                    "f"
                                ]
                            },
                            "style_weight": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1,
                                "multipleOf": 0.01
                            },
                            "weirdness_constraint": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1,
                                "multipleOf": 0.01
                            },
                            "audio_weight": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1,
                                "multipleOf": 0.01
                            },
                            "duration": {
                                "type": "integer",
                                "minimum": 10,
                                "maximum": 360
                            },
                            "lyrics": {"type": "string", "maxLength": 5000},
                            "variety": {"type": "integer", "minimum": 0, "maximum": 4},
                            "persona_id": {"type": "string"},
                            "persona_model": {"type": "string", "enum": ["style_persona", "voice_persona"]}
                        },
                        "allOf": [
                            {"if": {"required": ["duration"]}, "then": {"properties": {"mv": {"enum": ["V5_5", "V6", "V6_MINI", "V6_WILD"]}}}},
                            {"if": {"required": ["persona_id"]}, "then": {"properties": {"mv": {"enum": ["V5", "V5_5", "V6", "V6_MINI", "V6_WILD"]}}}},
                            {"if": {"properties": {"custom_mode": {"const": true}, "mv": {"const": "V4"}}}, "then": {"properties": {"prompt": {"maxLength": 3000}, "style": {"maxLength": 200}, "title": {"maxLength": 80}}}},
                            {"if": {"properties": {"custom_mode": {"const": true}, "mv": {"const": "V4_5ALL"}}}, "then": {"properties": {"prompt": {"maxLength": 5000}, "style": {"maxLength": 1000}, "title": {"maxLength": 80}}}},
                            {"if": {"properties": {"custom_mode": {"const": true}, "mv": {"enum": ["V4_5", "V4_5PLUS", "V5", "V5_5", "V6", "V6_MINI", "V6_WILD"]}}}, "then": {"properties": {"prompt": {"maxLength": 5000}, "style": {"maxLength": 1000}, "title": {"maxLength": 100}}}}
                        ]
                    }
                }
            },
            "Response": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "integer",
                        "example": 200,
                        "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
                        "description": "Business status code. `200` means success; any other value means the request failed. Always check this field: some validation errors return HTTP 200 with `code: 400` in the body.\n\n- `200`: Success\n- `400`: Invalid request parameters\n- `401`: Missing or invalid API key\n- `402`: Insufficient credits\n- `403`: Permission denied\n- `404`: Resource not found\n- `408`: Request timeout\n- `429`: Rate limit exceeded\n- `500`: Internal server error\n- `502`: Upstream service error\n- `503`: Service unavailable\n\nSee [Error Codes](/api-manual/error-codes) for details."
                    },
                    "data": {
                        "type": "object",
                        "required": [
                            "task_id",
                            "status",
                            "created_time"
                        ],
                        "properties": {
                            "task_id": {
                                "type": "string"
                            },
                            "status": {
                                "type": "string",
                                "enum": [
                                    "not_started",
                                    "running",
                                    "finished",
                                    "failed"
                                ],
                                "description": "Task status.\n\n- `not_started`: Queued, waiting to be processed\n- `running`: Being generated\n- `finished`: Completed; results are in `files` or `output`\n- `failed`: Failed; details are in `error_message`"
                            },
                            "created_time": {
                                "type": "string",
                                "format": "date-time"
                            }
                        }
                    }
                }
            }
        }
    }
}
