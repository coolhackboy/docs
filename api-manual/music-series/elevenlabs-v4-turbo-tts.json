{
  "openapi": "3.1.0",
  "info": {
    "title": "PoYo AI - ElevenLabs V4 Turbo TTS API",
    "description": "The ElevenLabs V4 Turbo TTS API converts up to 5,000 characters of text into lower-latency speech with voice, stability, and similarity controls. Choose one of 19 audio formats, and optionally receive timestamps as a separate file.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "Submit ElevenLabs V4 Turbo TTS Task",
        "description": "Generate fast speech with voice controls, 19 audio formats, and optional timestamps.",
        "operationId": "submit_elevenlabs_v4_turbo_tts",
        "tags": [
          "ElevenLabs V4 Turbo TTS"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "example-1": {
                  "value": {
                    "model": "elevenlabs-v4-turbo-tts",
                    "input": {
                      "text": "Hello! Welcome to PoYo."
                    }
                  }
                },
                "example-2": {
                  "value": {
                    "model": "elevenlabs-v4-turbo-tts",
                    "input": {
                      "text": "Welcome to PoYo.",
                      "timestamps": true,
                      "output_format": "pcm_24000"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task accepted; query the task for final files.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "elevenlabs-v4-turbo-tts"
            ]
          },
          "input": {
            "$ref": "#/components/schemas/ModelInput"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "Optional completion or failure callback URL."
          }
        }
      },
      "ModelInput": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "output_format": {
            "type": "string",
            "enum": [
              "mp3_22050_32",
              "mp3_44100_32",
              "mp3_44100_64",
              "mp3_44100_96",
              "mp3_44100_128",
              "mp3_44100_192",
              "pcm_8000",
              "pcm_16000",
              "pcm_22050",
              "pcm_24000",
              "pcm_44100",
              "pcm_48000",
              "ulaw_8000",
              "alaw_8000",
              "opus_48000_32",
              "opus_48000_64",
              "opus_48000_96",
              "opus_48000_128",
              "opus_48000_192"
            ],
            "default": "mp3_44100_128",
            "description": "Audio codec, sample rate, and bitrate."
          },
          "language_code": {
            "type": "string",
            "description": "ISO 639-1 language code."
          },
          "apply_text_normalization": {
            "type": "string",
            "enum": [
              "auto",
              "on",
              "off"
            ],
            "default": "auto",
            "description": "Normalize numbers and dates."
          },
          "stability": {
            "type": "number",
            "default": 0.5,
            "maximum": 1,
            "minimum": 0,
            "description": "Voice stability, from 0 to 1."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000,
            "description": "Text. Must contain non-whitespace text."
          },
          "voice": {
            "type": "string",
            "default": "Rachel",
            "minLength": 1,
            "description": "Prebuilt voice for single-speaker speech. Must contain non-whitespace text."
          },
          "similarity_boost": {
            "type": "number",
            "default": 0.75,
            "maximum": 1,
            "minimum": 0,
            "description": "Voice similarity, from 0 to 1."
          },
          "timestamps": {
            "type": "boolean",
            "default": false,
            "description": "Return timing data as a separate JSON file when available."
          }
        },
        "additionalProperties": false
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1757165031-uyujaw3d"
              },
              "status": {
                "type": "string",
                "enum": [
                  "not_started"
                ],
                "example": "not_started"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2026-10-13T10:30:00+08:00"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400
          },
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error"
              }
            }
          }
        }
      }
    }
  }
}
