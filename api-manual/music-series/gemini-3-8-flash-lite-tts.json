{
  "openapi": "3.1.0",
  "info": {
    "title": "PoYo AI - Gemini 3.8 Flash Lite TTS API",
    "description": "The Gemini 3.8 Flash Lite TTS API converts a transcript or a two-speaker dialogue into WAV speech using preset voices and optional style instructions. The complete input is limited to 8,192 tokens.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "Submit Gemini 3.8 Flash Lite TTS Task",
        "description": "Generate native WAV speech from a transcript or a two-speaker dialogue.",
        "operationId": "submit_gemini_3_8_flash_lite_tts",
        "tags": [
          "Gemini 3.8 Flash Lite TTS"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "example-1": {
                  "value": {
                    "model": "gemini-3.8-flash-lite-tts",
                    "input": {
                      "text": "Hello! Welcome to PoYo."
                    }
                  }
                },
                "example-2": {
                  "value": {
                    "model": "gemini-3.8-flash-lite-tts",
                    "input": {
                      "speakers": [
                        {
                          "speaker_id": "host",
                          "voice": "Kore"
                        },
                        {
                          "speaker_id": "guest",
                          "voice": "Puck"
                        }
                      ],
                      "turns": [
                        {
                          "speaker_id": "host",
                          "text": "Welcome!"
                        },
                        {
                          "speaker_id": "guest",
                          "text": "Thank you.",
                          "style_instructions": "Warm and friendly."
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task accepted; query the task for final files.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "All API endpoints require Bearer Token authentication.\n\nCreate an API key: sign in to PoYo, open **Dashboard → API Key** at [poyo.ai/dashboard/api-key](https://poyo.ai/dashboard/api-key), and click to create a key.\n\nAdd it to the request header:\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "gemini-3.8-flash-lite-tts"
            ]
          },
          "input": {
            "$ref": "#/components/schemas/ModelInput"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "Optional completion or failure callback URL."
          }
        }
      },
      "ModelInput": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "enable_safety_checker": {
            "default": true,
            "type": "boolean",
            "description": "Enable input safety checking. Disabling requires account authorization when applicable."
          },
          "speakers": {
            "maxItems": 2,
            "minItems": 2,
            "type": "array",
            "items": {
              "required": [
                "speaker_id",
                "voice"
              ],
              "additionalProperties": false,
              "type": "object",
              "properties": {
                "speaker_id": {
                  "minLength": 1,
                  "type": "string",
                  "description": "Must contain non-whitespace text."
                },
                "voice": {
                  "enum": [
                    "Achernar",
                    "Achird",
                    "Algenib",
                    "Algieba",
                    "Alnilam",
                    "Aoede",
                    "Autonoe",
                    "Callirrhoe",
                    "Charon",
                    "Despina",
                    "Enceladus",
                    "Erinome",
                    "Fenrir",
                    "Gacrux",
                    "Iapetus",
                    "Kore",
                    "Laomedeia",
                    "Leda",
                    "Orus",
                    "Pulcherrima",
                    "Puck",
                    "Rasalgethi",
                    "Sadachbia",
                    "Sadaltager",
                    "Schedar",
                    "Sulafat",
                    "Umbriel",
                    "Vindemiatrix",
                    "Zephyr",
                    "Zubenelgenubi"
                  ],
                  "type": "string"
                }
              }
            },
            "description": "Required together with turns for dialogue. Exactly two speakers with distinct non-empty speaker_id values. Omit text and top-level voice."
          },
          "style_instructions": {
            "type": "string",
            "description": "Global delivery style, separate from the transcript."
          },
          "voice": {
            "enum": [
              "Achernar",
              "Achird",
              "Algenib",
              "Algieba",
              "Alnilam",
              "Aoede",
              "Autonoe",
              "Callirrhoe",
              "Charon",
              "Despina",
              "Enceladus",
              "Erinome",
              "Fenrir",
              "Gacrux",
              "Iapetus",
              "Kore",
              "Laomedeia",
              "Leda",
              "Orus",
              "Pulcherrima",
              "Puck",
              "Rasalgethi",
              "Sadachbia",
              "Sadaltager",
              "Schedar",
              "Sulafat",
              "Umbriel",
              "Vindemiatrix",
              "Zephyr",
              "Zubenelgenubi"
            ],
            "default": "Kore",
            "type": "string",
            "description": "Single-speaker voice, default Kore. Omit when using speakers and turns."
          },
          "turns": {
            "minItems": 1,
            "type": "array",
            "items": {
              "required": [
                "speaker_id",
                "text"
              ],
              "additionalProperties": false,
              "type": "object",
              "properties": {
                "text": {
                  "minLength": 1,
                  "type": "string",
                  "description": "Must contain non-whitespace text."
                },
                "speaker_id": {
                  "minLength": 1,
                  "type": "string",
                  "description": "Must contain non-whitespace text."
                },
                "style_instructions": {
                  "type": "string"
                }
              }
            },
            "description": "Required together with speakers for dialogue. At least one turn; speaker_id must reference a configured speaker. Each turn supports optional style_instructions."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Single-speaker transcript. Required for single-speaker mode. Omit when using speakers and turns. Complete input is limited to 8192 tokens. Must contain non-whitespace text."
          }
        },
        "description": "Use either text (single speaker) or speakers with turns (dialogue). These modes are mutually exclusive; dialogue cannot include top-level text or voice."
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "Business status code. `200` means success; any other value means the request failed. Always check this field: some validation errors return HTTP 200 with `code: 400` in the body.\n\n- `200`: Success\n- `400`: Invalid request parameters\n- `401`: Missing or invalid API key\n- `402`: Insufficient credits\n- `403`: Permission denied\n- `404`: Resource not found\n- `408`: Request timeout\n- `429`: Rate limit exceeded\n- `500`: Internal server error\n- `502`: Upstream service error\n- `503`: Service unavailable\n\nSee [Error Codes](/api-manual/error-codes) for details."
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1757165031-uyujaw3d"
              },
              "status": {
                "type": "string",
                "enum": ["not_started", "running", "finished", "failed"],
                "example": "not_started",
                "description": "Task status. Always `not_started` right after submission. Use [Query Task Status](/api-manual/task-management/status) or `callback_url` to get later states.\n\n- `not_started`: Queued, waiting to be processed\n- `running`: Being generated\n- `finished`: Completed; results are in `files` or `output`\n- `failed`: Failed; details are in `error_message`"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2026-10-13T10:30:00+08:00"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "Business status code. `200` means success; any other value means the request failed. Always check this field: some validation errors return HTTP 200 with `code: 400` in the body.\n\n- `200`: Success\n- `400`: Invalid request parameters\n- `401`: Missing or invalid API key\n- `402`: Insufficient credits\n- `403`: Permission denied\n- `404`: Resource not found\n- `408`: Request timeout\n- `429`: Rate limit exceeded\n- `500`: Internal server error\n- `502`: Upstream service error\n- `503`: Service unavailable\n\nSee [Error Codes](/api-manual/error-codes) for details."
          },
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error"
              }
            }
          }
        }
      }
    }
  }
}
