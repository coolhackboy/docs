{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - MiniMax Music 2.6 API",
    "description": "The MiniMax Music 2.6 API generates a complete track from a style prompt, using supplied lyrics, lyrics generated from the prompt, or instrumental-only mode. Audio can be returned as MP3, WAV, or PCM at the documented sample rates and bitrates.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "Submit MiniMax Music 2.6 Task",
        "description": "Generate a complete music track from a style prompt, optional lyrics, lyrics optimization, or instrumental mode.",
        "operationId": "submitMiniMaxMusic26Task",
        "tags": [
          "MiniMax Music 2.6"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "vocal-track": {
                  "summary": "Vocal music generation with lyrics",
                  "value": {
                    "model": "minimax-music-2.6",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "City pop, 80s retro, groovy synth bass, warm female vocal, nostalgic night drive",
                      "lyrics": "[Verse]\nStreetlights flicker in the rearview glow\n[Chorus]\nWe keep driving where the midnight winds blow",
                      "is_instrumental": false,
                      "audio_setting": {
                        "sample_rate": 44100,
                        "bitrate": 256000,
                        "format": "mp3"
                      }
                    }
                  }
                },
                "lyrics-optimize": {
                  "summary": "Vocal music generation with lyrics optimization",
                  "value": {
                    "model": "minimax-music-2.6",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "Modern cinematic pop ballad, emotional male vocal, piano intro, wide chorus, 92 BPM",
                      "lyrics_optimizer": true,
                      "is_instrumental": false,
                      "audio_setting": {
                        "sample_rate": 44100,
                        "bitrate": 256000,
                        "format": "mp3"
                      }
                    }
                  }
                },
                "instrumental-track": {
                  "summary": "Instrumental music generation",
                  "value": {
                    "model": "minimax-music-2.6",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "Minimal piano and soft strings for a quiet sunrise over the ocean",
                      "is_instrumental": true,
                      "audio_setting": {
                        "sample_rate": 32000,
                        "bitrate": 128000,
                        "format": "wav"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                },
                "examples": {
                  "submitted": {
                    "summary": "Submitted task",
                    "value": {
                      "code": 200,
                      "data": {
                        "task_id": "task-unified-1757165031-uyujaw3d",
                        "status": "not_started",
                        "created_time": "2026-04-15T10:30:00"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/generate/status/{task_id}": {
      "get": {
        "summary": "Get MiniMax Music 2.6 Task Status",
        "description": "Retrieve the task status and generated music files.",
        "operationId": "getMiniMaxMusic26TaskStatus",
        "tags": [
          "MiniMax Music 2.6"
        ],
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "description": "Task ID returned by the submit endpoint.",
            "schema": {
              "type": "string"
            },
            "example": "task-unified-1757165031-uyujaw3d"
          }
        ],
        "responses": {
          "200": {
            "description": "Task status retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                },
                "examples": {
                  "finished": {
                    "summary": "Finished task",
                    "value": {
                      "code": 200,
                      "data": {
                        "task_id": "task-unified-1757165031-uyujaw3d",
                        "status": "finished",
                        "credits_amount": 8,
                        "files": [
                          {
                            "file_url": "https://cdn.doculator.org/audios/task-unified-1757165031-uyujaw3d/task-unified-1757165031-uyujaw3d.mp3",
                            "file_type": "audio"
                          }
                        ],
                        "created_time": "2026-04-15T10:30:00",
                        "progress": 100,
                        "error_message": null
                      }
                    }
                  },
                  "running": {
                    "summary": "Running task",
                    "value": {
                      "code": 200,
                      "data": {
                        "task_id": "task-unified-1757165031-uyujaw3d",
                        "status": "running",
                        "credits_amount": 8,
                        "files": [],
                        "created_time": "2026-04-15T10:30:00",
                        "progress": 45,
                        "error_message": null
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "All API endpoints require Bearer Token authentication.\n\nCreate an API key: sign in to PoYo, open **Dashboard → API Key** at [poyo.ai/dashboard/api-key](https://poyo.ai/dashboard/api-key), and click to create a key.\n\nAdd it to the request header:\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Model identifier.\n\nMust be `minimax-music-2.6` for this endpoint.",
            "enum": [
              "minimax-music-2.6"
            ],
            "example": "minimax-music-2.6"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "Webhook callback URL for result notifications",
            "example": "https://your-domain.com/callback"
          },
          "input": {
            "type": "object",
            "required": [
              "prompt"
            ],
            "description": "Input parameters for music generation. If `lyrics` is empty, set either `is_instrumental` or `lyrics_optimizer` to `true`.",
            "additionalProperties": false,
            "properties": {
              "prompt": {
                "type": "string",
                "description": "Required music prompt describing style, mood, genre, instrumentation, tempo, vocal direction, or scene.",
                "minLength": 10,
                "maxLength": 2000,
                "example": "City pop, 80s retro, groovy synth bass, warm female vocal, nostalgic night drive"
              },
              "lyrics": {
                "type": "string",
                "description": "Optional lyrics for vocal generation. Required unless `is_instrumental` or `lyrics_optimizer` is `true`.",
                "maxLength": 3500,
                "example": "[Verse]\nStreetlights flicker in the rearview glow\n[Chorus]\nWe keep driving where the midnight winds blow"
              },
              "lyrics_optimizer": {
                "type": "boolean",
                "description": "When `true` and `lyrics` is empty, the model auto-generates lyrics from the prompt.",
                "default": false,
                "example": true
              },
              "is_instrumental": {
                "type": "boolean",
                "description": "When `true`, generates instrumental-only music without vocals.",
                "default": false,
                "example": false
              },
              "audio_setting": {
                "type": "object",
                "description": "Optional audio output settings. Only `sample_rate`, `bitrate`, and `format` are supported.",
                "additionalProperties": false,
                "properties": {
                  "sample_rate": {
                    "type": "integer",
                    "description": "Output sample rate.",
                    "enum": [
                      16000,
                      24000,
                      32000,
                      44100
                    ],
                    "default": 44100,
                    "example": 44100
                  },
                  "bitrate": {
                    "type": "integer",
                    "description": "Output bitrate.",
                    "enum": [
                      32000,
                      64000,
                      128000,
                      256000
                    ],
                    "default": 256000,
                    "example": 256000
                  },
                  "format": {
                    "type": "string",
                    "description": "Output audio format.",
                    "enum": [
                      "mp3",
                      "wav",
                      "pcm"
                    ],
                    "default": "mp3",
                    "example": "mp3"
                  }
                }
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "description": "Business status code. `200` means success; any other value means the request failed. Always check this field: some validation errors return HTTP 200 with `code: 400` in the body.\n\n- `200`: Success\n- `400`: Invalid request parameters\n- `401`: Missing or invalid API key\n- `402`: Insufficient credits\n- `403`: Permission denied\n- `404`: Resource not found\n- `408`: Request timeout\n- `429`: Rate limit exceeded\n- `500`: Internal server error\n- `502`: Upstream service error\n- `503`: Service unavailable\n\nSee [Error Codes](/api-manual/error-codes) for details.",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503]
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1757165031-uyujaw3d",
                "description": "Unique task identifier for status tracking"
              },
              "status": {
                "type": "string",
                "enum": ["not_started", "running", "finished", "failed"],
                "example": "not_started",
                "description": "Task status. Always `not_started` right after submission. Use [Query Task Status](/api-manual/task-management/status) or `callback_url` to get later states.\n\n- `not_started`: Queued, waiting to be processed\n- `running`: Being generated\n- `finished`: Completed; results are in `files` or `output`\n- `failed`: Failed; details are in `error_message`"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2026-04-15T10:30:00",
                "description": "ISO 8601 timestamp when the task was created"
              }
            }
          }
        }
      },
      "StatusResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "description": "Business status code. `200` means success; any other value means the request failed. Always check this field: some validation errors return HTTP 200 with `code: 400` in the body.\n\n- `200`: Success\n- `400`: Invalid request parameters\n- `401`: Missing or invalid API key\n- `402`: Insufficient credits\n- `403`: Permission denied\n- `404`: Resource not found\n- `408`: Request timeout\n- `429`: Rate limit exceeded\n- `500`: Internal server error\n- `502`: Upstream service error\n- `503`: Service unavailable\n\nSee [Error Codes](/api-manual/error-codes) for details.",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503]
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "credits_amount",
              "files",
              "created_time",
              "progress"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1757165031-uyujaw3d",
                "description": "Unique task identifier"
              },
              "status": {
                "type": "string",
                "enum": [
                  "not_started",
                  "running",
                  "finished",
                  "failed"
                ],
                "example": "finished",
                "description": "Task status.\n\n- `not_started`: Queued, waiting to be processed\n- `running`: Being generated\n- `finished`: Completed; results are in `files` or `output`\n- `failed`: Failed; details are in `error_message`"
              },
              "credits_amount": {
                "type": "number",
                "example": 8,
                "description": "Credits charged for the task"
              },
              "files": {
                "type": "array",
                "description": "Generated task files. Finished music tasks return at least one audio file.",
                "items": {
                  "$ref": "#/components/schemas/FileItem"
                }
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2026-04-15T10:30:00"
              },
              "progress": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100,
                "example": 100
              },
              "error_message": {
                "type": "string",
                "nullable": true,
                "example": null
              }
            }
          }
        }
      },
      "FileItem": {
        "type": "object",
        "required": [
          "file_url",
          "file_type"
        ],
        "properties": {
          "file_url": {
            "type": "string",
            "format": "uri",
            "description": "Generated file URL",
            "example": "https://cdn.doculator.org/audios/task-unified-1757165031-uyujaw3d/task-unified-1757165031-uyujaw3d.mp3"
          },
          "file_type": {
            "type": "string",
            "description": "Generated file type",
            "enum": [
              "audio",
              "other"
            ],
            "example": "audio"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "Business status code. `200` means success; any other value means the request failed. Always check this field: some validation errors return HTTP 200 with `code: 400` in the body.\n\n- `200`: Success\n- `400`: Invalid request parameters\n- `401`: Missing or invalid API key\n- `402`: Insufficient credits\n- `403`: Permission denied\n- `404`: Resource not found\n- `408`: Request timeout\n- `429`: Rate limit exceeded\n- `500`: Internal server error\n- `502`: Upstream service error\n- `503`: Service unavailable\n\nSee [Error Codes](/api-manual/error-codes) for details."
          },
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error"
              }
            }
          }
        }
      }
    }
  }
}
