{
  "openapi": "3.0.0",
  "info": {"title": "PoYo Advanced Stem Split API", "version": "1.0.0", "description": "Extract or remove a selected vocal or instrument stem."},
  "servers": [{"url": "https://api.poyo.ai"}], "security": [{"BearerAuth": []}],
  "paths": {"/api/generate/submit": {"post": {
    "operationId": "submitAdvancedStemSplit", "summary": "Extract and remove a selected stem",
    "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Request"}, "examples": {
      "upload": {"value": {"model": "stem-split-advanced", "input": {"upload_url": "https://example.com/song.mp3", "stem_name": "guitar"}}},
      "task": {"value": {"model": "stem-split-advanced", "input": {"task_id": "music_task_id", "audio_id": "audio_id", "stem_name": "vocals"}}}
    }}}},
    "responses": {"200": {"description": "Submitted", "content": {"application/json": {
      "schema": {"$ref": "#/components/schemas/Response"},
      "example": {"code": 200, "data": {"task_id": "advanced_stem_task_id", "status": "not_started", "created_time": "2026-08-27T10:00:00"}}
    }}}}
  }}},
  "components": {"securitySchemes": {"BearerAuth": {"type": "http", "scheme": "bearer"}}, "schemas": {"Request": {
    "type": "object", "required": ["model", "input"], "properties": {
      "model": {"type": "string", "enum": ["stem-split-advanced"]}, "callback_url": {"type": "string", "format": "uri"},
      "input": {"type": "object", "additionalProperties": false, "required": ["stem_name"],
        "oneOf": [{"required": ["task_id", "audio_id"], "not": {"required": ["upload_url"]}}, {"required": ["upload_url"], "not": {"anyOf": [{"required": ["task_id"]}, {"required": ["audio_id"]}]}}],
        "properties": {"task_id": {"type": "string", "minLength": 1, "description": "Task ID returned by a completed music task."}, "audio_id": {"type": "string", "minLength": 1, "description": "Audio ID from the selected task result."}, "upload_url": {"type": "string", "format": "uri", "pattern": "^https?://", "description": "HTTP(S) uploaded source; mutually exclusive with task_id/audio_id."}, "stem_name": {"type": "string", "minLength": 1, "pattern": "\\S"}}
      }
    }
  }, "Response": {
    "type": "object", "required": ["code", "data"], "properties": {
      "code": {"type": "integer", "example": 200},
      "data": {"type": "object", "required": ["task_id", "status", "created_time"], "properties": {"task_id": {"type": "string"}, "status": {"type": "string", "enum": ["not_started", "running", "finished", "failed"]}, "created_time": {"type": "string", "format": "date-time"}}}
    }
  }}}
}
