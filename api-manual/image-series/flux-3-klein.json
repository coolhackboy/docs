{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - Flux 3 Klein API",
    "description": "Generate or edit images with up to ten reference images and 1K, 2K, or 4K output.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "Submit a Flux 3 Klein task",
        "operationId": "submitFlux3KleinTask",
        "tags": [
          "Flux 3 Klein"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "text-to-image": {
                  "summary": "Generate an image",
                  "value": {
                    "model": "flux-3-klein",
                    "input": {
                      "prompt": "A red fox in fresh snow at sunrise",
                      "size": "3:2",
                      "resolution": "2K"
                    }
                  }
                },
                "edit-image": {
                  "summary": "Edit a reference image",
                  "value": {
                    "model": "flux-3-klein-edit",
                    "input": {
                      "prompt": "Keep the product from the first image and place it in a sunlit studio",
                      "image_urls": [
                        "https://example.com/product.png"
                      ],
                      "size": "4:3",
                      "resolution": "1K"
                    }
                  }
                },
                "custom-size": {
                  "summary": "Use an exact pixel size",
                  "value": {
                    "model": "flux-3-klein",
                    "input": {
                      "prompt": "An editorial portrait with soft window light",
                      "size": "1536x1024",
                      "resolution": "2K"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "Use Authorization: Bearer PoYo_API_KEY."
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "flux-3-klein",
              "flux-3-klein-edit"
            ],
            "description": "Public model identifier."
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "Webhook URL for finished or failed task notifications."
          },
          "input": {
            "type": "object",
            "required": [
              "prompt"
            ],
            "additionalProperties": false,
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "Describe the complete target image, including the subject, framing, background, and lighting."
              },
              "image_urls": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://\\S+$"
                },
                "description": "Required for flux-3-klein-edit only. Supply 1-10 reference image URLs. Do not send this field for flux-3-klein."
              },
              "size": {
                "type": "string",
                "default": "1:1",
                "description": "Output aspect ratio: 1:1, 4:3, 3:4, 16:9, 9:16, 3:2, or 2:3; or exact WIDTHxHEIGHT pixels. Custom dimensions must each be 256-4096, divisible by 16, and accompanied by an explicit matching resolution."
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "1K",
                  "2K",
                  "4K"
                ],
                "default": "1K",
                "description": "Output resolution tier. For an aspect ratio, the long edge is 1024, 2048, or 4096 pixels and the short edge is rounded to the nearest multiple of 16. For custom dimensions, the long edge selects the tier: at most 1024 = 1K, above 1024 through 2048 = 2K, above 2048 through 4096 = 4K."
              },
              "n": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4,
                "default": 1,
                "description": "Number of output images."
              },
              "output_format": {
                "type": "string",
                "enum": [
                  "jpeg",
                  "png",
                  "webp"
                ],
                "default": "png",
                "description": "Output image format."
              },
              "enable_safety_checker": {
                "type": "boolean",
                "default": true,
                "description": "Enable content safety checking."
              }
            },
            "description": "Parameters for the selected model. Media fields are required only for their corresponding mode."
          }
        },
        "description": "Generate or edit images with up to ten reference images and 1K, 2K, or 4K output.",
        "x-poyo-model-requests": {
          "$ref": "#/components/schemas/ModelRequests"
        }
      },
      "TextToImageRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "flux-3-klein"
            ],
            "description": "Public model identifier."
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "Webhook URL for finished or failed task notifications."
          },
          "input": {
            "type": "object",
            "required": [
              "prompt"
            ],
            "additionalProperties": false,
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "Describe the complete target image, including the subject, framing, background, and lighting."
              },
              "size": {
                "type": "string",
                "default": "1:1",
                "oneOf": [
                  {
                    "enum": [
                      "1:1",
                      "4:3",
                      "3:4",
                      "16:9",
                      "9:16",
                      "3:2",
                      "2:3"
                    ]
                  },
                  {
                    "pattern": "^\\d+x\\d+$"
                  }
                ],
                "description": "Output aspect ratio, or exact WIDTHxHEIGHT pixels. Custom dimensions must each be 256-4096, divisible by 16, and accompanied by an explicit matching resolution."
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "1K",
                  "2K",
                  "4K"
                ],
                "default": "1K",
                "description": "Output resolution tier. For an aspect ratio, the long edge is 1024, 2048, or 4096 pixels and the short edge is rounded to the nearest multiple of 16. For custom dimensions, the long edge selects the tier: at most 1024 = 1K, above 1024 through 2048 = 2K, above 2048 through 4096 = 4K."
              },
              "n": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4,
                "default": 1,
                "description": "Number of output images."
              },
              "output_format": {
                "type": "string",
                "enum": [
                  "jpeg",
                  "png",
                  "webp"
                ],
                "default": "png",
                "description": "Output image format."
              },
              "enable_safety_checker": {
                "type": "boolean",
                "default": true,
                "description": "Enable content safety checking."
              }
            }
          }
        },
        "description": "Generate 1-4 images from text with 1K, 2K, or 4K output."
      },
      "EditImageRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "flux-3-klein-edit"
            ],
            "description": "Public model identifier."
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "Webhook URL for finished or failed task notifications."
          },
          "input": {
            "type": "object",
            "required": [
              "prompt",
              "image_urls"
            ],
            "additionalProperties": false,
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "Describe the complete target image, including the subject, framing, background, and lighting."
              },
              "size": {
                "type": "string",
                "default": "1:1",
                "oneOf": [
                  {
                    "enum": [
                      "1:1",
                      "4:3",
                      "3:4",
                      "16:9",
                      "9:16",
                      "3:2",
                      "2:3"
                    ]
                  },
                  {
                    "pattern": "^\\d+x\\d+$"
                  }
                ],
                "description": "Output aspect ratio, or exact WIDTHxHEIGHT pixels. Custom dimensions must each be 256-4096, divisible by 16, and accompanied by an explicit matching resolution."
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "1K",
                  "2K",
                  "4K"
                ],
                "default": "1K",
                "description": "Output resolution tier. For an aspect ratio, the long edge is 1024, 2048, or 4096 pixels and the short edge is rounded to the nearest multiple of 16. For custom dimensions, the long edge selects the tier: at most 1024 = 1K, above 1024 through 2048 = 2K, above 2048 through 4096 = 4K."
              },
              "n": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4,
                "default": 1,
                "description": "Number of output images."
              },
              "output_format": {
                "type": "string",
                "enum": [
                  "jpeg",
                  "png",
                  "webp"
                ],
                "default": "png",
                "description": "Output image format."
              },
              "enable_safety_checker": {
                "type": "boolean",
                "default": true,
                "description": "Enable content safety checking."
              },
              "image_urls": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://\\S+$"
                },
                "description": "Reference images in prompt order. Refer to the first image, second image, and so on."
              }
            }
          }
        },
        "description": "Edit or compose 1-10 reference images with 1K, 2K, or 4K output."
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "enum": [
              200
            ],
            "example": 200
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1792468800-example"
              },
              "status": {
                "type": "string",
                "enum": [
                  "not_started"
                ],
                "example": "not_started"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2026-10-20T12:00:00"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error"
              }
            }
          }
        }
      },
      "ModelRequests": {
        "type": "object",
        "oneOf": [
          {
            "$ref": "#/components/schemas/TextToImageRequest"
          },
          {
            "$ref": "#/components/schemas/EditImageRequest"
          }
        ],
        "discriminator": {
          "propertyName": "model",
          "mapping": {
            "flux-3-klein": "#/components/schemas/TextToImageRequest",
            "flux-3-klein-edit": "#/components/schemas/EditImageRequest"
          }
        }
      }
    }
  }
}
