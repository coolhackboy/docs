{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - Grok Imagine Image 2.0 API",
    "description": "Grok Imagine Image 2.0 generation and editing with selectable quality and resolution",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "Submit Grok Imagine Image 2.0 Task",
        "description": "Generate images from text or edit up to three input images. Providing input.image_urls automatically selects image editing.",
        "operationId": "submitGrokImagineImage20Task",
        "tags": [
          "Grok Imagine Image 2.0"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "text-to-image": {
                  "summary": "Text-to-image generation",
                  "value": {
                    "model": "grok-imagine-image-2.0",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "A cinematic product photo of a glass perfume bottle on black stone, dramatic rim lighting",
                      "n": 1,
                      "aspect_ratio": "16:9",
                      "resolution": "2K",
                      "quality": "medium"
                    }
                  }
                },
                "image-edit": {
                  "summary": "Image editing",
                  "value": {
                    "model": "grok-imagine-image-2.0",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "Keep the subject unchanged and replace the background with a warm modern studio",
                      "image_urls": [
                        "https://example.com/source-image.png"
                      ],
                      "n": 1,
                      "aspect_ratio": "1:1",
                      "resolution": "1K",
                      "quality": "low"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "All API endpoints require Bearer Token authentication.\n\nCreate an API key: sign in to PoYo, open **Dashboard → API Key** at [poyo.ai/dashboard/api-key](https://poyo.ai/dashboard/api-key), and click to create a key.\n\nAdd it to the request header:\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Grok Imagine Image 2.0 model identifier",
            "enum": [
              "grok-imagine-image-2.0"
            ]
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "Webhook callback URL for result notifications",
            "example": "https://your-domain.com/callback"
          },
          "input": {
            "type": "object",
            "required": [
              "prompt"
            ],
            "description": "Generation parameters. Providing image_urls selects image editing; otherwise the request creates images from text.",
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000,
                "description": "Generation or editing prompt",
                "example": "A cinematic product photo on a clean studio background"
              },
              "image_urls": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "description": "Optional input image URLs. When provided, the request edits these images.",
                "example": [
                  "https://example.com/source-image.png"
                ]
              },
              "n": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4,
                "default": 1,
                "description": "Number of output images",
                "example": 1
              },
              "aspect_ratio": {
                "type": "string",
                "enum": [
                  "1:1",
                  "2:3",
                  "3:2",
                  "9:16",
                  "16:9"
                ],
                "description": "Output aspect ratio",
                "default": "1:1",
                "example": "1:1"
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "1K",
                  "2K"
                ],
                "default": "1K",
                "description": "Output image resolution tier",
                "example": "1K"
              },
              "quality": {
                "type": "string",
                "enum": [
                  "low",
                  "medium"
                ],
                "default": "medium",
                "description": "Output quality level",
                "example": "medium"
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "description": "Business status code. `200` means success; any other value means the request failed. Always check this field: some validation errors return HTTP 200 with `code: 400` in the body.\n\n- `200`: Success\n- `400`: Invalid request parameters\n- `401`: Missing or invalid API key\n- `402`: Insufficient credits\n- `403`: Permission denied\n- `404`: Resource not found\n- `408`: Request timeout\n- `429`: Rate limit exceeded\n- `500`: Internal server error\n- `502`: Upstream service error\n- `503`: Service unavailable\n\nSee [Error Codes](/api-manual/error-codes) for details.",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503]
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1786751400-abcd1234",
                "description": "Unique task identifier for status tracking"
              },
              "status": {
                "type": "string",
                "enum": ["not_started", "running", "finished", "failed"],
                "example": "not_started",
                "description": "Task status. Always `not_started` right after submission. Use [Query Task Status](/api-manual/task-management/status) or `callback_url` to get later states.\n\n- `not_started`: Queued, waiting to be processed\n- `running`: Being generated\n- `finished`: Completed; results are in `files` or `output`\n- `failed`: Failed; details are in `error_message`"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2026-08-15T10:30:00",
                "description": "ISO 8601 timestamp when the task was created"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "Business status code. `200` means success; any other value means the request failed. Always check this field: some validation errors return HTTP 200 with `code: 400` in the body.\n\n- `200`: Success\n- `400`: Invalid request parameters\n- `401`: Missing or invalid API key\n- `402`: Insufficient credits\n- `403`: Permission denied\n- `404`: Resource not found\n- `408`: Request timeout\n- `429`: Rate limit exceeded\n- `500`: Internal server error\n- `502`: Upstream service error\n- `503`: Service unavailable\n\nSee [Error Codes](/api-manual/error-codes) for details."
          },
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error"
              }
            }
          }
        }
      }
    }
  }
}
