{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - Grok Imagine Image 2.0 API",
    "description": "Grok Imagine Image 2.0 generation and editing with selectable quality and resolution",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "Submit Grok Imagine Image 2.0 Task",
        "description": "Generate images from text or edit up to three input images. Providing input.image_urls automatically selects image editing.",
        "operationId": "submitGrokImagineImage20Task",
        "tags": ["Grok Imagine Image 2.0"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "text-to-image": {
                  "summary": "Text-to-image generation",
                  "value": {
                    "model": "grok-imagine-image-2.0",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "A cinematic product photo of a glass perfume bottle on black stone, dramatic rim lighting",
                      "n": 1,
                      "aspect_ratio": "16:9",
                      "resolution": "2K",
                      "quality": "medium",
                      "output_format": "jpeg"
                    }
                  }
                },
                "image-edit": {
                  "summary": "Image editing",
                  "value": {
                    "model": "grok-imagine-image-2.0",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "Keep the subject unchanged and replace the background with a warm modern studio",
                      "image_urls": ["https://example.com/source-image.png"],
                      "n": 1,
                      "aspect_ratio": "auto",
                      "resolution": "1K",
                      "quality": "low",
                      "output_format": "png"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "All API endpoints require Bearer Token authentication\n\nGet your API Key:\n\nVisit the [API Key Management Page](https://poyo.ai/dashboard/api-key) to get your API Key\n\nAdd it to the request header:\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": ["model", "input"],
        "properties": {
          "model": {
            "type": "string",
            "description": "Grok Imagine Image 2.0 model identifier",
            "enum": ["grok-imagine-image-2.0"]
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "Webhook callback URL for result notifications",
            "example": "https://your-domain.com/callback"
          },
          "input": {
            "type": "object",
            "required": ["prompt"],
            "description": "Generation parameters. Providing image_urls selects image editing; otherwise the request creates images from text.",
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000,
                "description": "Generation or editing prompt",
                "example": "A cinematic product photo on a clean studio background"
              },
              "image_urls": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "description": "Optional input image URLs. When provided, the request edits these images.",
                "example": ["https://example.com/source-image.png"]
              },
              "n": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4,
                "default": 1,
                "description": "Number of output images",
                "example": 1
              },
              "aspect_ratio": {
                "type": "string",
                "enum": [
                  "auto",
                  "2:1",
                  "20:9",
                  "19.5:9",
                  "16:9",
                  "4:3",
                  "3:2",
                  "1:1",
                  "2:3",
                  "3:4",
                  "9:16",
                  "9:19.5",
                  "9:20",
                  "1:2"
                ],
                "description": "Output aspect ratio. The default is 1:1 for text-to-image and auto for editing. auto is valid only when image_urls is provided.",
                "example": "1:1"
              },
              "resolution": {
                "type": "string",
                "enum": ["1K", "2K"],
                "default": "1K",
                "description": "Output image resolution tier",
                "example": "1K"
              },
              "quality": {
                "type": "string",
                "enum": ["low", "medium"],
                "default": "medium",
                "description": "Output quality level",
                "example": "medium"
              },
              "output_format": {
                "type": "string",
                "enum": ["jpeg", "png", "webp"],
                "default": "jpeg",
                "description": "Output image format",
                "example": "jpeg"
              },
              "sync_mode": {
                "type": "boolean",
                "default": false,
                "description": "Return generated media inline when supported",
                "example": false
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": ["code", "data"],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "description": "HTTP status code"
          },
          "data": {
            "type": "object",
            "required": ["task_id", "status", "created_time"],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1786751400-abcd1234",
                "description": "Unique task identifier for status tracking"
              },
              "status": {
                "type": "string",
                "enum": ["not_started"],
                "example": "not_started",
                "description": "Initial task status"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2026-08-15T10:30:00",
                "description": "ISO 8601 timestamp when the task was created"
              }
            }
          }
        }
      }
    }
  }
}
