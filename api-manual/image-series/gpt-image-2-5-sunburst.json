{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - GPT Image 2.5 Sunburst API",
    "description": "GPT Image 2.5 Sunburst single-image generation and reference-image editing with background, format, and mask controls.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "Submit GPT Image 2.5 Sunburst Task",
        "description": "GPT Image 2.5 Sunburst single-image generation and reference-image editing with background, format, and mask controls.",
        "operationId": "submitGPTImage25SunburstTask",
        "tags": [
          "GPT Image 2.5 Sunburst"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "text-to-image": {
                  "summary": "Text To Image",
                  "value": {
                    "model": "gpt-image-2.5-sunburst",
                    "input": {
                      "prompt": "A premium product photo of a silver espresso machine in a bright studio",
                      "size": "16:9",
                      "resolution": "2K",
                      "quality": "medium"
                    }
                  }
                },
                "image-edit": {
                  "summary": "Image Edit",
                  "value": {
                    "model": "gpt-image-2.5-sunburst",
                    "input": {
                      "prompt": "Keep the product and replace the background with a warm modern studio",
                      "image_urls": [
                        "https://example.com/product.png"
                      ],
                      "size": "1:1",
                      "quality": "high"
                    }
                  }
                },
                "mask-edit": {
                  "summary": "Mask Edit",
                  "value": {
                    "model": "gpt-image-2.5-sunburst",
                    "input": {
                      "prompt": "Replace only the masked area with a small vase of flowers",
                      "image_urls": [
                        "https://example.com/room.png"
                      ],
                      "mask_url": "https://example.com/mask.png",
                      "size": "auto"
                    }
                  }
                },
                "transparent-background": {
                  "summary": "Transparent Background",
                  "value": {
                    "model": "gpt-image-2.5-sunburst",
                    "input": {
                      "prompt": "A clean cutout of a small silver robot",
                      "background": "transparent",
                      "output_format": "webp",
                      "size": "1:1",
                      "resolution": "4K",
                      "quality": "xhigh"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "All API endpoints require Bearer Token authentication\n\nGet your API Key:\n\nVisit the [API Key Management Page](https://poyo.ai/dashboard/api-key) to get your API Key\n\nAdd it to the request header:\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "gpt-image-2.5-sunburst"
            ],
            "description": "GPT Image 2.5 Sunburst model identifier."
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "Optional webhook URL for task completion or failure."
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "prompt"
            ],
            "description": "Generate one image, or edit reference images when image_urls is non-empty.",
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32000,
                "pattern": "\\S",
                "description": "Prompt describing the image or the requested edit."
              },
              "image_urls": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                },
                "description": "Optional reference image URLs. A non-empty array selects editing; an omitted or empty array selects text-to-image generation."
              },
              "size": {
                "type": "string",
                "default": "1:1",
                "description": "Aspect ratio or custom WIDTHxHEIGHT. Supported values: auto, 1:1, 2:3, 3:2, 4:3, 3:4, 4:5, 5:4, 16:9, 9:16, 21:9, or WIDTHxHEIGHT. Defaults to 1:1. auto is available only at 1K. Custom sizes require resolution 2K or 4K, dimensions divisible by 16, max edge 3840, aspect ratio at most 3:1, and total pixels 655360–8294400. A custom 3840-pixel edge requires 4K.",
                "pattern": "^(?:auto|1:1|2:3|3:2|4:3|3:4|4:5|5:4|16:9|9:16|21:9|\\s*\\d+\\s*[xX]\\s*\\d+\\s*)$",
                "example": "1:1"
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "1K",
                  "2K",
                  "4K"
                ],
                "default": "1K",
                "description": "Output resolution tier. Pixel dimensions depend on aspect ratio; a 4K square is 2880x2880."
              },
              "quality": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ],
                "default": "low",
                "description": "Output quality level."
              },
              "background": {
                "type": "string",
                "enum": [
                  "auto",
                  "transparent",
                  "opaque"
                ],
                "default": "auto",
                "description": "Background mode. transparent requires png or webp output."
              },
              "output_format": {
                "type": "string",
                "enum": [
                  "png",
                  "jpeg",
                  "webp"
                ],
                "default": "png",
                "description": "Output image format."
              },
              "mask_url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://",
                "description": "Optional mask image URL identifying the area to edit. Requires non-empty image_urls."
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "description": "HTTP status code"
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1786751400-abcd1234",
                "description": "Unique task identifier for status tracking"
              },
              "status": {
                "type": "string",
                "enum": [
                  "not_started"
                ],
                "example": "not_started",
                "description": "Initial task status"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2026-09-09T10:30:00",
                "description": "ISO 8601 timestamp when the task was created"
              }
            }
          }
        }
      }
    }
  }
}
