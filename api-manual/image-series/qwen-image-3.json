{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - Qwen Image 3 API",
    "description": "Unified text-to-image and reference-image generation with Qwen Image 3",
    "version": "1.0.0"
  },
  "servers": [{"url": "https://api.poyo.ai", "description": "Production server"}],
  "security": [{"BearerAuth": []}],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "Submit Qwen Image 3 Task",
        "operationId": "submitQwenImage3Task",
        "tags": ["Qwen Image 3"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/SubmitRequest"},
              "examples": {
                "standard": {
                  "summary": "Standard reference-image generation",
                  "value": {"model": "qwen-image-3", "input": {"prompt": "Transform this logo into a polished metallic badge with realistic studio lighting while preserving its recognizable shape and colors", "image_urls": ["https://storage.poyo.ai/logo.webp"], "size": "4:3", "resolution": "2K", "output_format": "jpeg", "prompt_extend": false}}
                },
                "pro-2k": {
                  "summary": "Pro text-to-image generation",
                  "value": {"model": "qwen-image-3-pro", "input": {"prompt": "Create a refined bilingual technology conference poster with the headline Future Vision, elegant grid layout, blue and silver palette, realistic print texture", "size": "3:4", "resolution": "1K", "output_format": "png", "negative_prompt": "blurry, distorted typography, watermark", "seed": 314159}}
                },
                "reference-image": {
                  "summary": "Pro 2K reference-image generation",
                  "value": {"model": "qwen-image-3-pro", "input": {"prompt": "Transform this logo into a premium glass and brushed-metal app icon, preserve the original geometry and colors, dark blue studio background", "image_urls": ["https://storage.poyo.ai/logo.webp"], "size": "16:9", "resolution": "2K", "output_format": "png"}}
                },
                "multi-reference": {
                  "summary": "Pro multi-reference generation",
                  "value": {"model": "qwen-image-3-pro", "input": {"prompt": "Combine the original logo geometry from the first reference with the brushed-metal material and lighting from the second reference, centered premium brand emblem", "image_urls": ["https://storage.poyo.ai/logo.webp", "https://cdn.doculator.org/images/I13NA1X0MGCGMDMC/I13NA1X0MGCGMDMC.jpg"], "size": "1:1", "resolution": "1K", "output_format": "png"}}
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Task submitted successfully", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SubmitResponse"}}}},
          "400": {"description": "Invalid request parameters"},
          "401": {"description": "Unauthorized"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "API Key"}
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": ["model", "input"],
        "properties": {
          "model": {"type": "string", "enum": ["qwen-image-3", "qwen-image-3-pro"]},
          "callback_url": {"type": "string", "format": "uri"},
          "input": {
            "type": "object",
            "required": ["prompt"],
            "additionalProperties": false,
            "properties": {
              "prompt": {"type": "string", "maxLength": 5000},
              "image_urls": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "format": "uri"}},
              "size": {"type": "string", "enum": ["1:1", "3:2", "2:3", "4:3", "3:4", "16:9", "9:16", "21:9"]},
              "resolution": {"type": "string", "enum": ["1K", "2K"], "default": "1K"},
              "output_format": {"type": "string", "enum": ["png", "jpeg"], "default": "png"},
              "prompt_extend": {"type": "boolean", "default": true},
              "negative_prompt": {"type": "string", "maxLength": 5000},
              "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
              "enable_safety_checker": {"type": "boolean", "default": true}
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": ["code", "data"],
        "properties": {
          "code": {"type": "integer", "example": 200},
          "data": {
            "type": "object",
            "properties": {
              "task_id": {"type": "string"},
              "status": {"type": "string", "example": "not_started"},
              "created_time": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    }
  }
}
