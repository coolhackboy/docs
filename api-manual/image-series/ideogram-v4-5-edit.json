{
  "openapi": "3.1.0",
  "info": {
    "title": "PoYo AI - Ideogram V4.5 Edit API",
    "description": "Edit exactly one primary image with references, optional masks, and precision controls.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "Submit Ideogram V4.5 Edit Task",
        "description": "Edit exactly one primary image with references, optional masks, and precision controls.",
        "operationId": "submit_ideogram_v4_5_edit",
        "tags": [
          "Ideogram V4.5 Edit"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "example-1": {
                  "value": {
                    "model": "ideogram-v4.5-edit",
                    "input": {
                      "prompt": "Replace the background with a blue studio.",
                      "image_urls": [
                        "https://example.com/source.png"
                      ]
                    }
                  }
                },
                "example-2": {
                  "value": {
                    "model": "ideogram-v4.5-edit",
                    "input": {
                      "prompt": "Replace the black mask area with flowers.",
                      "image_urls": [
                        "https://example.com/source.png"
                      ],
                      "mask_url": "https://example.com/mask.png",
                      "reference_image_urls": [
                        "https://example.com/flowers.png"
                      ],
                      "edit_precision": "high"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task accepted; query the task for final files.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "ideogram-v4.5-edit"
            ]
          },
          "input": {
            "$ref": "#/components/schemas/ModelInput"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "Optional completion or failure callback URL."
          }
        }
      },
      "ModelInput": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "prompt",
          "image_urls"
        ],
        "properties": {
          "mask_url": {
            "type": "string",
            "pattern": "^(https?://\\S+|data:image/\\S+)$",
            "description": "Same dimensions as the source. Black edits; white preserves; both regions are required."
          },
          "reference_image_urls": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(https?://\\S+|data:image/\\S+)$",
              "description": "Public image URL or image data URI."
            },
            "description": "Up to four reference images; at most three when mask_url is provided."
          },
          "edit_precision": {
            "enum": [
              "regular",
              "high"
            ],
            "default": "regular",
            "type": "string",
            "description": "regular edit or high-precision edit with unchanged-pixel restoration."
          },
          "quality": {
            "enum": [
              "very_low",
              "low",
              "medium",
              "high"
            ],
            "default": "medium",
            "type": "string",
            "description": "Output quality."
          },
          "prompt": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "pattern": "\\S",
            "description": "Prompt."
          },
          "n": {
            "minimum": 1,
            "default": 1,
            "maximum": 8,
            "type": "integer",
            "description": "Number of output images."
          },
          "size": {
            "type": "string",
            "default": "auto",
            "description": "auto preserves the source size. Explicit sizes require an unmasked regular edit. Minimum dimension 256; multiples of 32; at most 4194304 pixels; aspect ratio at most 6:1.",
            "pattern": "^(auto|1:1|1:1 HD|4:3|3:4|16:9|9:16|[0-9]+x[0-9]+)$"
          },
          "image_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(https?://\\S+|data:image/\\S+)$",
              "description": "Public image URL or image data URI."
            },
            "minItems": 1,
            "maxItems": 1,
            "description": "Exactly one primary source image."
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "mask_url"
              ]
            },
            "then": {
              "properties": {
                "reference_image_urls": {
                  "maxItems": 3
                },
                "size": {
                  "const": "auto"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "edit_precision"
              ],
              "properties": {
                "edit_precision": {
                  "const": "high"
                }
              }
            },
            "then": {
              "properties": {
                "size": {
                  "const": "auto"
                }
              }
            }
          }
        ]
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1757165031-uyujaw3d"
              },
              "status": {
                "type": "string",
                "enum": [
                  "not_started"
                ],
                "example": "not_started"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2026-10-13T10:30:00+08:00"
              }
            }
          }
        }
      }
    }
  }
}
