{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - Meshy 6 3D API",
    "description": "The Meshy 6 3D API generates a 3D mesh from text, one image, or 1–4 images of the same object. Textures, PBR maps, humanoid rigging, and a preset animation can be requested, with GLB, FBX, OBJ, USDZ, and STL among the documented outputs.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "Submit Meshy 6 3D Task",
        "description": "Generate a 3D model from text, one image, or multiple images.",
        "operationId": "submitMeshy6ThreeDTask",
        "tags": [
          "Meshy 6 3D"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "text-to-3d": {
                  "summary": "Text to 3D",
                  "value": {
                    "model": "meshy-6-text-to-3d",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "A worn leather explorer backpack with brass buckles, canvas straps, realistic stitching, game-ready asset",
                      "mode": "full",
                      "topology": "triangle",
                      "target_polycount": 30000,
                      "should_remesh": true,
                      "symmetry_mode": "auto",
                      "enable_pbr": true,
                      "pose_mode": "",
                      "enable_prompt_expansion": true,
                      "enable_safety_checker": true
                    }
                  }
                },
                "image-to-3d": {
                  "summary": "Image to 3D",
                  "value": {
                    "model": "meshy-6-image-to-3d",
                    "input": {
                      "image_urls": [
                        "https://example.com/object-front.png"
                      ],
                      "topology": "triangle",
                      "target_polycount": 30000,
                      "symmetry_mode": "auto",
                      "should_remesh": true,
                      "should_texture": true,
                      "enable_pbr": true,
                      "enable_safety_checker": true
                    }
                  }
                },
                "multi-image-to-3d": {
                  "summary": "Multi image to 3D",
                  "value": {
                    "model": "meshy-6-multi-image-to-3d",
                    "input": {
                      "image_urls": [
                        "https://example.com/object-front.png",
                        "https://example.com/object-side.png",
                        "https://example.com/object-back.png"
                      ],
                      "topology": "triangle",
                      "target_polycount": 30000,
                      "symmetry_mode": "auto",
                      "should_remesh": true,
                      "should_texture": true,
                      "enable_pbr": true,
                      "enable_safety_checker": true
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "All API endpoints require Bearer Token authentication.\n\nCreate an API key: sign in to PoYo, open **Dashboard → API Key** at [poyo.ai/dashboard/api-key](https://poyo.ai/dashboard/api-key), and click to create a key.\n\nAdd it to the request header:\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "meshy-6-text-to-3d",
              "meshy-6-image-to-3d",
              "meshy-6-multi-image-to-3d"
            ]
          },
          "callback_url": {
            "type": "string",
            "format": "uri"
          },
          "input": {
            "$ref": "#/components/schemas/Meshy6Input"
          }
        }
      },
      "Meshy6Input": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "maxLength": 600,
            "description": "Required for meshy-6-text-to-3d."
          },
          "image_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "minItems": 1,
            "maxItems": 4,
            "description": "Required for image models. Use exactly 1 item for meshy-6-image-to-3d and 1-4 items for meshy-6-multi-image-to-3d."
          },
          "mode": {
            "type": "string",
            "enum": [
              "preview",
              "full"
            ],
            "default": "full",
            "description": "Text-to-3D only."
          },
          "seed": {
            "type": "integer",
            "description": "Text-to-3D only."
          },
          "topology": {
            "type": "string",
            "enum": [
              "quad",
              "triangle"
            ],
            "default": "triangle"
          },
          "target_polycount": {
            "type": "integer",
            "default": 30000
          },
          "should_remesh": {
            "type": "boolean",
            "default": true
          },
          "symmetry_mode": {
            "type": "string",
            "enum": [
              "off",
              "auto",
              "on"
            ],
            "default": "auto"
          },
          "should_texture": {
            "type": "boolean",
            "default": true,
            "description": "Image models only."
          },
          "enable_pbr": {
            "type": "boolean"
          },
          "pose_mode": {
            "type": "string",
            "enum": [
              "a-pose",
              "t-pose",
              ""
            ],
            "default": ""
          },
          "enable_prompt_expansion": {
            "type": "boolean",
            "description": "Text-to-3D only."
          },
          "texture_prompt": {
            "type": "string"
          },
          "texture_image_url": {
            "type": "string",
            "format": "uri"
          },
          "enable_rigging": {
            "type": "boolean"
          },
          "rigging_height_meters": {
            "type": "number",
            "default": 1.7
          },
          "enable_animation": {
            "type": "boolean"
          },
          "animation_action_id": {
            "type": "integer",
            "default": 1001
          },
          "enable_safety_checker": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "description": "Business status code. `200` means success; any other value means the request failed. Always check this field: some validation errors return HTTP 200 with `code: 400` in the body.\n\n- `200`: Success\n- `400`: Invalid request parameters\n- `401`: Missing or invalid API key\n- `402`: Insufficient credits\n- `403`: Permission denied\n- `404`: Resource not found\n- `408`: Request timeout\n- `429`: Rate limit exceeded\n- `500`: Internal server error\n- `502`: Upstream service error\n- `503`: Service unavailable\n\nSee [Error Codes](/api-manual/error-codes) for details.",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503]
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "description": "Unique task identifier for status tracking"
              },
              "status": {
                "type": "string",
                "enum": ["not_started", "running", "finished", "failed"],
                "example": "not_started",
                "description": "Task status. Always `not_started` right after submission. Use [Query Task Status](/api-manual/task-management/status) or `callback_url` to get later states.\n\n- `not_started`: Queued, waiting to be processed\n- `running`: Being generated\n- `finished`: Completed; results are in `files` or `output`\n- `failed`: Failed; details are in `error_message`"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "description": "ISO 8601 timestamp when the task was created"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "Business status code. `200` means success; any other value means the request failed. Always check this field: some validation errors return HTTP 200 with `code: 400` in the body.\n\n- `200`: Success\n- `400`: Invalid request parameters\n- `401`: Missing or invalid API key\n- `402`: Insufficient credits\n- `403`: Permission denied\n- `404`: Resource not found\n- `408`: Request timeout\n- `429`: Rate limit exceeded\n- `500`: Internal server error\n- `502`: Upstream service error\n- `503`: Service unavailable\n\nSee [Error Codes](/api-manual/error-codes) for details."
          },
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error"
              }
            }
          }
        }
      }
    }
  }
}
