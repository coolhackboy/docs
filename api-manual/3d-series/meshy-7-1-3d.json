            "description": "Apply an animation; requires enable_rigging=true."
          },
          "target_polycount": {
            "default": 30000,
            "type": "integer",
            "minimum": 100,
            "maximum": 300000,
            "description": "Target polygons: 100-300000."
          },
          "animation_action_id": {
            "type": "integer",
            "default": 92,
            "minimum": 0,
            "maximum": 696,
            "description": "Animation preset ID, 0-696."
          },
          "geometry_resolution": {
            "enum": [
              "standard",
              "2k"
            ],
            "type": "string",
            "description": "Geometry resolution; multi-image generation does not support 4k."
          },
          "rigging_height_meters": {
            "exclusiveMinimum": 0,
            "type": "number",
            "default": 1.7,
            "description": "Character height in meters, greater than zero."
          },
          "pose_mode": {
            "enum": [
              "a-pose",
              "t-pose",
              ""
            ],
            "type": "string",
            "default": "",
