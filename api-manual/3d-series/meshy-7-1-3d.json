                }
              }
            },
            "then": {
              "required": [
                "enable_rigging"
              ],
              "properties": {
                "enable_rigging": {
                  "const": true
                }
              }
            }
          },
          {
            "if": {
              "anyOf": [
                {
                  "required": [
                    "enable_pbr"
                  ],
                  "properties": {
                    "enable_pbr": {
                      "const": true
                    }
                  }
                },
                {
                  "required": [
                    "texture_prompt"
                  ]
                },
                {
                  "required": [
                    "texture_image_url"
                  ]
                }
              ]
            },
            "then": {
              "properties": {
                "should_texture": {
                  "const": true
                }
              }
            }
          }
        ]
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
