{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - Kling 2.6 Motion Control API",
    "description": "Kling 2.6 Motion Control API 将 3–30 秒参考视频中的动作迁移到一张角色图像上，分辨率为 720p 或 1080p。image 朝向模式下结果最长 10 秒；video 朝向模式下最长 30 秒。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交 Kling 2.6 Motion Control 任务",
        "description": "通过精确的动作控制，将参考视频中的动作迁移到角色图像上",
        "operationId": "submitKling26MotionControlTask",
        "tags": [
          "Kling 2.6 Motion Control"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "kling-2.6-motion-control": {
                  "summary": "Kling 2.6 Motion Control",
                  "value": {
                    "model": "kling-2.6-motion-control",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "The cartoon character is dancing gracefully in a studio",
                      "image_urls": [
                        "https://example.com/character-image.jpg"
                      ],
                      "video_urls": [
                        "https://example.com/dance-reference.mp4"
                      ],
                      "character_orientation": "video",
                      "resolution": "1080p"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                },
                "examples": {
                  "success": {
                    "summary": "提交成功",
                    "value": {
                      "code": 200,
                      "data": {
                        "task_id": "task-unified-1757165031-uyujaw3d",
                        "status": "not_started",
                        "created_time": "2025-11-12T10:30:00"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未授权：API Key 无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "所有 API 接口都需要 Bearer Token 认证。\n\n创建 API Key：登录 PoYo，进入 **仪表盘 → API 密钥**（[poyo.ai/zh/dashboard/api-key](https://poyo.ai/zh/dashboard/api-key)），点击创建 Key。\n\n在请求头中添加：\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Kling 2.6 Motion Control 模型标识符",
            "enum": [
              "kling-2.6-motion-control"
            ]
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "接收结果通知的 Webhook 回调 URL",
            "example": "https://your-domain.com/callback"
          },
          "input": {
            "type": "object",
            "required": [
              "image_urls",
              "video_urls",
              "character_orientation",
              "resolution"
            ],
            "description": "动作控制生成的输入参数",
            "properties": {
              "prompt": {
                "type": "string",
                "description": "期望输出场景的文本描述（可选）",
                "maxLength": 2500,
                "example": "The cartoon character is dancing gracefully in a studio"
              },
              "image_urls": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "minItems": 1,
                "maxItems": 1,
                "description": "单张角色图像 URL（JPEG、PNG、WEBP，最大 10MB）。必须清晰显示主体的头部、肩部和躯干",
                "example": [
                  "https://example.com/character-image.jpg"
                ]
              },
              "video_urls": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "minItems": 1,
                "maxItems": 1,
                "description": "用于动作迁移的单个参考视频 URL（MP4、MOV、MKV，最大 100MB，3-30 秒）。必须清晰显示主体的头部、肩部和躯干",
                "example": [
                  "https://example.com/dance-reference.mp4"
                ]
              },
              "character_orientation": {
                "type": "string",
                "description": "角色朝向模式：'image' 与照片中人物的朝向一致（输出最长 10 秒），'video' 与参考视频中的角色朝向保持一致（输出最长 30 秒）",
                "enum": [
                  "image",
                  "video"
                ],
                "example": "video"
              },
              "resolution": {
                "type": "string",
                "description": "输出视频分辨率。720p 为标准画质，1080p 画质更高",
                "enum": [
                  "720p",
                  "1080p"
                ],
                "example": "1080p"
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503]
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1757165031-uyujaw3d",
                "description": "任务唯一标识，用于查询任务状态"
              },
              "status": {
                "type": "string",
                "enum": ["not_started", "running", "finished", "failed"],
                "example": "not_started",
                "description": "任务状态。提交后立即返回时始终为 `not_started`。后续状态请通过[查询任务状态](/zh/api-manual/task-management/status)接口或 `callback_url` 获取。\n\n- `not_started`：排队中，等待处理\n- `running`：生成中\n- `finished`：已完成，结果在 `files` 或 `output` 中\n- `failed`：失败，详情见 `error_message`"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2025-11-12T10:30:00",
                "description": "任务创建时间，ISO 8601 格式"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503]
          },
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters",
                "description": "描述错误原因的错误信息"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error",
                "description": "错误类型标识"
              }
            }
          }
        }
      }
    }
  }
}
