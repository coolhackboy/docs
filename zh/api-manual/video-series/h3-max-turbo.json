{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - H3 Max Turbo API",
    "description": "根据文本、首帧或首尾帧生成视频",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交 H3 Max Turbo 任务",
        "operationId": "submitH3MaxTurboTask",
        "tags": [
          "H3 Max Turbo"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "text-to-video": {
                  "summary": "文生视频",
                  "value": {
                    "model": "h3-max-turbo",
                    "input": {
                      "prompt": "A cinematic aerial view of a coastal city at sunrise",
                      "duration": 5,
                      "resolution": "768p",
                      "aspect_ratio": "16:9"
                    }
                  }
                },
                "image-to-video": {
                  "summary": "首帧",
                  "value": {
                    "model": "h3-max-turbo",
                    "input": {
                      "prompt": "The camera slowly moves forward through the scene",
                      "duration": 10,
                      "resolution": "480p",
                      "image_urls": [
                        "https://example.com/start.jpg"
                      ]
                    }
                  }
                },
                "first-last-frame": {
                  "summary": "首尾帧",
                  "value": {
                    "model": "h3-max-turbo",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "Daylight gradually turns into sunset",
                      "duration": 10,
                      "resolution": "1080p",
                      "image_urls": [
                        "https://example.com/start.jpg",
                        "https://example.com/end.jpg"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未授权：API Key 无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "所有 API 接口都需要 Bearer Token 认证。\n\n创建 API Key：登录 PoYo，进入 **仪表盘 → API 密钥**（[poyo.ai/zh/dashboard/api-key](https://poyo.ai/zh/dashboard/api-key)），点击创建 Key。\n\n在请求头中添加：\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "h3-max-turbo"
            ],
            "example": "h3-max-turbo"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "可选的 Webhook 回调 URL。"
          },
          "input": {
            "$ref": "#/components/schemas/H3MaxTurboInput"
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。"
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1790245800-h3turbo1"
              },
              "status": {
                "type": "string",
                "example": "not_started",
                "enum": ["not_started", "running", "finished", "failed"],
                "description": "任务状态。提交后立即返回时始终为 `not_started`。后续状态请通过[查询任务状态](/zh/api-manual/task-management/status)接口或 `callback_url` 获取。\n\n- `not_started`：排队中，等待处理\n- `running`：生成中\n- `finished`：已完成，结果在 `files` 或 `output` 中\n- `failed`：失败，详情见 `error_message`"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2026-09-24T10:30:00Z",
                "description": "任务创建时间，ISO 8601 格式。"
              }
            }
          }
        },
        "example": {
          "code": 200,
          "data": {
            "task_id": "task-unified-1790245800-h3turbo1",
            "status": "not_started",
            "created_time": "2026-09-24T10:30:00Z"
          }
        }
      },
      "H3MaxTurboInput": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "additionalProperties": false,
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50000,
            "description": "描述生成视频的文本提示词。两种模式都必填，且不能只包含空白字符。"
          },
          "duration": {
            "type": "integer",
            "minimum": 5,
            "maximum": 15,
            "default": 5,
            "description": "生成视频的时长，单位为秒。"
          },
          "resolution": {
            "type": "string",
            "enum": [
              "480p",
              "768p",
              "1080p",
              "480P",
              "768P",
              "1080P"
            ],
            "default": "768p",
            "description": "输出分辨率：480p、768p 或 1080p。也接受大写 P。"
          },
          "enable_safety_checker": {
            "type": "boolean",
            "default": true,
            "description": "设为 true 时启用安全检查器。默认为 true。"
          },
          "aspect_ratio": {
            "type": "string",
            "enum": [
              "21:9",
              "16:9",
              "4:3",
              "1:1",
              "3:4",
              "9:16"
            ],
            "description": "仅用于文生视频，默认为 16:9。image_urls 包含图片时不要传。"
          },
          "image_urls": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "首帧和可选的尾帧，按此顺序排列。使用公开的 HTTP(S) 图片 URL 或 Base64 图片。文生视频时不传或传 []。"
          }
        },
        "not": {
          "required": [
            "image_urls",
            "aspect_ratio"
          ],
          "properties": {
            "image_urls": {
              "minItems": 1
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。"
          },
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error"
              }
            }
          }
        }
      }
    }
  }
}
