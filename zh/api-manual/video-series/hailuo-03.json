{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - Hailuo 03 API",
    "description": "根据文本、关键帧或多模态参考生成 2K 视频",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交 Hailuo 03 任务",
        "operationId": "submitHailuo03Task",
        "tags": [
          "Hailuo 03"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "text-to-video": {
                  "summary": "文生视频",
                  "value": {
                    "model": "hailuo-03",
                    "input": {
                      "prompt": "A cinematic aerial view of a coastal city at sunrise",
                      "duration": 5,
                      "resolution": "2K",
                      "aspect_ratio": "16:9"
                    }
                  }
                },
                "image-to-video": {
                  "summary": "首尾帧",
                  "value": {
                    "model": "hailuo-03",
                    "input": {
                      "prompt": "The camera glides forward as daylight turns into sunset",
                      "duration": 8,
                      "resolution": "2K",
                      "image_urls": [
                        "https://storage.poyo.ai/examples/hailuo-03/start.jpg",
                        "https://storage.poyo.ai/examples/hailuo-03/end.jpg"
                      ]
                    }
                  }
                },
                "reference-images": {
                  "summary": "参考图像",
                  "value": {
                    "model": "hailuo-03",
                    "input": {
                      "prompt": "Image 1 walks through the environment shown in Image 2",
                      "duration": 10,
                      "resolution": "2K",
                      "aspect_ratio": "adaptive",
                      "reference_image_urls": [
                        "https://storage.poyo.ai/examples/hailuo-03/subject.jpg",
                        "https://storage.poyo.ai/examples/hailuo-03/style.jpg"
                      ]
                    }
                  }
                },
                "reference-video": {
                  "summary": "参考视频",
                  "value": {
                    "model": "hailuo-03",
                    "input": {
                      "prompt": "Use the motion from Video 1",
                      "duration": 5,
                      "resolution": "2K",
                      "reference_video_urls": [
                        "https://storage.poyo.ai/examples/hailuo-03/motion.mp4"
                      ]
                    }
                  }
                },
                "multimodal-reference": {
                  "summary": "图像、视频和音频组合参考",
                  "value": {
                    "model": "hailuo-03",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "Image 1 follows the movement in Video 1 with the atmosphere of Audio 1",
                      "duration": 10,
                      "resolution": "2K",
                      "aspect_ratio": "16:9",
                      "reference_image_urls": [
                        "https://storage.poyo.ai/examples/hailuo-03/character.jpg"
                      ],
                      "reference_video_urls": [
                        "https://storage.poyo.ai/examples/hailuo-03/motion.mp4"
                      ],
                      "reference_audio_urls": [
                        "https://storage.poyo.ai/examples/hailuo-03/atmosphere.mp3"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未授权：API Key 无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "所有 API 接口都需要 Bearer Token 认证。\n\n创建 API Key：登录 PoYo，进入 **仪表盘 → API 密钥**（[poyo.ai/zh/dashboard/api-key](https://poyo.ai/zh/dashboard/api-key)），点击创建 Key。\n\n在请求头中添加：\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "hailuo-03"
            ],
            "example": "hailuo-03"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "可选的 Webhook 回调 URL。"
          },
          "input": {
            "$ref": "#/components/schemas/Hailuo03Input"
          }
        }
      },
      "Hailuo03Input": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "文本提示词。按模态和顺序引用素材，例如 Image 1、Video 1 或 Audio 1。"
          },
          "duration": {
            "type": "integer",
            "minimum": 5,
            "maximum": 15,
            "default": 5,
            "description": "生成视频的时长，单位为秒。"
          },
          "resolution": {
            "type": "string",
            "enum": [
              "2K"
            ],
            "default": "2K"
          },
          "aspect_ratio": {
            "type": "string",
            "enum": [
              "adaptive",
              "21:9",
              "16:9",
              "4:3",
              "1:1",
              "3:4",
              "9:16"
            ],
            "description": "适用于文生视频和参考生视频。图生视频以第一张图像为准。"
          },
          "image_urls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "起始帧和可选的结束帧。不能与参考字段同时使用。"
          },
          "reference_image_urls": {
            "type": "array",
            "maxItems": 9,
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "主体或风格参考图像。"
          },
          "reference_video_urls": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "参考视频片段。每个片段必须为 2–15 秒，合计时长不得超过 15 秒。"
          },
          "reference_audio_urls": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "参考音频片段。每个片段必须为 2–15 秒。使用音频时至少需要一张参考图像或一个参考视频。"
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。"
          },
          "message": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "type": "object",
            "properties": {
              "task_id": {
                "type": "string",
                "example": "8FDN1I7M7Q68DDG8"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。"
          },
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error"
              }
            }
          }
        }
      }
    }
  }
}
