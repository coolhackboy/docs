{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - Flux 3 Max API",
    "description": "根据文本、首尾帧图像或指定位置的关键帧生成视频，可选生成音频。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交 Flux 3 Max 任务",
        "operationId": "submitFlux3MaxTask",
        "tags": [
          "Flux 3 Max"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "text-to-video": {
                  "summary": "文本生成",
                  "value": {
                    "model": "flux-3-max/text-to-video",
                    "input": {
                      "prompt": "A red panda walks through a sunlit forest",
                      "duration": 5,
                      "resolution": "720p"
                    }
                  }
                },
                "image-to-video": {
                  "summary": "让首帧图像动起来",
                  "value": {
                    "model": "flux-3-max/image-to-video",
                    "input": {
                      "prompt": "The camera slowly moves closer",
                      "image_urls": [
                        "https://example.com/start.png"
                      ]
                    }
                  }
                },
                "first-last-frame": {
                  "summary": "在首帧和尾帧图像之间生成动画",
                  "value": {
                    "model": "flux-3-max/image-to-video",
                    "input": {
                      "prompt": "Transition smoothly from sunrise to sunset",
                      "image_urls": [
                        "https://example.com/start.png",
                        "https://example.com/end.png"
                      ],
                      "duration": 8,
                      "sound": false
                    }
                  }
                },
                "keyframes-to-video": {
                  "summary": "根据指定位置的关键帧生成动画",
                  "value": {
                    "model": "flux-3-max/keyframes-to-video",
                    "input": {
                      "prompt": "Move smoothly through both scenes",
                      "duration": 5,
                      "keyframes": [
                        {
                          "image_url": "https://example.com/frame-1.png",
                          "frame_index": 0
                        },
                        {
                          "image_url": "https://example.com/frame-2.png",
                          "frame_index": 120
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未授权",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "所有 API 接口都需要 Bearer Token 认证。\n\n创建 API Key：登录 PoYo，进入 **仪表盘 → API 密钥**（[poyo.ai/zh/dashboard/api-key](https://poyo.ai/zh/dashboard/api-key)），点击创建 Key。\n\n在请求头中添加：\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "flux-3-max/text-to-video",
              "flux-3-max/image-to-video",
              "flux-3-max/keyframes-to-video"
            ],
            "description": "公开的模型标识。"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "任务完成或失败时接收通知的 Webhook URL。"
          },
          "input": {
            "type": "object",
            "required": [
              "prompt"
            ],
            "additionalProperties": false,
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "description": "描述场景、运动、镜头行为和所需音频。必须包含非空白文本。"
              },
              "image_urls": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "description": "仅 flux-3-max/image-to-video 必填。按顺序提供一张首帧图像和一张可选的尾帧图像。不要与 keyframes 同时使用。必须是公开可访问的 HTTP 或 HTTPS URL。"
              },
              "keyframes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "$ref": "#/components/schemas/Keyframe"
                },
                "description": "仅 flux-3-max/keyframes-to-video 必填。提供 1-10 张图像，frame_index 值互不重复，取值范围为 0 到 duration * 24。不要与 image_urls 同时使用。"
              },
              "duration": {
                "type": "integer",
                "minimum": 5,
                "maximum": 20,
                "default": 5,
                "description": "输出时长，单位为秒。"
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "720p",
                  "1080p"
                ],
                "default": "720p",
                "description": "输出视频分辨率。"
              },
              "aspect_ratio": {
                "type": "string",
                "enum": [
                  "auto",
                  "21:9",
                  "2:1",
                  "16:9",
                  "4:3",
                  "1:1",
                  "3:4",
                  "9:16"
                ],
                "default": "auto",
                "description": "输出宽高比。auto 在文本输入时使用 16:9，在图像或关键帧输入时跟随第一张图像。"
              },
              "sound": {
                "type": "boolean",
                "default": true,
                "description": "随视频一起生成音频。"
              }
            },
            "description": "所选模型的参数。媒体字段仅在对应模式下必填。"
          }
        },
        "description": "根据文本、首尾帧图像或指定位置的关键帧生成视频，可选生成音频。",
        "x-poyo-model-requests": {
          "$ref": "#/components/schemas/ModelRequests"
        }
      },
      "TextToVideoRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "flux-3-max/text-to-video"
            ],
            "description": "公开的模型标识。"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "任务完成或失败时接收通知的 Webhook URL。"
          },
          "input": {
            "type": "object",
            "required": [
              "prompt"
            ],
            "additionalProperties": false,
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "description": "描述场景、运动、镜头行为和所需音频。必须包含非空白文本。"
              },
              "duration": {
                "type": "integer",
                "minimum": 5,
                "maximum": 20,
                "default": 5,
                "description": "输出时长，单位为秒。"
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "720p",
                  "1080p"
                ],
                "default": "720p",
                "description": "输出视频分辨率。"
              },
              "aspect_ratio": {
                "type": "string",
                "enum": [
                  "auto",
                  "21:9",
                  "2:1",
                  "16:9",
                  "4:3",
                  "1:1",
                  "3:4",
                  "9:16"
                ],
                "default": "auto",
                "description": "输出宽高比。auto 在文本输入时使用 16:9，在图像或关键帧输入时跟随第一张图像。"
              },
              "sound": {
                "type": "boolean",
                "default": true,
                "description": "随视频一起生成音频。"
              }
            }
          }
        },
        "description": "根据文本生成 5-20 秒的视频，可选生成音频。不接受媒体输入。"
      },
      "ImageToVideoRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "flux-3-max/image-to-video"
            ],
            "description": "公开的模型标识。"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "任务完成或失败时接收通知的 Webhook URL。"
          },
          "input": {
            "type": "object",
            "required": [
              "prompt",
              "image_urls"
            ],
            "additionalProperties": false,
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "description": "描述场景、运动、镜头行为和所需音频。必须包含非空白文本。"
              },
              "duration": {
                "type": "integer",
                "minimum": 5,
                "maximum": 20,
                "default": 5,
                "description": "输出时长，单位为秒。"
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "720p",
                  "1080p"
                ],
                "default": "720p",
                "description": "输出视频分辨率。"
              },
              "aspect_ratio": {
                "type": "string",
                "enum": [
                  "auto",
                  "21:9",
                  "2:1",
                  "16:9",
                  "4:3",
                  "1:1",
                  "3:4",
                  "9:16"
                ],
                "default": "auto",
                "description": "输出宽高比。auto 在文本输入时使用 16:9，在图像或关键帧输入时跟随第一张图像。"
              },
              "sound": {
                "type": "boolean",
                "default": true,
                "description": "随视频一起生成音频。"
              },
              "image_urls": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "description": "一张首帧图像，后面可选跟一张尾帧图像。支持 PNG、JPEG 和 WebP。必须是公开可访问的 HTTP 或 HTTPS URL。"
              }
            }
          }
        },
        "description": "根据一张首帧图像和一张可选的尾帧图像生成 5-20 秒的视频，可选生成音频。"
      },
      "KeyframesToVideoRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "flux-3-max/keyframes-to-video"
            ],
            "description": "公开的模型标识。"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "任务完成或失败时接收通知的 Webhook URL。"
          },
          "input": {
            "type": "object",
            "required": [
              "prompt",
              "keyframes"
            ],
            "additionalProperties": false,
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "description": "描述场景、运动、镜头行为和所需音频。必须包含非空白文本。"
              },
              "duration": {
                "type": "integer",
                "minimum": 5,
                "maximum": 20,
                "default": 5,
                "description": "输出时长，单位为秒。"
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "720p",
                  "1080p"
                ],
                "default": "720p",
                "description": "输出视频分辨率。"
              },
              "aspect_ratio": {
                "type": "string",
                "enum": [
                  "auto",
                  "21:9",
                  "2:1",
                  "16:9",
                  "4:3",
                  "1:1",
                  "3:4",
                  "9:16"
                ],
                "default": "auto",
                "description": "输出宽高比。auto 在文本输入时使用 16:9，在图像或关键帧输入时跟随第一张图像。"
              },
              "sound": {
                "type": "boolean",
                "default": true,
                "description": "随视频一起生成音频。"
              },
              "keyframes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "$ref": "#/components/schemas/Keyframe"
                },
                "description": "放置在 24 fps 时间轴上的图像。frame_index 值必须互不重复，且不大于 duration * 24。"
              }
            }
          }
        },
        "description": "使用 1-10 张关键帧图像生成 5-20 秒的视频，关键帧位于 24 fps 时间轴上互不重复的位置，可选生成音频。"
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "example": 200,
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。"
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1792468800-example"
              },
              "status": {
                "type": "string",
                "enum": ["not_started", "running", "finished", "failed"],
                "example": "not_started",
                "description": "任务状态。提交后立即返回时始终为 `not_started`。后续状态请通过[查询任务状态](/zh/api-manual/task-management/status)接口或 `callback_url` 获取。\n\n- `not_started`：排队中，等待处理\n- `running`：生成中\n- `finished`：已完成，结果在 `files` 或 `output` 中\n- `failed`：失败，详情见 `error_message`"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2026-10-20T12:00:00"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error"
              }
            }
          }
        }
      },
      "Keyframe": {
        "type": "object",
        "required": [
          "image_url",
          "frame_index"
        ],
        "additionalProperties": false,
        "properties": {
          "image_url": {
            "type": "string",
            "format": "uri",
            "description": "公开的 PNG、JPEG 或 WebP 图像 URL。必须是公开可访问的 HTTP 或 HTTPS URL。"
          },
          "frame_index": {
            "type": "integer",
            "minimum": 0,
            "description": "互不重复的帧位置，取值范围为 0 到 duration * 24（含两端）。"
          }
        }
      },
      "ModelRequests": {
        "type": "object",
        "oneOf": [
          {
            "$ref": "#/components/schemas/TextToVideoRequest"
          },
          {
            "$ref": "#/components/schemas/ImageToVideoRequest"
          },
          {
            "$ref": "#/components/schemas/KeyframesToVideoRequest"
          }
        ],
        "discriminator": {
          "propertyName": "model",
          "mapping": {
            "flux-3-max/text-to-video": "#/components/schemas/TextToVideoRequest",
            "flux-3-max/image-to-video": "#/components/schemas/ImageToVideoRequest",
            "flux-3-max/keyframes-to-video": "#/components/schemas/KeyframesToVideoRequest"
          }
        }
      }
    }
  }
}
