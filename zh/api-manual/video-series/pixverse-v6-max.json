{
  "openapi": "3.0.0",
  "info": {
    "title": "PixVerse V6 Max",
    "description": "根据文本或一张图片生成 1-15 秒的视频，可选原生音频。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交 PixVerse V6 Max 视频任务",
        "operationId": "submit_pixverse_v6_max",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "text-to-video": {
                  "summary": "根据文本生成视频",
                  "value": {
                    "model": "pixverse-v6-max",
                    "input": {
                      "prompt": "A blue glass marble rolls across a clean white table in warm morning light",
                      "duration": 5,
                      "resolution": "540p",
                      "aspect_ratio": "16:9"
                    }
                  }
                },
                "image-to-video": {
                  "summary": "让一张图片动起来",
                  "value": {
                    "model": "pixverse-v6-max",
                    "input": {
                      "prompt": "Animate this product with gentle movement",
                      "image_urls": [
                        "https://example.com/product.jpg"
                      ],
                      "duration": 5,
                      "resolution": "540p"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未授权：API Key 无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "所有 API 接口都需要 Bearer Token 认证。\n\n创建 API Key：登录 PoYo，进入 **仪表盘 → API 密钥**（[poyo.ai/zh/dashboard/api-key](https://poyo.ai/zh/dashboard/api-key)），点击创建 Key。\n\n在请求头中添加：\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "pixverse-v6-max"
            ],
            "description": "公开的模型标识。"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "可选的 Webhook URL，用于接收任务完成或失败通知。请使用公开可访问的 HTTP 或 HTTPS URL。"
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "description": "文生视频需要 prompt，不传 image_urls。图生视频需要恰好一项 image_urls，且不接受 aspect_ratio。",
            "properties": {
              "prompt": {
                "type": "string",
                "maxLength": 5000,
                "description": "文生视频时必填，最多 5,000 个字符。图生视频时可选，最多 2,048 个字符。不能为空白。"
              },
              "image_urls": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "description": "图生视频使用的图片，必须恰好一个公开的 HTTP 或 HTTPS 图片 URL。支持 JPEG、PNG 或 WebP。文生视频时不要传此字段。"
              },
              "duration": {
                "type": "integer",
                "minimum": 1,
                "maximum": 15,
                "default": 5,
                "description": "输出时长，单位为整秒。"
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "360p",
                  "540p",
                  "720p",
                  "1080p"
                ],
                "default": "540p",
                "description": "输出视频分辨率。"
              },
              "aspect_ratio": {
                "type": "string",
                "enum": [
                  "16:9",
                  "9:16",
                  "4:3",
                  "3:4",
                  "1:1",
                  "2:3",
                  "3:2",
                  "21:9"
                ],
                "default": "16:9",
                "description": "文生视频的画面比例。图生视频时不要传此字段。"
              },
              "audio": {
                "type": "boolean",
                "default": false,
                "description": "生成原生音轨。默认生成无声视频。"
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。"
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1792190000-example"
              },
              "status": {
                "type": "string",
                "enum": ["not_started", "running", "finished", "failed"],
                "example": "not_started",
                "description": "任务状态。提交后立即返回时始终为 `not_started`。后续状态请通过[查询任务状态](/zh/api-manual/task-management/status)接口或 `callback_url` 获取。\n\n- `not_started`：排队中，等待处理\n- `running`：生成中\n- `finished`：已完成，结果在 `files` 或 `output` 中\n- `failed`：失败，详情见 `error_message`"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2026-10-28T10:30:00"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。"
          },
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error"
              }
            }
          }
        }
      }
    }
  }
}
