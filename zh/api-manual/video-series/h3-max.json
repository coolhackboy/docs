{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - H3 Max API",
    "description": "根据文本、关键帧或以图像为主的多模态参考生成 5–15 秒的视频。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交 H3 Max 任务",
        "operationId": "submitH3MaxTask",
        "tags": [
          "H3 Max"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "text-to-video": {
                  "summary": "文生视频",
                  "value": {
                    "model": "h3-max",
                    "input": {
                      "prompt": "A cinematic aerial view of a coastal city at sunrise"
                    }
                  }
                },
                "image-to-video": {
                  "summary": "图生视频",
                  "value": {
                    "model": "h3-max",
                    "input": {
                      "prompt": "The camera moves forward as daylight turns into sunset",
                      "duration": 8,
                      "resolution": "1080p",
                      "image_urls": [
                        "https://example.com/start.jpg",
                        "https://example.com/end.jpg"
                      ]
                    }
                  }
                },
                "reference-to-video": {
                  "summary": "参考生视频",
                  "value": {
                    "model": "h3-max",
                    "input": {
                      "prompt": "Image 1 follows the movement in Video 1 with the atmosphere of Audio 1",
                      "duration": 10,
                      "resolution": "768p",
                      "aspect_ratio": "adaptive",
                      "reference_image_urls": [
                        "https://example.com/subject.jpg"
                      ],
                      "reference_video_urls": [
                        "https://example.com/motion.mp4"
                      ],
                      "reference_audio_urls": [
                        "https://example.com/atmosphere.wav"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未授权：API Key 无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "所有 API 接口都需要 Bearer Token 认证。\n\n创建 API Key：登录 PoYo，进入 **仪表盘 → API 密钥**（[poyo.ai/zh/dashboard/api-key](https://poyo.ai/zh/dashboard/api-key)），点击创建 Key。\n\n在请求头中添加：\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "h3-max"
            ],
            "example": "h3-max"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "可选的 Webhook 回调 URL。"
          },
          "input": {
            "$ref": "#/components/schemas/H3MaxInput"
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。"
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1790245800-h3max01"
              },
              "status": {
                "type": "string",
                "example": "not_started",
                "enum": ["not_started", "running", "finished", "failed"],
                "description": "任务状态。提交后立即返回时始终为 `not_started`。后续状态请通过[查询任务状态](/zh/api-manual/task-management/status)接口或 `callback_url` 获取。\n\n- `not_started`：排队中，等待处理\n- `running`：生成中\n- `finished`：已完成，结果在 `files` 或 `output` 中\n- `failed`：失败，详情见 `error_message`"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2026-09-24T10:30:00Z",
                "description": "任务创建时间，ISO 8601 格式。"
              }
            }
          }
        },
        "example": {
          "code": 200,
          "data": {
            "task_id": "task-unified-1790245800-h3max01",
            "status": "not_started",
            "created_time": "2026-09-24T10:30:00Z"
          }
        }
      },
      "H3MaxInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prompt"
        ],
        "description": "参考素材总数最多 12 个。所有媒体 URL 必须使用 HTTP(S)。参考视频和参考音频都需要同时提供参考图像。媒体元数据由服务端计算。",
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50000,
            "description": "描述视频内容。提示词不能只包含空白字符。以 Image 1、Video 1 或 Audio 1 引用素材。"
          },
          "duration": {
            "type": "integer",
            "minimum": 5,
            "maximum": 15,
            "default": 5
          },
          "resolution": {
            "type": "string",
            "enum": [
              "480p",
              "768p",
              "1080p"
            ],
            "default": "768p"
          },
          "enable_safety_checker": {
            "type": "boolean",
            "default": true,
            "description": "设为 true 时启用安全检查器。默认为 true。"
          },
          "aspect_ratio": {
            "type": "string",
            "enum": [
              "21:9",
              "16:9",
              "4:3",
              "1:1",
              "3:4",
              "9:16",
              "adaptive"
            ],
            "description": "文本模式默认为 16:9，且不接受 adaptive。参考模式默认为 adaptive。与 image_urls 同时提供时不接受此字段。"
          },
          "image_urls": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "起始帧和可选的结束帧；与所有参考字段互斥。"
          },
          "reference_image_urls": {
            "type": "array",
            "maxItems": 9,
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "主体或风格图像；提供参考视频或音频时必填。支持的比例：1:1、4:3、3:4、16:9、9:16、5:2、2:5。"
          },
          "reference_video_urls": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "每个片段必须为 2–15 秒；视频合计时长不得超过 15 秒。要求恒定 24 fps、方形像素、无旋转元数据，且为 16:9 或 9:16。按请求的输出时长截取帧后，计入的帧数必须为 48、120、240 或 360。"
          },
          "reference_audio_urls": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "每个片段必须为 2–15 秒；音频合计时长不得超过 15 秒。要求 32 kHz，且解码后的采样数能被 800 整除。每个片段不得超过请求的输出时长。"
          }
        },
        "allOf": [
          {
            "not": {
              "required": [
                "image_urls"
              ],
              "properties": {
                "image_urls": {
                  "minItems": 1
                }
              },
              "not": {
                "not": {
                  "required": [
                    "aspect_ratio"
                  ]
                },
                "properties": {
                  "reference_image_urls": {
                    "maxItems": 0
                  },
                  "reference_video_urls": {
                    "maxItems": 0
                  },
                  "reference_audio_urls": {
                    "maxItems": 0
                  }
                }
              }
            }
          },
          {
            "not": {
              "required": [
                "aspect_ratio"
              ],
              "properties": {
                "aspect_ratio": {
                  "enum": [
                    "adaptive"
                  ]
                },
                "reference_image_urls": {
                  "maxItems": 0
                },
                "reference_video_urls": {
                  "maxItems": 0
                },
                "reference_audio_urls": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "not": {
              "required": [
                "reference_video_urls"
              ],
              "properties": {
                "reference_video_urls": {
                  "minItems": 1
                }
              },
              "not": {
                "required": [
                  "reference_image_urls"
                ],
                "properties": {
                  "reference_image_urls": {
                    "minItems": 1
                  }
                }
              }
            }
          },
          {
            "not": {
              "required": [
                "reference_audio_urls"
              ],
              "properties": {
                "reference_audio_urls": {
                  "minItems": 1
                }
              },
              "not": {
                "required": [
                  "reference_image_urls"
                ],
                "properties": {
                  "reference_image_urls": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。"
          },
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error"
              }
            }
          }
        }
      }
    }
  }
}
