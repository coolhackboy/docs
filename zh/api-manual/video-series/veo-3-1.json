{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - VEO 3.1 API",
    "description": "使用 Google VEO 3.1 进行 lite、fast 和高质量视频生成。所有模型均支持文生视频；fast 和 quality 支持图生视频。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交 VEO 3.1 视频生成任务",
        "description": "使用 Google VEO 3.1 进行 lite、fast 和高质量视频生成。所有模型均支持文生视频；fast 和 quality 支持图生视频。",
        "operationId": "submitVEO3Task",
        "tags": [
          "VEO 3.1"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "veo3.1-fast": {
                  "summary": "VEO 3.1 Fast 视频生成",
                  "value": {
                    "model": "veo3.1-fast",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "Dolphins jumping in a bright blue ocean",
                      "duration": 8,
                      "aspect_ratio": "16:9"
                    }
                  }
                },
                "veo3.1-lite": {
                  "summary": "VEO 3.1 Lite 文生视频",
                  "value": {
                    "model": "veo3.1-lite",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "A cinematic miniature city waking up at sunrise, realistic lighting, smooth camera motion",
                      "duration": 8,
                      "aspect_ratio": "16:9",
                      "resolution": "720p"
                    }
                  }
                },
                "veo3.1-quality": {
                  "summary": "VEO 3.1 Quality 4k 生成",
                  "value": {
                    "model": "veo3.1-quality",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "A high-detail aerial view of a coastal city at dusk",
                      "duration": 8,
                      "aspect_ratio": "16:9",
                      "resolution": "4k"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 400,
                  "error": {
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "未授权：API Key 无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 401,
                  "error": {
                    "message": "Unauthorized - Invalid API key",
                    "type": "authentication_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "所有 API 接口都需要 Bearer Token 认证。\n\n创建 API Key：登录 PoYo，进入 **仪表盘 → API 密钥**（[poyo.ai/zh/dashboard/api-key](https://poyo.ai/zh/dashboard/api-key)），点击创建 Key。\n\n在请求头中添加：\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "VEO 3.1 模型标识符",
            "enum": [
              "veo3.1-fast",
              "veo3.1-lite",
              "veo3.1-quality"
            ]
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "接收结果通知的 Webhook 回调 URL",
            "example": "https://your-domain.com/callback"
          },
          "input": {
            "type": "object",
            "required": [
              "prompt"
            ],
            "description": "生成参数",
            "properties": {
              "prompt": {
                "type": "string",
                "description": "描述期望输出的生成提示词",
                "example": "A cinematic video scene"
              },
              "image_urls": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "maxItems": 3,
                "description": "受支持模型上用于图生视频的参考图 URL。\n\n- 支持公开的 http/https URL。\n\n- 最多 3 张图像。\n\n- 帧模式：第一张图为起始帧，第二张图为结束帧。\n\n- 最大文件大小：10MB。\n\n- 支持格式：.jpeg、.jpg、.png、.webp。\n\n- `veo3.1-lite` 不支持此参数；不要传 `image_urls`。",
                "example": []
              },
              "generation_type": {
                "type": "string",
                "description": "视频生成类型。\n\n- `frame`：帧生视频（两张图像）。\n\n- `reference`：参考图生视频（三张图像）。\n\n- 省略时按 `image_urls` 数量推断：2 张为 `frame`，3 张为 `reference`。\n\n- `veo3.1-quality` 不支持 `reference` 模式。\n\n- `veo3.1-lite` 不支持此参数；不要传 `generation_type`。",
                "enum": [
                  "frame",
                  "reference"
                ],
                "example": "frame"
              },
              "duration": {
                "type": "integer",
                "description": "视频时长，单位为秒。本页的 VEO 3.1 模型使用 8 秒。",
                "enum": [
                  4,
                  6,
                  8
                ],
                "example": 8
              },
              "aspect_ratio": {
                "type": "string",
                "description": "视频宽高比",
                "enum": [
                  "16:9",
                  "9:16"
                ],
                "example": "16:9"
              },
              "resolution": {
                "type": "string",
                "description": "输出分辨率。\n\n- `720p`：默认。\n\n- `1080p`：全高清。\n\n- `4k`：超高清。",
                "enum": [
                  "720p",
                  "1080p",
                  "4k"
                ],
                "default": "720p",
                "example": "1080p"
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503]
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1757165031-uyujaw3d",
                "description": "任务唯一标识，用于查询任务状态"
              },
              "status": {
                "type": "string",
                "enum": ["not_started", "running", "finished", "failed"],
                "example": "not_started",
                "description": "任务状态。提交后立即返回时始终为 `not_started`。后续状态请通过[查询任务状态](/zh/api-manual/task-management/status)接口或 `callback_url` 获取。\n\n- `not_started`：排队中，等待处理\n- `running`：生成中\n- `finished`：已完成，结果在 `files` 或 `output` 中\n- `failed`：失败，详情见 `error_message`"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2025-11-12T10:30:00",
                "description": "任务创建时间，ISO 8601 格式"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503]
          },
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters",
                "description": "描述错误原因的错误信息"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error",
                "description": "错误类型标识"
              }
            }
          }
        }
      }
    }
  }
}
