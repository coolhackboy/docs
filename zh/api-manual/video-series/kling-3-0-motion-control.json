{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - Kling 3.0 Motion Control API",
    "description": "Kling 3.0 Motion Control API 将一个参考视频中的动作迁移到一张图像上，分辨率为 720p 或 1080p。video 朝向模式下最长 30 秒，并可选提供一个面部元素；image 朝向模式下最长 10 秒。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交 Kling 3.0 Motion Control 任务",
        "description": "将参考视频中的动作迁移到参考图像上",
        "operationId": "submitKling30MotionControlTask",
        "tags": [
          "Kling 3.0 Motion Control"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "kling-3-0-motion-control": {
                  "summary": "Kling 3.0 Motion Control",
                  "value": {
                    "model": "kling-3.0-motion-control",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "image_urls": [
                        "https://storage.poyo.ai/kling-3.0-motion-control/reference-image-new.png"
                      ],
                      "video_urls": [
                        "https://storage.poyo.ai/kling-3.0-motion-control/reference-video-new.mp4"
                      ],
                      "character_orientation": "video",
                      "resolution": "720p",
                      "prompt": "Keep the identity consistent and reference @Element1 for facial details",
                      "kling_elements": [
                        {
                          "frontal_image_url": "https://example.com/front-face.png",
                          "reference_image_urls": [
                            "https://example.com/face-angle-1.png"
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未授权：API Key 无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "所有 API 接口都需要 Bearer Token 认证。\n\n创建 API Key：登录 PoYo，进入 **仪表盘 → API 密钥**（[poyo.ai/zh/dashboard/api-key](https://poyo.ai/zh/dashboard/api-key)），点击创建 Key。\n\n在请求头中添加：\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Kling 3.0 Motion Control 模型标识符",
            "enum": [
              "kling-3.0-motion-control"
            ]
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "接收结果通知的 Webhook 回调 URL",
            "example": "https://your-domain.com/callback"
          },
          "input": {
            "type": "object",
            "required": [
              "image_urls",
              "video_urls",
              "character_orientation"
            ],
            "properties": {
              "prompt": {
                "type": "string",
                "description": "可选的场景细节提示词。可以为空，最多 2,500 个字符。",
                "maxLength": 2500,
                "example": "Keep the character movement smooth and natural"
              },
              "image_urls": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "minItems": 1,
                "maxItems": 1,
                "description": "参考图像 URL 数组。仅支持一张图像。支持 JPG、JPEG、PNG，最大 10MB",
                "example": [
                  "https://storage.poyo.ai/kling-3.0-motion-control/reference-image-new.png"
                ]
              },
              "video_urls": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "minItems": 1,
                "maxItems": 1,
                "description": "参考视频 URL 数组。仅支持一个视频。支持 MP4、MOV，最大 100MB",
                "example": [
                  "https://storage.poyo.ai/kling-3.0-motion-control/reference-video-new.mp4"
                ]
              },
              "character_orientation": {
                "type": "string",
                "description": "角色朝向模式",
                "enum": [
                  "image",
                  "video"
                ],
                "example": "image"
              },
              "resolution": {
                "type": "string",
                "description": "输出分辨率",
                "enum": [
                  "720p",
                  "1080p"
                ],
                "default": "720p",
                "example": "720p"
              },
              "kling_elements": {
                "type": "array",
                "maxItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "frontal_image_url",
                    "reference_image_urls"
                  ],
                  "properties": {
                    "frontal_image_url": {
                      "type": "string",
                      "format": "uri",
                      "description": "面部元素主视图必填的正面图像 URL。支持 JPG、JPEG、PNG、WebP，最大 10MB",
                      "example": "https://example.com/front-face.png"
                    },
                    "reference_image_urls": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "format": "uri"
                      },
                      "minItems": 1,
                      "maxItems": 3,
                      "description": "其他角度的面部参考图像 URL。支持 1-3 张图像",
                      "example": [
                        "https://example.com/face-angle-1.png"
                      ]
                    }
                  }
                },
                "description": "可选的面部一致性元素定义。仅在 `character_orientation` 为 `video` 时可用。仅支持 1 个元素，可在提示词中以 `@Element1` 引用。提供元素时，`frontal_image_url` 和 `reference_image_urls` 均为必填",
                "example": [
                  {
                    "frontal_image_url": "https://example.com/front-face.png",
                    "reference_image_urls": [
                      "https://example.com/face-angle-1.png"
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。"
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1757165031-uyujaw3d"
              },
              "status": {
                "type": "string",
                "enum": ["not_started", "running", "finished", "failed"],
                "example": "not_started",
                "description": "任务状态。提交后立即返回时始终为 `not_started`。后续状态请通过[查询任务状态](/zh/api-manual/task-management/status)接口或 `callback_url` 获取。\n\n- `not_started`：排队中，等待处理\n- `running`：生成中\n- `finished`：已完成，结果在 `files` 或 `output` 中\n- `failed`：失败，详情见 `error_message`"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2025-11-12T10:30:00"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。"
          },
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error"
              }
            }
          }
        }
      }
    }
  }
}
