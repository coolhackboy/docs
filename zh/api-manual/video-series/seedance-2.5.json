{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - Seedance 2.5 API",
    "description": "Seedance 2.5 API 根据文本、首尾帧，或图片、视频、音频参考生成 4–30 秒的 480p、720p 或 1080p 视频。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交 Seedance 2.5 视频任务",
        "operationId": "submitSeedance25Task",
        "tags": [
          "Seedance 2.5"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "text-to-video": {
                  "value": {
                    "model": "seedance-2.5",
                    "input": {
                      "prompt": "A cinematic aerial view of a city at night",
                      "duration": 5,
                      "resolution": "1080p",
                      "aspect_ratio": "16:9",
                      "generate_audio": true
                    }
                  }
                },
                "first-last-frame": {
                  "value": {
                    "model": "seedance-2.5",
                    "input": {
                      "prompt": "Transition smoothly between the two frames",
                      "image_urls": [
                        "https://example.com/first.jpg",
                        "https://example.com/last.jpg"
                      ],
                      "duration": 5,
                      "resolution": "720p"
                    }
                  }
                },
                "reference-to-video": {
                  "value": {
                    "model": "seedance-2.5",
                    "input": {
                      "prompt": "Use @Video1 for motion and @Audio1 for rhythm",
                      "reference_video_urls": [
                        "https://example.com/reference.mp4"
                      ],
                      "reference_audio_urls": [
                        "https://example.com/reference.wav"
                      ],
                      "duration": 5,
                      "resolution": "480p"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功"
          },
          "400": {
            "description": "请求参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未授权：API Key 无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "所有 API 接口都需要 Bearer Token 认证。\n\n创建 API Key：登录 PoYo，进入 **仪表盘 → API 密钥**（[poyo.ai/zh/dashboard/api-key](https://poyo.ai/zh/dashboard/api-key)），点击创建 Key。\n\n在请求头中添加：\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "seedance-2.5"
            ]
          },
          "callback_url": {
            "type": "string",
            "format": "uri"
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "prompt",
              "duration",
              "resolution"
            ],
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "image_urls": {
                "type": "array",
                "maxItems": 2,
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "reference_image_urls": {
                "type": "array",
                "maxItems": 30,
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "reference_video_urls": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "reference_audio_urls": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "480p",
                  "720p",
                  "1080p"
                ]
              },
              "duration": {
                "type": "integer",
                "minimum": 4,
                "maximum": 30
              },
              "aspect_ratio": {
                "type": "string",
                "enum": [
                  "auto",
                  "21:9",
                  "16:9",
                  "4:3",
                  "1:1",
                  "3:4",
                  "9:16"
                ]
              },
              "generate_audio": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。"
          },
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error"
              }
            }
          }
        }
      }
    }
  }
}
