{
  "openapi": "3.1.0",
  "info": {
    "title": "PoYo AI - 3D 任务状态 API",
    "description": "查询 3D 任务执行状态并获取生成的模型文件",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/status/{task_id}": {
      "get": {
        "summary": "查询 3D 任务状态",
        "operationId": "queryThreeDTaskStatus",
        "tags": [
          "3D Task Management"
        ],
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "提交接口返回的唯一任务标识"
          }
        ],
        "responses": {
          "200": {
            "description": "任务状态",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                },
                "examples": {
                  "finished": {
                    "summary": "已完成的 3D 任务",
                    "value": {
                      "code": 200,
                      "data": {
                        "task_id": "9OTM0HH9LBS63LF0",
                        "status": "finished",
                        "credits_amount": 30,
                        "files": [
                          {
                            "file_url": "https://cdn.doculator.org/3d/9OTM0HH9LBS63LF0/9OTM0HH9LBS63LF0_1.glb",
                            "file_type": "3d"
                          },
                          {
                            "file_url": "https://cdn.doculator.org/3d/9OTM0HH9LBS63LF0/9OTM0HH9LBS63LF0_2.png",
                            "file_type": "image"
                          },
                          {
                            "file_url": "https://cdn.doculator.org/3d/9OTM0HH9LBS63LF0/9OTM0HH9LBS63LF0_3.glb",
                            "file_type": "3d"
                          }
                        ],
                        "created_time": "2026-05-12T02:36:12",
                        "progress": 100
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "所有 API 接口都需要 Bearer Token 认证。\n\n创建 API Key：登录 PoYo，进入 **仪表盘 → API 密钥**（[poyo.ai/zh/dashboard/api-key](https://poyo.ai/zh/dashboard/api-key)），点击创建 Key。\n\n在请求头中添加：\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "StatusResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。"
          },
          "data": {
            "$ref": "#/components/schemas/TaskStatus"
          }
        },
        "example": {
          "code": 200,
          "data": {
            "task_id": "9OTM0HH9LBS63LF0",
            "status": "finished",
            "credits_amount": 30,
            "files": [
              {
                "file_url": "https://cdn.doculator.org/3d/9OTM0HH9LBS63LF0/9OTM0HH9LBS63LF0_1.glb",
                "file_type": "3d"
              },
              {
                "file_url": "https://cdn.doculator.org/3d/9OTM0HH9LBS63LF0/9OTM0HH9LBS63LF0_2.png",
                "file_type": "image"
              },
              {
                "file_url": "https://cdn.doculator.org/3d/9OTM0HH9LBS63LF0/9OTM0HH9LBS63LF0_3.glb",
                "file_type": "3d"
              }
            ],
            "created_time": "2026-05-12T02:36:12",
            "progress": 100
          }
        }
      },
      "TaskStatus": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "not_started",
              "running",
              "finished",
              "failed"
            ],
            "example": "finished",
            "description": "任务状态。\n\n- `not_started`：排队中，等待处理\n- `running`：生成中\n- `finished`：已完成，结果在 `files` 或 `output` 中\n- `failed`：失败，详情见 `error_message`"
          },
          "credits_amount": {
            "type": "number",
            "description": "任务消耗的积分",
            "example": 30
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FileItem"
            }
          },
          "created_time": {
            "type": "string",
            "format": "date-time"
          },
          "progress": {
            "type": "number",
            "example": 100
          },
          "error_message": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "example": {
          "task_id": "9OTM0HH9LBS63LF0",
          "status": "finished",
          "credits_amount": 30,
          "files": [
            {
              "file_url": "https://cdn.doculator.org/3d/9OTM0HH9LBS63LF0/9OTM0HH9LBS63LF0_1.glb",
              "file_type": "3d"
            },
            {
              "file_url": "https://cdn.doculator.org/3d/9OTM0HH9LBS63LF0/9OTM0HH9LBS63LF0_2.png",
              "file_type": "image"
            },
            {
              "file_url": "https://cdn.doculator.org/3d/9OTM0HH9LBS63LF0/9OTM0HH9LBS63LF0_3.glb",
              "file_type": "3d"
            }
          ],
          "created_time": "2026-05-12T02:36:12",
          "progress": 100
        }
      },
      "FileItem": {
        "type": "object",
        "required": [
          "file_url",
          "file_type"
        ],
        "properties": {
          "label": {
            "type": "string",
            "description": "模型提供时返回的可选文件标签"
          },
          "file_url": {
            "type": "string",
            "format": "uri",
            "example": "https://cdn.doculator.org/3d/9OTM0HH9LBS63LF0/9OTM0HH9LBS63LF0_1.glb"
          },
          "file_type": {
            "type": "string",
            "enum": [
              "3d",
              "image",
              "other"
            ],
            "example": "3d"
          },
          "format": {
            "type": "string",
            "description": "模型提供时返回的可选文件格式"
          },
          "content_type": {
            "type": "string",
            "description": "模型提供时返回的可选 MIME 类型"
          },
          "file_name": {
            "type": "string",
            "description": "模型提供时返回的可选文件名"
          },
          "file_size": {
            "type": "integer",
            "description": "模型提供时返回的可选文件大小（字节）"
          }
        },
        "example": {
          "file_url": "https://cdn.doculator.org/3d/9OTM0HH9LBS63LF0/9OTM0HH9LBS63LF0_1.glb",
          "file_type": "3d"
        }
      }
    }
  }
}
