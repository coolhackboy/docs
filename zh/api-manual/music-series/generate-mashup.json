{
    "openapi": "3.1.0",
    "info": {
        "title": "PoYo 生成混搭 API",
        "version": "1.0.0",
        "description": "将恰好两条音轨融合成一首新作品。"
    },
    "servers": [
        {
            "url": "https://api.poyo.ai"
        }
    ],
    "security": [
        {
            "BearerAuth": []
        }
    ],
    "paths": {
        "/api/generate/submit": {
            "post": {
                "operationId": "submitGenerateMashup",
                "summary": "生成 Suno 混搭",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Request"
                            },
                            "example": {
                                "model": "generate-mashup",
                                "callback_url": "https://example.com/webhook",
                                "input": {
                                    "upload_url_list": [
                                        "https://example.com/a.mp3",
                                        "https://example.com/b.mp3"
                                    ],
                                    "custom_mode": true,
                                    "instrumental": true,
                                    "mv": "V5_5",
                                    "style": "cinematic",
                                    "title": "Mashup",
                                    "duration": 120
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "已提交",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Response"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "BearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "description": "所有 API 接口都需要 Bearer Token 认证。\n\n创建 API Key：登录 PoYo，进入 **仪表盘 → API 密钥**（[poyo.ai/zh/dashboard/api-key](https://poyo.ai/zh/dashboard/api-key)），点击创建 Key。\n\n在请求头中添加：\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
            }
        },
        "schemas": {
            "Request": {
                "type": "object",
                "required": [
                    "model",
                    "input"
                ],
                "properties": {
                    "model": {
                        "type": "string",
                        "enum": [
                            "generate-mashup"
                        ]
                    },
                    "callback_url": {
                        "type": "string",
                        "format": "uri"
                    },
                    "input": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "upload_url_list",
                            "mv",
                            "style",
                            "title"
                        ],
                        "properties": {
                            "upload_url_list": {
                                "type": "array",
                                "minItems": 2,
                                "maxItems": 2,
                                "items": {
                                    "type": "string",
                                    "format": "uri",
                                    "pattern": "^https?://"
                                }
                            },
                            "custom_mode": {
                                "type": "boolean",
                                "default": true
                            },
                            "instrumental": {
                                "type": "boolean",
                                "default": true
                            },
                            "mv": {
                                "type": "string",
                                "enum": [
                                    "V4",
                                    "V4_5",
                                    "V4_5ALL",
                                    "V4_5PLUS",
                                    "V5",
                                    "V5_5",
                                    "V6",
                                    "V6_MINI",
                                    "V6_WILD"
                                ]
                            },
                            "prompt": {
                                "type": "string",
                                "minLength": 1
                            },
                            "style": {
                                "type": "string",
                                "minLength": 1
                            },
                            "title": {
                                "type": "string",
                                "minLength": 1
                            },
                            "vocal_gender": {
                                "type": "string",
                                "enum": [
                                    "m",
                                    "f"
                                ]
                            },
                            "style_weight": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1,
                                "multipleOf": 0.01
                            },
                            "weirdness_constraint": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1,
                                "multipleOf": 0.01
                            },
                            "audio_weight": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1,
                                "multipleOf": 0.01
                            },
                            "duration": {
                                "type": "integer",
                                "minimum": 10,
                                "maximum": 360
                            },
                            "lyrics": {"type": "string", "maxLength": 5000},
                            "variety": {"type": "integer", "minimum": 0, "maximum": 4},
                            "persona_id": {"type": "string"},
                            "persona_model": {"type": "string", "enum": ["style_persona", "voice_persona"]}
                        },
                        "allOf": [
                            {"if": {"required": ["duration"]}, "then": {"properties": {"mv": {"enum": ["V5_5", "V6", "V6_MINI", "V6_WILD"]}}}},
                            {"if": {"required": ["persona_id"]}, "then": {"properties": {"mv": {"enum": ["V5", "V5_5", "V6", "V6_MINI", "V6_WILD"]}}}},
                            {"if": {"properties": {"custom_mode": {"const": true}, "mv": {"const": "V4"}}}, "then": {"properties": {"prompt": {"maxLength": 3000}, "style": {"maxLength": 200}, "title": {"maxLength": 80}}}},
                            {"if": {"properties": {"custom_mode": {"const": true}, "mv": {"const": "V4_5ALL"}}}, "then": {"properties": {"prompt": {"maxLength": 5000}, "style": {"maxLength": 1000}, "title": {"maxLength": 80}}}},
                            {"if": {"properties": {"custom_mode": {"const": true}, "mv": {"enum": ["V4_5", "V4_5PLUS", "V5", "V5_5", "V6", "V6_MINI", "V6_WILD"]}}}, "then": {"properties": {"prompt": {"maxLength": 5000}, "style": {"maxLength": 1000}, "title": {"maxLength": 100}}}}
                        ]
                    }
                }
            },
            "Response": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "integer",
                        "example": 200,
                        "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
                        "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。"
                    },
                    "data": {
                        "type": "object",
                        "required": [
                            "task_id",
                            "status",
                            "created_time"
                        ],
                        "properties": {
                            "task_id": {
                                "type": "string"
                            },
                            "status": {
                                "type": "string",
                                "enum": [
                                    "not_started",
                                    "running",
                                    "finished",
                                    "failed"
                                ],
                                "description": "任务状态。\n\n- `not_started`：排队中，等待处理\n- `running`：生成中\n- `finished`：已完成，结果在 `files` 或 `output` 中\n- `failed`：失败，详情见 `error_message`"
                            },
                            "created_time": {
                                "type": "string",
                                "format": "date-time"
                            }
                        }
                    }
                }
            }
        }
    }
}
