{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - 创建音乐视频 API",
    "description": "根据音轨生成可视化音乐视频",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交音乐视频创建任务",
        "description": "根据音轨生成可视化音乐视频",
        "operationId": "submitCreateMusicVideoTask",
        "tags": ["Music Video"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "basic-video": {
                  "summary": "基础音乐视频",
                  "value": {
                    "model": "create-music-video",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "task_id": "taskId_774b9aa0422f",
                      "audio_id": "e231xxxx-xxxx-xxxx-xxxx-xxxx8cadc7dc"
                    }
                  }
                },
                "branded-video": {
                  "summary": "带署名的品牌音乐视频",
                  "value": {
                    "model": "create-music-video",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "task_id": "taskId_774b9aa0422f",
                      "audio_id": "e231xxxx-xxxx-xxxx-xxxx-xxxx8cadc7dc",
                      "author": "DJ Electronic",
                      "domain_name": "music.example.com"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "409": {
            "description": "音乐视频已存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 409,
                  "error": {
                    "message": "Music video already exists for this audio",
                    "type": "conflict_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "所有 API 接口都需要 Bearer Token 认证。\n\n创建 API Key：登录 PoYo，进入 **仪表盘 → API 密钥**（[poyo.ai/zh/dashboard/api-key](https://poyo.ai/zh/dashboard/api-key)），点击创建 Key。\n\n在请求头中添加：\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": ["model", "callback_url", "input"],
        "properties": {
          "model": {
            "type": "string",
            "description": "API 模型标识符。\n\n本接口必须为 `create-music-video`。",
            "enum": ["create-music-video"],
            "example": "create-music-video"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "用于接收结果通知的 Webhook 回调 URL。\n\n该地址会收到 POST 请求，内容包含音乐视频生成的完成状态和下载 URL。",
            "example": "https://your-domain.com/callback"
          },
          "input": {
            "type": "object",
            "required": ["task_id", "audio_id"],
            "description": "音乐视频创建的输入参数",
            "properties": {
              "task_id": {
                "type": "string",
                "description": "音乐生成任务的唯一标识符。\n\n应为生成音乐或扩展音乐接口返回的 task_id。",
                "example": "taskId_774b9aa0422f"
              },
              "audio_id": {
                "type": "string",
                "description": "要可视化的具体音轨的唯一标识符。\n\n音乐生成完成后，该 ID 会在回调数据中返回。",
                "example": "e231xxxx-xxxx-xxxx-xxxx-xxxx8cadc7dc"
              },
              "author": {
                "type": "string",
                "description": "显示在视频封面上的艺术家或创作者署名。\n\n最多 50 个字符。",
                "maxLength": 50,
                "example": "DJ Electronic"
              },
              "domain_name": {
                "type": "string",
                "description": "显示在视频底部的网站或品牌水印。\n\n最多 50 个字符。",
                "maxLength": 50,
                "example": "music.example.com"
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": ["code", "data"],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503]
          },
          "data": {
            "type": "object",
            "required": ["task_id", "status", "created_time"],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1757165031-uyujaw3d",
                "description": "任务唯一标识，用于查询任务状态"
              },
              "status": {
                "type": "string",
                "enum": ["not_started", "running", "finished", "failed"],
                "example": "not_started",
                "description": "任务状态。提交后立即返回时始终为 `not_started`。后续状态请通过[查询任务状态](/zh/api-manual/task-management/status)接口或 `callback_url` 获取。\n\n- `not_started`：排队中，等待处理\n- `running`：生成中\n- `finished`：已完成，结果在 `files` 或 `output` 中\n- `failed`：失败，详情见 `error_message`"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2025-11-12T10:30:00",
                "description": "任务创建时间，ISO 8601 格式"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["code", "error"],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503]
          },
          "error": {
            "type": "object",
            "required": ["message", "type"],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters",
                "description": "描述错误原因的错误信息"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error",
                "description": "错误类型标识"
              }
            }
          }
        }
      }
    }
  }
}
