{
  "openapi": "3.1.0",
  "info": {
    "title": "PoYo AI - 扩展音乐 API",
    "description": "基于源音轨创建续写，从而扩展或修改已有音乐",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交音乐扩展任务",
        "description": "基于源音轨创建续写，从而扩展或修改已有音乐",
        "operationId": "submitExtendMusicTask",
        "tags": [
          "Music Extension"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "custom-mode": {
                  "summary": "自定义模式 - 完全控制",
                  "value": {
                    "model": "extend-music",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "default_param_flag": true,
                      "audio_id": "audio_abc123",
                      "instrumental": false,
                      "prompt": "Continue with an energetic chorus section",
                      "style": "Pop, Upbeat",
                      "title": "Summer Vibes Extended",
                      "continue_at": 120,
                      "mv": "V5_5",
                      "negative_tags": "Heavy Metal, Sad",
                      "style_weight": 0.7
                    }
                  }
                },
                "simple-mode": {
                  "summary": "简单模式 - 使用原始参数",
                  "value": {
                    "model": "extend-music",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "default_param_flag": false,
                      "audio_id": "audio_abc123",
                      "mv": "V4_5PLUS"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "所有 API 接口都需要 Bearer Token 认证。\n\n创建 API Key：登录 PoYo，进入 **仪表盘 → API 密钥**（[poyo.ai/zh/dashboard/api-key](https://poyo.ai/zh/dashboard/api-key)），点击创建 Key。\n\n在请求头中添加：\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "API 模型标识符。\n\n此接口必须为 `extend-music`。",
            "enum": [
              "extend-music"
            ],
            "example": "extend-music"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "用于接收结果通知的 Webhook 回调 URL。\n\n接收任务完成更新的接口。",
            "example": "https://your-domain.com/callback"
          },
          "input": {
            "type": "object",
            "required": [
              "audio_id",
              "mv"
            ],
            "description": "音乐扩展的输入参数",
            "properties": {
              "default_param_flag": {
                "type": "boolean",
                "default": true,
                "description": "控制使用自定义参数还是继承源音频的参数。\n\n- 为 `true` 时：启用自定义参数模式。`mv`、`style`、`title` 和 `continue_at` 变为必填。人声扩展还需额外提供 `prompt`。\n\n- 为 `false` 时：`audio_id` 和 `mv` 为必填。",
                "example": true
              },
              "audio_id": {
                "type": "string",
                "description": "要扩展的源音轨标识符。\n\n这是你要续写或修改的已有曲目的唯一 ID。",
                "example": "audio_abc123"
              },
              "prompt": {
                "type": "string",
                "description": "描述你希望如何扩展音乐。\n\n当 `default_param_flag` 为 `true` 时，人声扩展必填。当 `instrumental` 为 `true` 时不会发送。\n\n各模型字符限制：\n- **V4**：最多 3000 个字符\n- **V4_5 & V4_5PLUS**：最多 5000 个字符\n- **V4_5ALL**：最多 5000 个字符\n- **V5**：最多 5000 个字符\n- **V5_5**：最多 5000 个字符\n- **V6, V6_MINI, and V6_WILD**：最多 5000 个字符",
                "example": "Continue with an energetic chorus section"
              },
              "style": {
                "type": "string",
                "description": "扩展部分的音乐风格说明。\n\n当 `default_param_flag` 为 `true` 时必填。\n\n各模型字符限制：\n- **V4**：最多 200 个字符\n- **V4_5 & V4_5PLUS**：最多 1000 个字符\n- **V4_5ALL**：最多 1000 个字符\n- **V5**：最多 1000 个字符\n- **V5_5**：最多 1000 个字符\n- **V6, V6_MINI, and V6_WILD**：最多 1000 个字符",
                "example": "Pop, Upbeat"
              },
              "title": {
                "type": "string",
                "description": "扩展后曲目的标题。\n\n当 `default_param_flag` 为 `true` 时必填。\n\n各模型字符限制：\n- **V4**：最多 80 个字符\n- **V4_5 & V4_5PLUS**：最多 100 个字符\n- **V4_5ALL**：最多 80 个字符\n- **V5**：最多 100 个字符\n- **V5_5**：最多 100 个字符\n- **V6, V6_MINI, and V6_WILD**：最多 100 个字符",
                "example": "Summer Vibes Extended"
              },
              "continue_at": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "开始扩展的时间点（秒）。\n\n指定在原曲目中从哪个位置开始扩展。\n\n当 `default_param_flag` 为 `true` 时必填。",
                "example": 120
              },
              "mv": {
                "type": "string",
                "description": "用于音乐扩展的 AI 模型版本。\n\n- **V5**：音乐表现力更出色，生成更快\n- **V5_5**：根据你的独特品味调校的个性化模型。\n- **V4_5PLUS**：音色更丰富，带来新的创作方式，最长 8 分钟\n- **V4_5**：提示词理解更智能，生成更快，最长 8 分钟\n- **V4_5ALL**：V4_5ALL 提示词更智能，生成更快，最长 8 分钟\n- **V4**：人声质量提升，最长 4 分钟\n- **V6**：音乐表现力更强，人声更自然。\n- **V6_MINI**：轻量且快速。\n- **V6_WILD**：更大胆、更有辨识度的音乐表达。",
                "enum": [
                  "V4",
                  "V4_5",
                  "V4_5ALL",
                  "V4_5PLUS",
                  "V5",
                  "V5_5",
                "V6",
                "V6_MINI",
                "V6_WILD"
                ],
                "example": "V5_5"
              },
              "negative_tags": {
                "type": "string",
                "description": "扩展中要排除的音乐风格或特征。\n\n指定输出中要避免的流派、情绪或乐器。",
                "example": "Heavy Metal, Sad"
              },
              "vocal_gender": {
                "type": "string",
                "description": "扩展部分的偏好人声性别。\n\n- `m`：男声\n- `f`：女声\n\n**注意**：此参数只会提高指定性别出现的概率，无法保证。",
                "enum": [
                  "m",
                  "f"
                ],
                "example": "m"
              },
              "style_weight": {
                "type": "number",
                "multipleOf": 0.01,
                "description": "控制指定风格对扩展的影响强度。\n\n范围：0-1，最多 2 位小数。\n\n值越高，越贴近指定风格。",
                "minimum": 0,
                "maximum": 1,
                "example": 0.7
              },
              "weirdness_constraint": {
                "type": "number",
                "multipleOf": 0.01,
                "description": "控制实验性创意和非常规元素的程度。\n\n取值范围：0-1，最多 2 位小数。\n\n- 值较低：音乐更常规\n- 值较高：输出更具实验性和独特性",
                "minimum": 0,
                "maximum": 1,
                "example": 0.5
              },
              "audio_weight": {
                "type": "number",
                "multipleOf": 0.01,
                "description": "在音频特性与其他生成因素之间取得平衡。\n\n取值范围：0-1，最多 2 位小数。\n\n调整最终输出中对音质和声音特征的侧重。",
                "minimum": 0,
                "maximum": 1,
                "example": 0.6
              },
              "persona_id": {
                "type": "string",
                "description": "应用于扩展音乐的 Persona ID。\n\n仅在启用自定义模式（`default_param_flag: true`）时可用。\n\n用于为音乐扩展应用特定的 Persona 风格。\n\n如何生成 persona_id，请参阅 [generate-persona](/zh/api-manual/music-series/generate-persona)。",
                "example": "persona_123"
              },
              "persona_model": {"type": "string", "enum": ["style_persona", "voice_persona"], "description": "Persona 类型；需要提供 persona_id、default_param_flag=true，且模型为 V5、V5_5、V6、V6_MINI 或 V6_WILD。"},
              "instrumental": {"type": "boolean", "description": "扩展是否为纯音乐。为 true 时不会发送 prompt。"}
            },
            "allOf": [
              {"if": {"properties": {"default_param_flag": {"const": true}}}, "then": {"required": ["mv", "style", "title", "continue_at"]}},
              {"if": {"properties": {"default_param_flag": {"const": true}, "instrumental": {"not": {"const": true}}}}, "then": {"required": ["prompt"]}},
              {"if": {"required": ["persona_model"]}, "then": {"required": ["persona_id"], "properties": {"default_param_flag": {"const": true}}}},
              {"if": {"required": ["persona_id"]}, "then": {"properties": {"mv": {"enum": ["V5", "V5_5", "V6", "V6_MINI", "V6_WILD"]}, "default_param_flag": {"const": true}}}},
              {"if": {"properties": {"default_param_flag": {"const": true}, "mv": {"const": "V4"}}}, "then": {"properties": {"prompt": {"maxLength": 3000}, "style": {"maxLength": 200}, "title": {"maxLength": 80}}}},
              {"if": {"properties": {"default_param_flag": {"const": true}, "mv": {"const": "V4_5ALL"}}}, "then": {"properties": {"prompt": {"maxLength": 5000}, "style": {"maxLength": 1000}, "title": {"maxLength": 80}}}},
              {"if": {"properties": {"default_param_flag": {"const": true}, "mv": {"enum": ["V4_5", "V4_5PLUS", "V5", "V5_5", "V6", "V6_MINI", "V6_WILD"]}}}, "then": {"properties": {"prompt": {"maxLength": 5000}, "style": {"maxLength": 1000}, "title": {"maxLength": 100}}}}
            ]
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503]
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1757165031-uyujaw3d",
                "description": "任务唯一标识，用于查询任务状态"
              },
              "status": {
                "type": "string",
                "enum": ["not_started", "running", "finished", "failed"],
                "example": "not_started",
                "description": "任务状态。提交后立即返回时始终为 `not_started`。后续状态请通过[查询任务状态](/zh/api-manual/task-management/status)接口或 `callback_url` 获取。\n\n- `not_started`：排队中，等待处理\n- `running`：生成中\n- `finished`：已完成，结果在 `files` 或 `output` 中\n- `failed`：失败，详情见 `error_message`"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2025-11-12T10:30:00",
                "description": "任务创建时间，ISO 8601 格式"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503]
          },
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters",
                "description": "描述错误原因的错误信息"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error",
                "description": "错误类型标识"
              }
            }
          }
        }
      }
    }
  }
}
