{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - ElevenLabs V3 TTS API",
    "description": "ElevenLabs V3 TTS API 使用列出的预设音色之一，将最多 5,000 个字符的文本转换为语音。可通过可选的 ISO 639-1 语言代码强制指定语言，时间戳可作为单独文件返回。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交 ElevenLabs V3 TTS 任务",
        "description": "将文本转换为语音音频。",
        "operationId": "submitElevenLabsV3TtsTask",
        "tags": ["ElevenLabs V3 TTS"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "text-to-speech": {
                  "summary": "文本转语音",
                  "value": {
                    "model": "elevenlabs-v3-tts",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "text": "Hello! This is a test of the text to speech system, powered by ElevenLabs.",
                      "voice": "Rachel",
                      "stability": 0.5,
                      "timestamps": false,
                      "language_code": "en",
                      "apply_text_normalization": "auto"
                    }
                  }
                },
                "with-timestamps": {
                  "summary": "请求时间戳",
                  "value": {
                    "model": "elevenlabs-v3-tts",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "text": "Every word can include timing data when timestamps are enabled.",
                      "voice": "Aria",
                      "timestamps": true
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未授权",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "所有 API 接口都需要 Bearer Token 认证。\n\n创建 API Key：登录 PoYo，进入 **仪表盘 → API 密钥**（[poyo.ai/zh/dashboard/api-key](https://poyo.ai/zh/dashboard/api-key)），点击创建 Key。\n\n在请求头中添加：\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": ["model", "input"],
        "properties": {
          "model": {
            "type": "string",
            "description": "模型标识符。",
            "enum": ["elevenlabs-v3-tts"],
            "example": "elevenlabs-v3-tts"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "接收结果通知的 Webhook 回调 URL",
            "example": "https://your-domain.com/callback"
          },
          "input": {
            "type": "object",
            "required": ["text"],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "description": "要转换为语音的文本。",
                "minLength": 1,
                "maxLength": 5000,
                "example": "Hello! This is a test of the text to speech system, powered by ElevenLabs."
              },
              "voice": {
                "type": "string",
                "description": "用于语音生成的音色名称。",
                "default": "Rachel",
                "example": "Rachel"
              },
              "stability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "音色稳定性，取值 0 到 1。",
                "default": 0.5,
                "example": 0.5
              },
              "timestamps": {
                "type": "boolean",
                "description": "是否请求词级时间戳。返回时，时间戳会作为单独的 timestamps.json 文件上传到任务文件列表中。",
                "default": false,
                "example": false
              },
              "language_code": {
                "type": "string",
                "description": "可选的 ISO 639-1 语言代码，用于强制模型使用指定语言。",
                "example": "en"
              },
              "apply_text_normalization": {
                "type": "string",
                "description": "控制文本规范化。",
                "enum": ["auto", "on", "off"],
                "default": "auto",
                "example": "auto"
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": ["code", "data"],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。"
          },
          "data": {
            "type": "object",
            "required": ["task_id", "status", "created_time"],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1757165031-uyujaw3d"
              },
              "status": {
                "type": "string",
                "enum": ["not_started", "running", "finished", "failed"],
                "example": "not_started",
                "description": "任务状态。提交后立即返回时始终为 `not_started`。后续状态请通过[查询任务状态](/zh/api-manual/task-management/status)接口或 `callback_url` 获取。\n\n- `not_started`：排队中，等待处理\n- `running`：生成中\n- `finished`：已完成，结果在 `files` 或 `output` 中\n- `failed`：失败，详情见 `error_message`"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2026-05-12T10:30:00"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。"
          },
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
