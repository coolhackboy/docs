{
  "openapi": "3.1.0",
  "info": {
    "title": "PoYo AI - 上传并扩展音频 API",
    "description": "在保留原始风格的前提下扩展音轨",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交上传并扩展音频任务",
        "description": "上传音频文件，并在保留原始风格的前提下进行扩展",
        "operationId": "submitUploadExtendTask",
        "tags": [
          "Music Generation"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "default-params": {
                  "summary": "默认参数 - 简单扩展",
                  "value": {
                    "model": "upload-and-extend-audio",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "upload_url": "https://storage.example.com/audio.mp3",
                      "default_param_flag": true,
                      "instrumental": true,
                      "style": "Classical",
                      "title": "Peaceful Piano Extended",
                      "continue_at": 60,
                      "mv": "V5_5"
                    }
                  }
                },
                "custom-params": {
                  "summary": "自定义参数 - 完全控制",
                  "value": {
                    "model": "upload-and-extend-audio",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "upload_url": "https://storage.example.com/audio.mp3",
                      "default_param_flag": true,
                      "instrumental": false,
                      "prompt": "Extend the music with more relaxing notes",
                      "style": "Classical",
                      "title": "Peaceful Piano Extended",
                      "continue_at": 60,
                      "mv": "V4_5PLUS",
                      "negative_tags": "Heavy Metal, Fast Drums",
                      "vocal_gender": "f",
                      "style_weight": 0.65
                    }
                  }
                },
                "instrumental-extension": {
                  "summary": "纯音乐音轨扩展",
                  "value": {
                    "model": "upload-and-extend-audio",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "upload_url": "https://storage.example.com/instrumental.mp3",
                      "default_param_flag": true,
                      "instrumental": true,
                      "style": "Ambient",
                      "title": "Ambient Extension",
                      "continue_at": 60,
                      "mv": "V5",
                      "prompt": "Continue the original arrangement"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "所有 API 接口都需要 Bearer Token 认证。\n\n创建 API Key：登录 PoYo，进入 **仪表盘 → API 密钥**（[poyo.ai/zh/dashboard/api-key](https://poyo.ai/zh/dashboard/api-key)），点击创建 Key。\n\n在请求头中添加：\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "API 模型标识符。\n\n此接口必须为 `upload-and-extend-audio`。",
            "enum": [
              "upload-and-extend-audio"
            ],
            "example": "upload-and-extend-audio"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "接收结果通知的 Webhook 回调 URL",
            "example": "https://your-domain.com/callback"
          },
          "input": {
            "type": "object",
            "required": [
              "upload_url",
              "mv",
              "style",
              "title",
              "continue_at"
            ],
            "description": "音频扩展的输入参数",
            "properties": {
              "upload_url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://",
                "description": "上传音频文件的 URL，无论 `default_param_flag` 为 true 还是 false 都必填。\n\n请确保上传的音频时长不超过 8 分钟。\n\n**注意**：使用 V4_5ALL 模型时，上传的音频时长不得超过 1 分钟。",
                "example": "https://storage.example.com/audio.mp3"
              },
              "default_param_flag": {
                "type": "boolean",
                "enum": [true],
                "default": true,
                "description": "此接口始终为自定义模式。省略此字段或设为 `true`，设为 `false` 会被拒绝。\n\n启用时，`upload_url`、`mv`、`style`、`title` 和 `continue_at` 为必填。",
                "example": true
              },
              "instrumental": {
                "type": "boolean",
                "default": true,
                "description": "决定音频是否为纯音乐（不含歌词）。默认为 `true`。\n\n此接口始终为自定义模式，`style`、`title`、`continue_at`、`upload_url` 和 `mv` 为必填。输出人声时，`prompt` 可选。`default_param_flag: false` 会被拒绝。",
                "example": true
              },
              "continue_at": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "开始扩展音频的时间点（单位：秒）。当 `default_param_flag` 为 `true` 时必填，且必须大于 0。\n\n用于界定原始音频的结束位置和 AI 生成扩展部分的起始位置。",
                "example": 60
              },
              "mv": {
                "type": "string",
                "description": "用于音频扩展的 AI 模型版本。\n\n- **V5**：音乐表现力更出色，生成速度更快。\n- **V5_5**：按你的独特品味调校的个性化模型。\n- **V4_5PLUS**：V4_5PLUS 音色更丰富，提供新的创作方式，最长 8 分钟。\n- **V4_5**：V4_5 提示词理解更智能，生成更快，最长 8 分钟。\n- **V4_5ALL**：V4_5ALL 提示词理解更智能，生成更快，最长 8 分钟。\n- **V4**：V4 提升了人声质量，最长 4 分钟。\n- **V6**：音乐表现力更强，人声更自然。\n- **V6_MINI**：轻量、快速。\n- **V6_WILD**：音乐表现更大胆、更有辨识度。",
                "enum": [
                  "V4",
                  "V4_5",
                  "V4_5ALL",
                  "V4_5PLUS",
                  "V5",
                  "V5_5",
                "V6",
                "V6_MINI",
                "V6_WILD"
                ],
                "example": "V5_5"
              },
              "prompt": {
                "type": "string",
                "description": "扩展音频的描述或歌词，可选。输出人声时如果省略，将自动生成歌词。\n\n各模型字符数限制：\n- **V4**：最多 3000 个字符\n- **V4_5 & V4_5PLUS**：最多 5000 个字符\n- **V4_5ALL**：最多 5000 个字符\n- **V5**：最多 5000 个字符\n- **V5_5**：最多 5000 个字符\n- **V6、V6_MINI 和 V6_WILD**：最多 5000 个字符",
                "maxLength": 5000,
                "example": "Extend the music with more relaxing notes"
              },
              "style": {
                "type": "string",
                "description": "音乐风格说明，用于定义流派、情绪或艺术方向。\n\n当 `default_param_flag` 为 `true` 时必填。\n\n各模型字符数限制：\n- **V4**：最多 200 个字符\n- **V4_5 & V4_5PLUS**：最多 1000 个字符\n- **V4_5ALL**：最多 1000 个字符\n- **V5**：最多 1000 个字符\n- **V5_5**：最多 1000 个字符\n- **V6、V6_MINI 和 V6_WILD**：最多 1000 个字符",
                "example": "Classical"
              },
              "title": {
                "type": "string",
                "description": "音轨标题，显示在播放器中并用于文件命名。\n\n各模型字符数限制：\n- **V4**：最多 80 个字符\n- **V4_5 & V4_5PLUS**：最多 100 个字符\n- **V4_5ALL**：最多 80 个字符\n- **V5**：最多 100 个字符\n- **V5_5**：最多 100 个字符\n- **V6、V6_MINI 和 V6_WILD**：最多 100 个字符",
                "maxLength": 100,
                "example": "Peaceful Piano Extended"
              },
              "negative_tags": {
                "type": "string",
                "description": "生成时要排除的音乐风格或特征。\n\n指定输出中要避免的曲风、情绪或乐器。",
                "example": "Heavy Metal, Fast Drums"
              },
              "vocal_gender": {
                "type": "string",
                "description": "生成音乐的首选人声性别。\n\n- `m`：男声\n- `f`：女声\n\n仅当 `instrumental` 为 `false` 时生效。\n\n**注意**：此参数只能提高指定性别出现的概率，无法保证。",
                "enum": [
                  "m",
                  "f"
                ],
                "example": "f"
              },
              "style_weight": {
                "type": "number",
                "multipleOf": 0.01,
                "description": "控制指定风格对生成结果的影响强度。\n\n取值范围：0-1，最多 2 位小数。\n\n值越高，越贴合指定风格。",
                "minimum": 0,
                "maximum": 1,
                "example": 0.65
              },
              "weirdness_constraint": {
                "type": "number",
                "multipleOf": 0.01,
                "description": "控制实验性创意和非常规元素的程度。\n\n取值范围：0-1，最多 2 位小数。\n\n- 值较低：音乐更常规\n- 值较高：输出更具实验性和独特性",
                "minimum": 0,
                "maximum": 1,
                "example": 0.65
              },
              "audio_weight": {
                "type": "number",
                "multipleOf": 0.01,
                "description": "在音频特性与其他生成因素之间取得平衡。\n\n取值范围：0-1，最多 2 位小数。\n\n调整最终输出中对音质和声音特征的侧重。",
                "minimum": 0,
                "maximum": 1,
                "example": 0.65
              },
              "persona_id": {
                "type": "string",
                "description": "应用于生成音乐的 Persona ID。\n\n仅在 `default_param_flag: true` 且使用 V5、V5_5、V6、V6_MINI 或 V6_WILD 时可用。\n\n如何生成 persona_id，请参阅 [generate-persona](/zh/api-manual/music-series/generate-persona)。",
                "example": "persona_123"
              },
              "persona_model": {"type": "string", "enum": ["style_persona", "voice_persona"], "description": "Persona 类型；需要提供 persona_id、default_param_flag=true，且模型为 V5、V5_5、V6、V6_MINI 或 V6_WILD。"}
            },
            "allOf": [
              {"if": {"properties": {"default_param_flag": {"const": true}}}, "then": {"required": ["mv", "style", "title", "continue_at"]}},
              {"if": {"required": ["persona_model"]}, "then": {"required": ["persona_id"], "properties": {"default_param_flag": {"const": true}}}},
              {"if": {"required": ["persona_id"]}, "then": {"properties": {"mv": {"enum": ["V5", "V5_5", "V6", "V6_MINI", "V6_WILD"]}, "default_param_flag": {"const": true}}}},
              {"if": {"properties": {"default_param_flag": {"const": true}, "mv": {"const": "V4"}}}, "then": {"properties": {"prompt": {"maxLength": 3000}, "style": {"maxLength": 200}, "title": {"maxLength": 80}}}},
              {"if": {"properties": {"default_param_flag": {"const": true}, "mv": {"const": "V4_5ALL"}}}, "then": {"properties": {"prompt": {"maxLength": 5000}, "style": {"maxLength": 1000}, "title": {"maxLength": 80}}}},
              {"if": {"properties": {"default_param_flag": {"const": true}, "mv": {"enum": ["V4_5", "V4_5PLUS", "V5", "V5_5", "V6", "V6_MINI", "V6_WILD"]}}}, "then": {"properties": {"prompt": {"maxLength": 5000}, "style": {"maxLength": 1000}, "title": {"maxLength": 100}}}}
            ]
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503]
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1757165031-uyujaw3d",
                "description": "任务唯一标识，用于查询任务状态"
              },
              "status": {
                "type": "string",
                "enum": ["not_started", "running", "finished", "failed"],
                "example": "not_started",
                "description": "任务状态。提交后立即返回时始终为 `not_started`。后续状态请通过[查询任务状态](/zh/api-manual/task-management/status)接口或 `callback_url` 获取。\n\n- `not_started`：排队中，等待处理\n- `running`：生成中\n- `finished`：已完成，结果在 `files` 或 `output` 中\n- `failed`：失败，详情见 `error_message`"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2025-11-12T10:30:00",
                "description": "任务创建时间，ISO 8601 格式"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503]
          },
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters",
                "description": "描述错误原因的错误信息"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error",
                "description": "错误类型标识"
              }
            }
          }
        }
      }
    }
  }
}
