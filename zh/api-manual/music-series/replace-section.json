{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - 替换片段 API",
    "description": "替换已生成音乐音轨的指定片段",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交替换片段任务",
        "description": "用新内容替换现有音乐音轨中的指定时间段",
        "operationId": "submitReplaceSectionTask",
        "tags": ["Music Editing"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "replace-chorus": {
                  "summary": "替换副歌片段",
                  "value": {
                    "model": "replace-section",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "task_id": "5c79xxxxbe8e",
                      "audio_id": "e231xxxx-xxxx-xxxx-xxxx-xxxx8cadc7dc",
                      "prompt": "A powerful chorus with soaring vocals",
                      "tags": "pop, upbeat",
                      "title": "Summer Dreams",
                      "infill_start_s": 30.00,
                      "infill_end_s": 60.00,
                      "full_lyrics": "Complete song lyrics including the replacement chorus"
                    }
                  }
                },
                "replace-with-lyrics": {
                  "summary": "使用完整歌词替换片段",
                  "value": {
                    "model": "replace-section",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "task_id": "5c79xxxxbe8e",
                      "audio_id": "e231xxxx-xxxx-xxxx-xxxx-xxxx8cadc7dc",
                      "prompt": "New verse lyrics here",
                      "tags": "jazz, smooth",
                      "title": "Midnight Blues",
                      "infill_start_s": 15.50,
                      "infill_end_s": 45.00,
                      "negative_tags": "rock, heavy",
                      "full_lyrics": "Complete song lyrics including modified and unmodified sections"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "所有 API 接口都需要 Bearer Token 认证。\n\n创建 API Key：登录 PoYo，进入 **仪表盘 → API 密钥**（[poyo.ai/zh/dashboard/api-key](https://poyo.ai/zh/dashboard/api-key)），点击创建 Key。\n\n在请求头中添加：\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": ["model", "input"],
        "properties": {
          "model": {
            "type": "string",
            "description": "API 模型标识符。\n\n此接口必须为 `replace-section`。",
            "enum": ["replace-section"],
            "example": "replace-section"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "接收结果通知的 Webhook 回调 URL",
            "example": "https://your-domain.com/callback"
          },
          "input": {
            "type": "object",
            "required": ["tags", "title", "infill_start_s", "infill_end_s", "full_lyrics"],
            "oneOf": [
              {"required": ["task_id", "audio_id"], "not": {"required": ["upload_url"]}},
              {"required": ["upload_url", "mv"], "not": {"anyOf": [{"required": ["task_id"]}, {"required": ["audio_id"]}]}}
            ],
            "description": "片段替换的输入参数",
            "properties": {
              "task_id": {
                "type": "string",
                "description": "原始任务 ID（父任务）。\n\n用于识别要替换片段的源音乐。",
                "example": "5c79xxxxbe8e"
              },
              "audio_id": {
                "type": "string",
                "description": "要替换的音轨唯一标识符。\n\n音乐生成完成后，此 ID 会在回调数据中返回。",
                "example": "e231xxxx-xxxx-xxxx-xxxx-xxxx8cadc7dc"
              },
              "upload_url": {"type": "string", "format": "uri", "pattern": "^https?://", "description": "HTTP(S) 上传的源音频；与 task_id/audio_id 互斥。"},
              "mv": {"type": "string", "enum": ["V4", "V4_5", "V4_5ALL", "V4_5PLUS", "V5", "V5_5", "V6", "V6_MINI", "V6_WILD"], "description": "使用 upload_url 时必填。"},
              "prompt": {
                "type": "string",
                "description": "描述替换音频内容的文本。\n\n描述你希望替换片段中包含的歌词、旋律或音乐内容。",
                "example": "A powerful chorus with soaring vocals"
              },
              "tags": {
                "type": "string",
                "pattern": "\\S",
                "description": "音乐风格标签。\n\n指定替换片段的流派、情绪或风格（例如 jazz、electronic、upbeat）。",
                "example": "pop, upbeat"
              },
              "title": {
                "type": "string",
                "pattern": "\\S",
                "description": "音乐标题。\n\n生成音轨的标题。",
                "example": "Summer Dreams"
              },
              "infill_start_s": {
                "type": "number",
                "multipleOf": 0.01,
                "description": "开始时间（秒）。替换区间至少 10 秒，且不超过源音频时长的 50%。最多支持 2 位小数。",
                "minimum": 0,
                "example": 30.00
              },
              "infill_end_s": {
                "type": "number",
                "multipleOf": 0.01,
                "description": "结束时间（秒）。必须大于 `infill_start_s`；区间至少 10 秒，且不超过源音频时长的 50%。最多支持 2 位小数。",
                "example": 60.00
              },
              "negative_tags": {
                "type": "string",
                "description": "替换时要排除的风格。\n\n指定生成片段中要避免的流派或特征。",
                "example": "rock, heavy metal"
              },
              "full_lyrics": {
                "type": "string",
                "pattern": "\\S",
                "description": "修改后的完整歌词。\n\n包含整首音轨中已修改和未修改的歌词。",
                "example": "Complete song lyrics including all sections"
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": ["code", "data"],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503]
          },
          "data": {
            "type": "object",
            "required": ["task_id", "status", "created_time"],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1757165031-uyujaw3d",
                "description": "任务唯一标识，用于查询任务状态"
              },
              "status": {
                "type": "string",
                "enum": ["not_started", "running", "finished", "failed"],
                "example": "not_started",
                "description": "任务状态。提交后立即返回时始终为 `not_started`。后续状态请通过[查询任务状态](/zh/api-manual/task-management/status)接口或 `callback_url` 获取。\n\n- `not_started`：排队中，等待处理\n- `running`：生成中\n- `finished`：已完成，结果在 `files` 或 `output` 中\n- `failed`：失败，详情见 `error_message`"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2025-11-12T10:30:00",
                "description": "任务创建时间，ISO 8601 格式"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["code", "error"],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503]
          },
          "error": {
            "type": "object",
            "required": ["message", "type"],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters",
                "description": "描述错误原因的错误信息"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error",
                "description": "错误类型标识"
              }
            }
          }
        }
      }
    }
  }
}
