{
  "openapi": "3.1.0",
  "info": {
    "title": "PoYo AI - Ideogram V4.5 API",
    "description": "Ideogram 4.5 API 可根据提示词生成图像，或编辑一张主图。编辑时最多可添加四张参考图，设置蒙版时最多三张；高精度模式会保留未编辑区域的像素。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交 Ideogram V4.5 任务",
        "description": "根据提示词生成图像，或结合参考图、可选蒙版和精度控制编辑一张主图。",
        "operationId": "submit_ideogram_v4_5",
        "tags": [
          "Ideogram V4.5"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "text-to-image": {
                  "summary": "文生图",
                  "value": {
                    "model": "ideogram-v4.5",
                    "input": {
                      "prompt": "A ceramic robot with a clean silhouette."
                    }
                  }
                },
                "image-edit": {
                  "summary": "编辑一张主图",
                  "value": {
                    "model": "ideogram-v4.5-edit",
                    "input": {
                      "prompt": "Replace the background with a blue studio.",
                      "image_urls": [
                        "https://example.com/source.png"
                      ]
                    }
                  }
                },
                "masked-edit": {
                  "summary": "使用蒙版和参考图的高精度编辑",
                  "value": {
                    "model": "ideogram-v4.5-edit",
                    "input": {
                      "prompt": "Replace the black mask area with flowers.",
                      "image_urls": [
                        "https://example.com/source.png"
                      ],
                      "mask_url": "https://example.com/mask.png",
                      "reference_image_urls": [
                        "https://example.com/flowers.png"
                      ],
                      "edit_precision": "high"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已受理；请查询任务获取最终文件。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未授权：API Key 无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "所有 API 接口都需要 Bearer Token 认证。\n\n创建 API Key：登录 PoYo，进入 **仪表盘 → API 密钥**（[poyo.ai/zh/dashboard/api-key](https://poyo.ai/zh/dashboard/api-key)），点击创建 Key。\n\n在请求头中添加：\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "ideogram-v4.5",
              "ideogram-v4.5-edit"
            ],
            "description": "文生图使用 ideogram-v4.5，图像编辑使用 ideogram-v4.5-edit。"
          },
          "input": {
            "$ref": "#/components/schemas/ModelInput"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "可选的完成或失败回调 URL。"
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "model"
              ],
              "properties": {
                "model": {
                  "const": "ideogram-v4.5"
                }
              }
            },
            "then": {
              "properties": {
                "input": {
                  "$ref": "#/components/schemas/GenerationInput"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "model"
              ],
              "properties": {
                "model": {
                  "const": "ideogram-v4.5-edit"
                }
              }
            },
            "then": {
              "properties": {
                "input": {
                  "$ref": "#/components/schemas/EditInput"
                }
              }
            }
          }
        ]
      },
      "ModelInput": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "prompt"
        ],
        "properties": {
          "prompt": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "description": "ideogram-v4.5 和 ideogram-v4.5-edit 均必填。生成或编辑提示词，1–10,000 个字符，且须包含非空白内容。"
          },
          "image_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "公开图片 URL 或图片 data URI。",
              "format": "uri"
            },
            "minItems": 1,
            "maxItems": 1,
            "description": "仅 ideogram-v4.5-edit 必填；ideogram-v4.5 不支持。必须恰好一张主源图，以公开 HTTP(S) 图片 URL 或图片 data URI 提供。"
          },
          "reference_image_urls": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "description": "公开图片 URL 或图片 data URI。",
              "format": "uri"
            },
            "description": "可选，仅限 ideogram-v4.5-edit。未提供 mask_url 时最多四张参考图，提供 mask_url 时最多三张。请提供公开 HTTP(S) 图片 URL 或图片 data URI。"
          },
          "mask_url": {
            "type": "string",
            "description": "可选，仅限 ideogram-v4.5-edit。公开 HTTP(S) 图片 URL 或图片 data URI。尺寸必须与主图一致，且同时包含黑色（编辑）和白色（保留）区域；图像内容要求在处理时检查。要求 size=auto 或不传 size。",
            "format": "uri"
          },
          "n": {
            "minimum": 1,
            "default": 1,
            "maximum": 8,
            "type": "integer",
            "description": "两个模型的输出图像数量。1 到 8 的整数；默认 1。"
          },
          "quality": {
            "enum": [
              "very_low",
              "low",
              "medium",
              "high"
            ],
            "default": "medium",
            "type": "string",
            "description": "输出质量；两个模型默认均为 medium。ideogram-v4.5 接受 low、medium 和 high。ideogram-v4.5-edit 还接受 very_low。"
          },
          "size": {
            "type": "string",
            "description": "ideogram-v4.5 默认 1:1 HD，接受 1:1、1:1 HD、4:3、3:4、16:9、9:16，或以下精确尺寸：1024x1024, 1024x3072, 1120x896, 1152x2944, 1152x864, 1248x3328, 1248x832, 1280x3072, 1280x720, 1280x800, 1296x3168, 1440x2560, 1440x2880, 1440x720, 1600x2560, 1664x2496, 1728x2304, 1792x2240, 2048x2048, 2240x1792, 2304x1728, 2496x1664, 2560x1440, 2560x1600, 2880x1440, 2944x1152, 3072x1024, 3072x1280, 3168x1296, 3328x1248, 720x1280, 720x1440, 800x1280, 832x1248, 864x1152, 896x1120。ideogram-v4.5-edit 默认 auto，即保留源图尺寸。使用蒙版或 edit_precision=high 时，要求 size 为 auto 或不传。显式比例预设或自定义 WIDTHxHEIGHT 尺寸仅适用于无蒙版的 regular 编辑。自定义编辑尺寸的宽和高均须至少 256 且能被 32 整除，总像素不超过 4,194,304，宽高比不超过 6:1。"
          },
          "edit_precision": {
            "enum": [
              "regular",
              "high"
            ],
            "type": "string",
            "description": "可选，仅限 ideogram-v4.5-edit。图像编辑默认 regular。high 启用高精度编辑并还原未改动的像素，要求 size=auto 或不传 size。"
          }
        }
      },
      "GenerationInput": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "prompt"
        ],
        "properties": {
          "quality": {
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "default": "medium",
            "type": "string",
            "description": "输出质量。"
          },
          "prompt": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "description": "提示词。须包含非空白文本。"
          },
          "n": {
            "minimum": 1,
            "default": 1,
            "maximum": 8,
            "type": "integer",
            "description": "输出图像数量。"
          },
          "size": {
            "type": "string",
            "default": "1:1 HD",
            "description": "使用 1:1、1:1 HD、4:3、3:4、16:9、9:16，或以下精确尺寸之一：1024x1024, 1024x3072, 1120x896, 1152x2944, 1152x864, 1248x3328, 1248x832, 1280x3072, 1280x720, 1280x800, 1296x3168, 1440x2560, 1440x2880, 1440x720, 1600x2560, 1664x2496, 1728x2304, 1792x2240, 2048x2048, 2240x1792, 2304x1728, 2496x1664, 2560x1440, 2560x1600, 2880x1440, 2944x1152, 3072x1024, 3072x1280, 3168x1296, 3328x1248, 720x1280, 720x1440, 800x1280, 832x1248, 864x1152, 896x1120。",
            "enum": [
              "1:1",
              "1:1 HD",
              "4:3",
              "3:4",
              "16:9",
              "9:16",
              "1024x1024",
              "1024x3072",
              "1120x896",
              "1152x2944",
              "1152x864",
              "1248x3328",
              "1248x832",
              "1280x3072",
              "1280x720",
              "1280x800",
              "1296x3168",
              "1440x2560",
              "1440x2880",
              "1440x720",
              "1600x2560",
              "1664x2496",
              "1728x2304",
              "1792x2240",
              "2048x2048",
              "2240x1792",
              "2304x1728",
              "2496x1664",
              "2560x1440",
              "2560x1600",
              "2880x1440",
              "2944x1152",
              "3072x1024",
              "3072x1280",
              "3168x1296",
              "3328x1248",
              "720x1280",
              "720x1440",
              "800x1280",
              "832x1248",
              "864x1152",
              "896x1120"
            ]
          }
        }
      },
      "EditInput": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "prompt",
          "image_urls"
        ],
        "properties": {
          "mask_url": {
            "type": "string",
            "description": "尺寸与源图相同。黑色为编辑区域，白色为保留区域，两种区域都必须存在。必须是可公开访问的 HTTP 或 HTTPS URL。",
            "format": "uri"
          },
          "reference_image_urls": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "description": "公开图片 URL 或图片 data URI。",
              "format": "uri"
            },
            "description": "最多四张参考图；提供 mask_url 时最多三张。必须是可公开访问的 HTTP 或 HTTPS URL。"
          },
          "edit_precision": {
            "enum": [
              "regular",
              "high"
            ],
            "default": "regular",
            "type": "string",
            "description": "regular 为普通编辑，high 为高精度编辑并还原未改动的像素。"
          },
          "quality": {
            "enum": [
              "very_low",
              "low",
              "medium",
              "high"
            ],
            "default": "medium",
            "type": "string",
            "description": "输出质量。"
          },
          "prompt": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "description": "提示词。须包含非空白文本。"
          },
          "n": {
            "minimum": 1,
            "default": 1,
            "maximum": 8,
            "type": "integer",
            "description": "输出图像数量。"
          },
          "size": {
            "type": "string",
            "default": "auto",
            "description": "auto 保留源图尺寸。显式尺寸仅适用于无蒙版的 regular 编辑。最小边长 256；须为 32 的倍数；总像素不超过 4194304；宽高比不超过 6:1。可使用列出的宽高比之一，或自定义 `WIDTHxHEIGHT` 尺寸，例如 `1024x768`。"
          },
          "image_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "公开图片 URL 或图片 data URI。",
              "format": "uri"
            },
            "minItems": 1,
            "maxItems": 1,
            "description": "必须恰好一张主源图。必须是可公开访问的 HTTP 或 HTTPS URL。"
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "mask_url"
              ]
            },
            "then": {
              "properties": {
                "reference_image_urls": {
                  "maxItems": 3
                },
                "size": {
                  "const": "auto"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "edit_precision"
              ],
              "properties": {
                "edit_precision": {
                  "const": "high"
                }
              }
            },
            "then": {
              "properties": {
                "size": {
                  "const": "auto"
                }
              }
            }
          }
        ]
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。"
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1757165031-uyujaw3d"
              },
              "status": {
                "type": "string",
                "enum": ["not_started", "running", "finished", "failed"],
                "example": "not_started",
                "description": "任务状态。提交后立即返回时始终为 `not_started`。后续状态请通过[查询任务状态](/zh/api-manual/task-management/status)接口或 `callback_url` 获取。\n\n- `not_started`：排队中，等待处理\n- `running`：生成中\n- `finished`：已完成，结果在 `files` 或 `output` 中\n- `failed`：失败，详情见 `error_message`"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2026-10-13T10:30:00+08:00"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。"
          },
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error"
              }
            }
          }
        }
      }
    }
  }
}
