{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - Grok Imagine Image Quality API",
    "description": "高质量 Grok Imagine Image 生成，支持文生图和图像编辑",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交 Grok Imagine Image Quality 任务",
        "description": "使用 Grok Imagine Image Quality 生成或编辑图像。提供 input.image_urls 时，PoYo 将这些图像作为编辑参考；否则根据提示词生成图像。",
        "operationId": "submitGrokImagineImageQualityTask",
        "tags": [
          "Grok Imagine Image Quality"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "text-to-image": {
                  "summary": "文生图",
                  "value": {
                    "model": "grok-imagine-image-quality",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "A premium product photo of a matte black smart speaker on a marble table, soft studio lighting",
                      "aspect_ratio": "1:1",
                      "resolution": "1K",
                      "n": 1
                    }
                  }
                },
                "image-edit": {
                  "summary": "基于参考图的图像编辑",
                  "value": {
                    "model": "grok-imagine-image-quality",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "Replace the background with a warm modern studio and keep the product shape unchanged",
                      "image_urls": [
                        "https://example.com/source-image.png"
                      ],
                      "aspect_ratio": "1:1",
                      "resolution": "2K",
                      "n": 1
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未授权：API Key 无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "所有 API 接口都需要 Bearer Token 认证。\n\n创建 API Key：登录 PoYo，进入 **仪表盘 → API 密钥**（[poyo.ai/zh/dashboard/api-key](https://poyo.ai/zh/dashboard/api-key)），点击创建 Key。\n\n在请求头中添加：\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Grok Imagine Image Quality 模型标识符",
            "enum": [
              "grok-imagine-image-quality"
            ]
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "接收结果通知的 Webhook 回调 URL",
            "example": "https://your-domain.com/callback"
          },
          "input": {
            "type": "object",
            "required": [
              "prompt"
            ],
            "description": "输入参数。提供 image_urls 时，PoYo 将这些图像作为编辑参考；否则根据提示词生成图像。",
            "properties": {
              "prompt": {
                "type": "string",
                "description": "生成或编辑提示词",
                "example": "A cinematic product photo on a clean studio background"
              },
              "image_urls": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "maxItems": 3,
                "description": "可选的参考图 URL。提供一张或多张图像用于图像编辑。",
                "example": [
                  "https://example.com/source-image.png"
                ]
              },
              "n": {
                "type": "integer",
                "minimum": 1,
                "description": "输出图像数量。",
                "default": 1,
                "example": 1
              },
              "aspect_ratio": {
                "type": "string",
                "description": "输出宽高比",
                "enum": [
                  "1:1",
                  "2:3",
                  "3:2",
                  "9:16",
                  "16:9"
                ],
                "default": "1:1",
                "example": "1:1"
              },
              "resolution": {
                "type": "string",
                "description": "输出图像分辨率档位",
                "enum": [
                  "1K",
                  "2K"
                ],
                "default": "1K",
                "example": "1K"
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503]
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1757165031-uyujaw3d",
                "description": "任务唯一标识，用于查询任务状态"
              },
              "status": {
                "type": "string",
                "enum": ["not_started", "running", "finished", "failed"],
                "example": "not_started",
                "description": "任务状态。提交后立即返回时始终为 `not_started`。后续状态请通过[查询任务状态](/zh/api-manual/task-management/status)接口或 `callback_url` 获取。\n\n- `not_started`：排队中，等待处理\n- `running`：生成中\n- `finished`：已完成，结果在 `files` 或 `output` 中\n- `failed`：失败，详情见 `error_message`"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2026-06-26T10:30:00",
                "description": "任务创建时间，ISO 8601 格式"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503]
          },
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters",
                "description": "描述错误原因的错误信息"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error",
                "description": "错误类型标识"
              }
            }
          }
        }
      }
    }
  }
}
