{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - Flux 3 Klein API",
    "description": "使用最多十张参考图像生成或编辑图像，支持 1K、2K 或 4K 输出。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交 Flux 3 Klein 任务",
        "operationId": "submitFlux3KleinTask",
        "tags": [
          "Flux 3 Klein"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "text-to-image": {
                  "summary": "生成图像",
                  "value": {
                    "model": "flux-3-klein",
                    "input": {
                      "prompt": "A red fox in fresh snow at sunrise",
                      "size": "3:2",
                      "resolution": "2K"
                    }
                  }
                },
                "edit-image": {
                  "summary": "编辑参考图像",
                  "value": {
                    "model": "flux-3-klein-edit",
                    "input": {
                      "prompt": "Keep the product from the first image and place it in a sunlit studio",
                      "image_urls": [
                        "https://example.com/product.png"
                      ],
                      "size": "4:3",
                      "resolution": "1K"
                    }
                  }
                },
                "custom-size": {
                  "summary": "使用精确像素尺寸",
                  "value": {
                    "model": "flux-3-klein",
                    "input": {
                      "prompt": "An editorial portrait with soft window light",
                      "size": "1536x1024",
                      "resolution": "2K"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未授权",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "所有 API 接口都需要 Bearer Token 认证。\n\n创建 API Key：登录 PoYo，进入 **仪表盘 → API 密钥**（[poyo.ai/zh/dashboard/api-key](https://poyo.ai/zh/dashboard/api-key)），点击创建 Key。\n\n在请求头中添加：\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "flux-3-klein",
              "flux-3-klein-edit"
            ],
            "description": "公开的模型标识。"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "任务完成或失败时接收通知的 Webhook URL。"
          },
          "input": {
            "type": "object",
            "required": [
              "prompt"
            ],
            "additionalProperties": false,
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "description": "描述完整的目标图像，包括主体、构图、背景和光照。必须包含非空白文本。"
              },
              "image_urls": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "description": "仅 flux-3-klein-edit 必填。提供 1-10 个参考图像 URL。flux-3-klein 请勿传此字段。必须是可公开访问的 HTTP 或 HTTPS URL。"
              },
              "size": {
                "type": "string",
                "default": "1:1",
                "description": "输出宽高比：1:1、4:3、3:4、16:9、9:16、3:2 或 2:3；或精确的 WIDTHxHEIGHT 像素值。自定义尺寸的宽和高均须在 256-4096 之间、能被 16 整除，并显式指定匹配的 resolution。"
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "1K",
                  "2K",
                  "4K"
                ],
                "default": "1K",
                "description": "输出分辨率档位。使用宽高比时，长边为 1024、2048 或 4096 像素，短边四舍五入到最接近的 16 的倍数。使用自定义尺寸时，由长边决定档位：不超过 1024 为 1K，大于 1024 且不超过 2048 为 2K，大于 2048 且不超过 4096 为 4K。"
              },
              "n": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4,
                "default": 1,
                "description": "输出图像数量。"
              },
              "output_format": {
                "type": "string",
                "enum": [
                  "jpeg",
                  "png",
                  "webp"
                ],
                "default": "png",
                "description": "输出图像格式。"
              },
              "enable_safety_checker": {
                "type": "boolean",
                "default": true,
                "description": "启用内容安全检查。"
              }
            },
            "description": "所选模型的参数。媒体字段仅在对应模式下必填。"
          }
        },
        "description": "使用最多十张参考图像生成或编辑图像，支持 1K、2K 或 4K 输出。",
        "x-poyo-model-requests": {
          "$ref": "#/components/schemas/ModelRequests"
        }
      },
      "TextToImageRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "flux-3-klein"
            ],
            "description": "公开的模型标识。"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "任务完成或失败时接收通知的 Webhook URL。"
          },
          "input": {
            "type": "object",
            "required": [
              "prompt"
            ],
            "additionalProperties": false,
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "description": "描述完整的目标图像，包括主体、构图、背景和光照。必须包含非空白文本。"
              },
              "size": {
                "type": "string",
                "default": "1:1",
                "oneOf": [
                  {
                    "enum": [
                      "1:1",
                      "4:3",
                      "3:4",
                      "16:9",
                      "9:16",
                      "3:2",
                      "2:3"
                    ]
                  },
                  {
                    "description": "使用 `WIDTHxHEIGHT` 格式，例如 `1024x768`。"
                  }
                ],
                "description": "输出宽高比，或精确的 WIDTHxHEIGHT 像素值。自定义尺寸的宽和高均须在 256-4096 之间、能被 16 整除，并显式指定匹配的 resolution。"
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "1K",
                  "2K",
                  "4K"
                ],
                "default": "1K",
                "description": "输出分辨率档位。使用宽高比时，长边为 1024、2048 或 4096 像素，短边四舍五入到最接近的 16 的倍数。使用自定义尺寸时，由长边决定档位：不超过 1024 为 1K，大于 1024 且不超过 2048 为 2K，大于 2048 且不超过 4096 为 4K。"
              },
              "n": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4,
                "default": 1,
                "description": "输出图像数量。"
              },
              "output_format": {
                "type": "string",
                "enum": [
                  "jpeg",
                  "png",
                  "webp"
                ],
                "default": "png",
                "description": "输出图像格式。"
              },
              "enable_safety_checker": {
                "type": "boolean",
                "default": true,
                "description": "启用内容安全检查。"
              }
            }
          }
        },
        "description": "根据文本生成 1-4 张图像，支持 1K、2K 或 4K 输出。"
      },
      "EditImageRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "flux-3-klein-edit"
            ],
            "description": "公开的模型标识。"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "任务完成或失败时接收通知的 Webhook URL。"
          },
          "input": {
            "type": "object",
            "required": [
              "prompt",
              "image_urls"
            ],
            "additionalProperties": false,
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "description": "描述完整的目标图像，包括主体、构图、背景和光照。必须包含非空白文本。"
              },
              "size": {
                "type": "string",
                "default": "1:1",
                "oneOf": [
                  {
                    "enum": [
                      "1:1",
                      "4:3",
                      "3:4",
                      "16:9",
                      "9:16",
                      "3:2",
                      "2:3"
                    ]
                  },
                  {
                    "description": "使用 `WIDTHxHEIGHT` 格式，例如 `1024x768`。"
                  }
                ],
                "description": "输出宽高比，或精确的 WIDTHxHEIGHT 像素值。自定义尺寸的宽和高均须在 256-4096 之间、能被 16 整除，并显式指定匹配的 resolution。"
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "1K",
                  "2K",
                  "4K"
                ],
                "default": "1K",
                "description": "输出分辨率档位。使用宽高比时，长边为 1024、2048 或 4096 像素，短边四舍五入到最接近的 16 的倍数。使用自定义尺寸时，由长边决定档位：不超过 1024 为 1K，大于 1024 且不超过 2048 为 2K，大于 2048 且不超过 4096 为 4K。"
              },
              "n": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4,
                "default": 1,
                "description": "输出图像数量。"
              },
              "output_format": {
                "type": "string",
                "enum": [
                  "jpeg",
                  "png",
                  "webp"
                ],
                "default": "png",
                "description": "输出图像格式。"
              },
              "enable_safety_checker": {
                "type": "boolean",
                "default": true,
                "description": "启用内容安全检查。"
              },
              "image_urls": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "description": "按提示词中的顺序排列的参考图像。可在提示词中称为第一张图、第二张图，依此类推。必须是可公开访问的 HTTP 或 HTTPS URL。"
              }
            }
          }
        },
        "description": "编辑或合成 1-10 张参考图像，支持 1K、2K 或 4K 输出。"
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "example": 200,
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。"
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1792468800-example"
              },
              "status": {
                "type": "string",
                "enum": ["not_started", "running", "finished", "failed"],
                "example": "not_started",
                "description": "任务状态。提交后立即返回时始终为 `not_started`。后续状态请通过[查询任务状态](/zh/api-manual/task-management/status)接口或 `callback_url` 获取。\n\n- `not_started`：排队中，等待处理\n- `running`：生成中\n- `finished`：已完成，结果在 `files` 或 `output` 中\n- `failed`：失败，详情见 `error_message`"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2026-10-20T12:00:00"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error"
              }
            }
          }
        }
      },
      "ModelRequests": {
        "type": "object",
        "oneOf": [
          {
            "$ref": "#/components/schemas/TextToImageRequest"
          },
          {
            "$ref": "#/components/schemas/EditImageRequest"
          }
        ],
        "discriminator": {
          "propertyName": "model",
          "mapping": {
            "flux-3-klein": "#/components/schemas/TextToImageRequest",
            "flux-3-klein-edit": "#/components/schemas/EditImageRequest"
          }
        }
      }
    }
  }
}
