{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - Seedream-5.0-Pro API",
    "description": "Seedream 5.0 Pro API 支持文生图，也可基于最多 10 张参考图进行编辑。输出分辨率为 1K 或 2K，支持多种预设宽高比。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交 Seedream-5.0-Pro 生成任务",
        "description": "旗舰级文生图与图像编辑，支持比例尺寸预设和 1K/2K 分辨率控制",
        "operationId": "submitSeedream50ProTask",
        "tags": ["Seedream-5.0-Pro"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "seedream-5-0-pro": {
                  "summary": "Seedream-5.0-Pro 文生图",
                  "value": {
                    "model": "seedream-5.0-pro",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "Editorial studio portrait of a fashion model wearing vibrant West African wax-print clothing, matching headwrap, layered bead jewelry and bracelets, confident pose, warm textured backdrop, saturated colors, dramatic fashion lighting.",
                      "size": "3:4",
                      "resolution": "2K",
                      "output_format": "jpeg"
                    }
                  }
                },
                "seedream-5-0-pro-multiple": {
                  "summary": "Seedream-5.0-Pro 多图生成",
                  "value": {
                    "model": "seedream-5.0-pro",
                    "input": {
                      "prompt": "A clean science magazine cover about renewable city infrastructure, dense but readable layout, accurate icons, modern editorial design",
                      "size": "16:9",
                      "resolution": "1K",
                      "output_format": "png"
                    }
                  }
                },
                "seedream-5-0-pro-edit": {
                  "summary": "Seedream-5.0-Pro 参考图编辑",
                  "value": {
                    "model": "seedream-5.0-pro-edit",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "Replace the perfume bottle in the first reference image with the green BB cream tube from the second reference image, keep the outdoor flower-and-water background, and apply the script logo from the third reference image to the front label.",
                      "image_urls": [
                        "https://example.com/reference-scene.jpg",
                        "https://example.com/reference-product.jpg",
                        "https://example.com/reference-logo.jpg"
                      ],
                      "size": "3:4",
                      "resolution": "2K"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 400,
                  "error": {
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "未授权：API Key 无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 401,
                  "error": {
                    "message": "Unauthorized - Invalid API key",
                    "type": "authentication_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "所有 API 接口都需要 Bearer Token 认证。\n\n创建 API Key：登录 PoYo，进入 **仪表盘 → API 密钥**（[poyo.ai/zh/dashboard/api-key](https://poyo.ai/zh/dashboard/api-key)），点击创建 Key。\n\n在请求头中添加：\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": ["model", "input"],
        "properties": {
          "model": {
            "type": "string",
            "description": "Seedream-5.0-Pro 模型标识符",
            "enum": [
              "seedream-5.0-pro",
              "seedream-5.0-pro-edit"
            ]
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "接收结果通知的 Webhook 回调 URL",
            "example": "https://your-domain.com/callback"
          },
          "input": {
            "type": "object",
            "required": ["prompt", "size", "resolution"],
            "description": "生成参数",
            "properties": {
              "prompt": {
                "type": "string",
                "description": "描述期望输出的生成或编辑提示词。",
                "example": "A premium product photo with precise typography and controlled studio lighting"
              },
              "image_urls": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "minItems": 1,
                "maxItems": 10,
                "description": "用于编辑的参考图 URL（1-10 张）。seedream-5.0-pro-edit 必填。",
                "example": ["https://example.com/reference1.jpg", "https://example.com/reference2.jpg"]
              },
              "size": {
                "type": "string",
                "description": "输出宽高比预设。省略时系统默认使用 1:1。",
                "enum": ["1:1", "4:3", "3:4", "16:9", "9:16", "2:3", "3:2", "21:9"],
                "default": "1:1",
                "example": "16:9"
              },
              "resolution": {
                "type": "string",
                "description": "输出分辨率预设。省略时系统默认使用 1K。",
                "enum": ["1K", "2K"],
                "default": "1K",
                "example": "1K"
              },
              "output_format": {
                "type": "string",
                "description": "输出图像格式。",
                "enum": ["jpeg", "png"],
                "default": "jpeg",
                "example": "jpeg"
              },
              "enable_safety_checker": {
                "type": "boolean",
                "description": "可选的安全检查开关。省略时默认为 true。",
                "default": true,
                "example": true
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": ["code", "data"],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503]
          },
          "data": {
            "type": "object",
            "required": ["task_id", "status", "created_time"],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1757165031-uyujaw3d",
                "description": "任务唯一标识，用于查询任务状态"
              },
              "status": {
                "type": "string",
                "enum": ["not_started", "running", "finished", "failed"],
                "example": "not_started",
                "description": "任务状态。提交后立即返回时始终为 `not_started`。后续状态请通过[查询任务状态](/zh/api-manual/task-management/status)接口或 `callback_url` 获取。\n\n- `not_started`：排队中，等待处理\n- `running`：生成中\n- `finished`：已完成，结果在 `files` 或 `output` 中\n- `failed`：失败，详情见 `error_message`"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2026-07-09T10:30:00",
                "description": "任务创建时间，ISO 8601 格式"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["code", "error"],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503]
          },
          "error": {
            "type": "object",
            "required": ["message", "type"],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters",
                "description": "描述错误原因的错误信息"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error",
                "description": "错误类型标识"
              }
            }
          }
        }
      }
    }
  }
}
