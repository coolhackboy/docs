{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - Seedream-4.5 API",
    "description": "Seedream 4.5 API 根据文本生成图像，或编辑最多 10 张参考图像。输出可以是 2K、4K、预设宽高比，或自定义宽高。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交 Seedream-4.5 生成任务",
        "description": "高级图像生成与编辑，支持多参考图，分辨率最高 4K",
        "operationId": "submitSeedream45Task",
        "tags": [
          "Seedream-4.5"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "seedream-4-5": {
                  "summary": "Seedream-4.5 文生图",
                  "value": {
                    "model": "seedream-4.5",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "A serene Japanese garden with cherry blossoms and a koi pond",
                      "size": "16:9",
                      "n": 1
                    }
                  }
                },
                "seedream-4-5-custom-size": {
                  "summary": "Seedream-4.5 文生图（自定义尺寸）",
                  "value": {
                    "model": "seedream-4.5",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "Seedream 4.5 API now Available on Poyo.ai",
                      "size": "1920x4096",
                      "n": 1
                    }
                  }
                },
                "seedream-4-5-edit": {
                  "summary": "Seedream-4.5 参考图编辑",
                  "value": {
                    "model": "seedream-4.5-edit",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "Transform the scene to a winter wonderland with snow",
                      "image_urls": [
                        "https://example.com/reference1.jpg",
                        "https://example.com/reference2.jpg"
                      ],
                      "size": "16:9",
                      "n": 1
                    }
                  }
                },
                "seedream-4-5-edit-custom-size": {
                  "summary": "Seedream-4.5 图像编辑（自定义尺寸）",
                  "value": {
                    "model": "seedream-4.5-edit",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "Transform the scene to a winter wonderland with snow",
                      "image_urls": [
                        "https://example.com/reference1.jpg"
                      ],
                      "size": "1920x4096",
                      "n": 1
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 400,
                  "error": {
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "未授权：API Key 无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 401,
                  "error": {
                    "message": "Unauthorized - Invalid API key",
                    "type": "authentication_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "所有 API 接口都需要 Bearer Token 认证。\n\n创建 API Key：登录 PoYo，进入 **仪表盘 → API 密钥**（[poyo.ai/zh/dashboard/api-key](https://poyo.ai/zh/dashboard/api-key)），点击创建 Key。\n\n在请求头中添加：\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Seedream-4.5 模型标识",
            "enum": [
              "seedream-4.5",
              "seedream-4.5-edit"
            ]
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "接收结果通知的 Webhook 回调 URL",
            "example": "https://your-domain.com/callback"
          },
          "input": {
            "type": "object",
            "required": [
              "prompt"
            ],
            "description": "生成参数",
            "properties": {
              "prompt": {
                "type": "string",
                "description": "描述期望输出的生成提示词",
                "maxLength": 3000,
                "example": "A beautiful sunset over the ocean"
              },
              "image_urls": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "minItems": 1,
                "maxItems": 10,
                "description": "用于图生图或编辑的参考图像 URL（1-10 张）。seedream-4.5-edit 模型必填。支持格式：JPEG、PNG。编辑模式同样支持自定义尺寸。",
                "example": [
                  "https://example.com/reference1.jpg",
                  "https://example.com/reference2.jpg"
                ]
              },
              "size": {
                "description": "文生图和编辑模式的输出尺寸。支持以下形式：\n\n1. 分辨率预设：`2K`、`4K`\n2. 比例预设：`1:1`、`4:3`、`3:4`、`16:9`、`9:16`、`3:2`、`2:3`、`21:9`\n3. 自定义字符串：`WIDTHxHEIGHT`，例如 `1920x4096`\n4. 自定义对象：`{ \"width\": 2304, \"height\": 3072 }`\n\n在编辑模式下，预设分辨率由上游模型自动处理，自定义尺寸则使用你提供的明确宽高。",
                "oneOf": [
                  {
                    "type": "string",
                    "enum": [
                      "2K",
                      "4K",
                      "1:1",
                      "4:3",
                      "3:4",
                      "16:9",
                      "9:16",
                      "3:2",
                      "2:3",
                      "21:9"
                    ],
                    "example": "16:9"
                  },
                  {
                    "type": "string",
                    "example": "1920x4096",
                    "description": "使用 `WIDTHxHEIGHT` 格式，例如 `1024x768`。"
                  },
                  {
                    "type": "object",
                    "required": [
                      "width",
                      "height"
                    ],
                    "properties": {
                      "width": {
                        "type": "integer",
                        "example": 2304
                      },
                      "height": {
                        "type": "integer",
                        "example": 3072
                      }
                    }
                  }
                ],
                "default": "1:1",
                "example": "16:9"
              },
              "n": {
                "type": "integer",
                "description": "生成图像数量（1-15）。系统按该数量预扣积分",
                "minimum": 1,
                "maximum": 15,
                "default": 1,
                "example": 1
              },
              "enable_safety_checker": {
                "type": "boolean",
                "description": "可选的安全检查开关。省略时默认为 true。",
                "default": true,
                "example": true
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503]
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1757165031-uyujaw3d",
                "description": "任务唯一标识，用于查询任务状态"
              },
              "status": {
                "type": "string",
                "enum": ["not_started", "running", "finished", "failed"],
                "example": "not_started",
                "description": "任务状态。提交后立即返回时始终为 `not_started`。后续状态请通过[查询任务状态](/zh/api-manual/task-management/status)接口或 `callback_url` 获取。\n\n- `not_started`：排队中，等待处理\n- `running`：生成中\n- `finished`：已完成，结果在 `files` 或 `output` 中\n- `failed`：失败，详情见 `error_message`"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2025-11-12T10:30:00",
                "description": "任务创建时间，ISO 8601 格式"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503]
          },
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters",
                "description": "描述错误原因的错误信息"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error",
                "description": "错误类型标识"
              }
            }
          }
        }
      }
    }
  }
}
