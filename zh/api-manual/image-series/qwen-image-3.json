{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI - Qwen Image 3 API",
    "description": "Qwen Image 3 API（含 Qwen Image 3 Pro）根据文本或一到三张参考图像生成图像。两者均支持 1K 和 2K 输出、负向提示词以及自然语言编辑。",
    "version": "1.0.0"
  },
  "servers": [{"url": "https://api.poyo.ai", "description": "生产环境"}],
  "security": [{"BearerAuth": []}],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交 Qwen Image 3 任务",
        "operationId": "submitQwenImage3Task",
        "tags": ["Qwen Image 3"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/SubmitRequest"},
              "examples": {
                "standard": {
                  "summary": "标准版参考图生成",
                  "value": {"model": "qwen-image-3", "input": {"prompt": "Transform this logo into a polished metallic badge with realistic studio lighting while preserving its recognizable shape and colors", "image_urls": ["https://storage.poyo.ai/logo.webp"], "size": "4:3", "resolution": "2K", "output_format": "jpeg", "prompt_extend": false}}
                },
                "pro-2k": {
                  "summary": "Pro 文生图",
                  "value": {"model": "qwen-image-3-pro", "input": {"prompt": "Create a refined bilingual technology conference poster with the headline Future Vision, elegant grid layout, blue and silver palette, realistic print texture", "size": "3:4", "resolution": "1K", "output_format": "png", "negative_prompt": "blurry, distorted typography, watermark", "seed": 314159}}
                },
                "reference-image": {
                  "summary": "Pro 2K 参考图生成",
                  "value": {"model": "qwen-image-3-pro", "input": {"prompt": "Transform this logo into a premium glass and brushed-metal app icon, preserve the original geometry and colors, dark blue studio background", "image_urls": ["https://storage.poyo.ai/logo.webp"], "size": "16:9", "resolution": "2K", "output_format": "png"}}
                },
                "multi-reference": {
                  "summary": "Pro 多参考图生成",
                  "value": {"model": "qwen-image-3-pro", "input": {"prompt": "Combine the original logo geometry from the first reference with the brushed-metal material and lighting from the second reference, centered premium brand emblem", "image_urls": ["https://storage.poyo.ai/logo.webp", "https://storage.poyo.ai/qwen-image-3-pro/reference-material.jpg"], "size": "1:1", "resolution": "1K", "output_format": "png"}}
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "任务提交成功", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SubmitResponse"}}}},
          "400": {"description": "请求参数无效"},
          "401": {"description": "未授权"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "所有 API 接口都需要 Bearer Token 认证。\n\n创建 API Key：登录 PoYo，进入 **仪表盘 → API 密钥**（[poyo.ai/zh/dashboard/api-key](https://poyo.ai/zh/dashboard/api-key)），点击创建 Key。\n\n在请求头中添加：\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": ["model", "input"],
        "properties": {
          "model": {"type": "string", "enum": ["qwen-image-3", "qwen-image-3-pro"]},
          "callback_url": {"type": "string", "format": "uri"},
          "input": {
            "type": "object",
            "required": ["prompt"],
            "additionalProperties": false,
            "properties": {
              "prompt": {"type": "string", "maxLength": 5000},
              "image_urls": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "format": "uri"}},
              "size": {"type": "string", "enum": ["1:1", "3:2", "2:3", "4:3", "3:4", "16:9", "9:16", "21:9"]},
              "resolution": {"type": "string", "enum": ["1K", "2K"], "default": "1K"},
              "output_format": {"type": "string", "enum": ["png", "jpeg"], "default": "png"},
              "prompt_extend": {"type": "boolean", "default": true},
              "negative_prompt": {"type": "string", "maxLength": 5000},
              "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
              "enable_safety_checker": {"type": "boolean", "default": true}
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": ["code", "data"],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。"
          },
          "data": {
            "type": "object",
            "properties": {
              "task_id": {"type": "string"},
              "status": {
                "type": "string",
                "example": "not_started",
                "enum": ["not_started", "running", "finished", "failed"],
                "description": "任务状态。提交后立即返回时始终为 `not_started`。后续状态请通过[查询任务状态](/zh/api-manual/task-management/status)接口或 `callback_url` 获取。\n\n- `not_started`：排队中，等待处理\n- `running`：生成中\n- `finished`：已完成，结果在 `files` 或 `output` 中\n- `failed`：失败，详情见 `error_message`"
              },
              "created_time": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    }
  }
}
