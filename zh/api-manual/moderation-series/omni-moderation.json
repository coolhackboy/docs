{
  "openapi": "3.1.0",
  "info": {
    "title": "PoYo AI - Omni Moderation API",
    "description": "Omni Moderation 通过 OpenAI 异步审核文本和 HTTPS 图片。通过统一生成 API 提交，然后轮询任务状态，或通过回调接收 output 中的完整 OpenAI 响应。不支持流式输出。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交 Omni Moderation 审核",
        "description": "将文本、最多一个 HTTPS 图片 URL 或两者一起加入审核队列。立即返回 not_started 状态的任务；可轮询任务状态或提供 callback_url 获取完成通知。被标记（flagged）的审核同样以 finished 状态完成。不支持流式输出。",
        "operationId": "submitOmniModerationTask",
        "tags": [
          "Moderation"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "text-only": {
                  "summary": "审核文本",
                  "value": {
                    "model": "omni-moderation-latest",
                    "input": {
                      "prompt": "A peaceful mountain landscape."
                    }
                  }
                },
                "image-only": {
                  "summary": "审核 HTTPS 图片",
                  "value": {
                    "model": "omni-moderation-latest",
                    "input": {
                      "image_urls": [
                        "https://example.com/image.jpg"
                      ]
                    }
                  }
                },
                "text-and-image": {
                  "summary": "审核文本和图片",
                  "value": {
                    "model": "omni-moderation-latest",
                    "input": {
                      "prompt": "A mountain view at sunset.",
                      "image_urls": [
                        "https://example.com/image.jpg"
                      ]
                    }
                  }
                },
                "with-callback": {
                  "summary": "带完成回调的审核",
                  "value": {
                    "model": "omni-moderation-latest",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "A peaceful mountain landscape."
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务已入队，状态为 not_started。可轮询 GET /api/generate/status/{task_id}，或在完成后接收可选的回调。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "MODERATION_TASK_ID",
                    "status": "not_started",
                    "created_time": "2026-10-14T10:00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "模型输入无效或使用了不支持的 stream 参数。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "API Key 无效。"
          }
        }
      }
    },
    "/api/generate/status/{task_id}": {
      "get": {
        "summary": "获取 Omni Moderation 审核结果",
        "description": "查询任务。完成后，data.output 包含完整的 OpenAI 审核响应，files 为空，credits_amount 为 0。",
        "operationId": "getOmniModerationTask",
        "tags": [
          "Moderation"
        ],
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "提交接口返回的任务标识。"
          }
        ],
        "responses": {
          "200": {
            "description": "当前任务状态，以及可用时的已完成审核结果。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                },
                "example": {
                  "code": 200,
                  "data": {
                    "task_id": "MODERATION_TASK_ID",
                    "status": "finished",
                    "credits_amount": 0,
                    "files": [],
                    "output": {
                      "id": "modr_example",
                      "model": "omni-moderation-latest",
                      "results": [
                        {
                          "flagged": false,
                          "categories": {
                            "harassment": false,
                            "harassment/threatening": false,
                            "hate": false,
                            "hate/threatening": false,
                            "illicit": false,
                            "illicit/violent": false,
                            "self-harm": false,
                            "self-harm/intent": false,
                            "self-harm/instructions": false,
                            "sexual": false,
                            "sexual/minors": false,
                            "violence": false,
                            "violence/graphic": false
                          },
                          "category_scores": {
                            "harassment": 0.00001,
                            "harassment/threatening": 0.00001,
                            "hate": 0.00001,
                            "hate/threatening": 0.00001,
                            "illicit": 0.00001,
                            "illicit/violent": 0.00001,
                            "self-harm": 0.00001,
                            "self-harm/intent": 0.00001,
                            "self-harm/instructions": 0.00001,
                            "sexual": 0.00001,
                            "sexual/minors": 0.00001,
                            "violence": 0.00001,
                            "violence/graphic": 0.00001
                          },
                          "category_applied_input_types": {
                            "harassment": [
                              "text"
                            ],
                            "harassment/threatening": [
                              "text"
                            ],
                            "hate": [
                              "text"
                            ],
                            "hate/threatening": [
                              "text"
                            ],
                            "illicit": [
                              "text"
                            ],
                            "illicit/violent": [
                              "text"
                            ],
                            "self-harm": [
                              "text"
                            ],
                            "self-harm/intent": [
                              "text"
                            ],
                            "self-harm/instructions": [
                              "text"
                            ],
                            "sexual": [
                              "text"
                            ],
                            "sexual/minors": [
                              "text"
                            ],
                            "violence": [
                              "text"
                            ],
                            "violence/graphic": [
                              "text"
                            ]
                          }
                        }
                      ]
                    },
                    "created_time": "2026-10-14T10:00:00",
                    "progress": 100,
                    "error_message": null
                  }
                }
              }
            }
          },
          "404": {
            "description": "任务不存在。"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "所有 API 接口都需要 Bearer Token 认证。\n\n创建 API Key：登录 PoYo，进入 **仪表盘 → API 密钥**（[poyo.ai/zh/dashboard/api-key](https://poyo.ai/zh/dashboard/api-key)），点击创建 Key。\n\n在请求头中添加：\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "additionalProperties": false,
        "description": "将 Omni Moderation 审核加入异步队列。可提供可选的 callback_url 接收完成通知。不支持流式输出。",
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "omni-moderation-latest"
            ],
            "description": "公开的模型标识。",
            "example": "omni-moderation-latest"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "可选的 Webhook 回调 URL。任务完成或失败时，POST 请求体为状态响应中的 data 对象，不含外层 code/data 包装。",
            "example": "https://your-domain.com/callback"
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "description": "prompt 和 image_urls 至少提供一个，也可同时提供。请提供非空白文本或一个 HTTPS 图片 URL。image_urls 最多接受一个 HTTPS 图片 URL，prompt 可与图片一起提供。",
            "properties": {
              "prompt": {
                "type": "string",
                "description": "要审核的文本。image_urls 包含一张图片时可省略；也可与图片一起提供。",
                "example": "A peaceful mountain landscape."
              },
              "image_urls": {
                "type": "array",
                "maxItems": 1,
                "description": "最多一个要审核的 HTTPS 图片 URL。prompt 包含非空白文本时可省略；prompt 可与图片一起提供。",
                "items": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://",
                  "description": "要审核图片的 HTTPS URL。"
                },
                "example": [
                  "https://example.com/image.jpg"
                ]
              }
            },
            "not": {
              "properties": {
                "prompt": {
                  "not": {
                    "pattern": "\\S"
                  }
                },
                "image_urls": {
                  "maxItems": 0
                }
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。"
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "description": "将此任务标识用于 GET /api/generate/status/{task_id}。",
                "example": "MODERATION_TASK_ID"
              },
              "status": {
                "type": "string",
                "enum": ["not_started", "running", "finished", "failed"],
                "description": "初始的排队状态。提交后审核异步执行。"
              },
              "created_time": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "StatusResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。"
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "credits_amount",
              "files",
              "created_time",
              "progress"
            ],
            "properties": {
              "task_id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "not_started",
                  "running",
                  "finished",
                  "failed"
                ],
                "description": "finished 表示审核已完成，包括 results[].flagged 为 true 的情况。"
              },
              "credits_amount": {
                "type": "number",
                "const": 0,
                "description": "该任务扣除的积分。"
              },
              "files": {
                "type": "array",
                "maxItems": 0,
                "items": {
                  "type": "object"
                },
                "description": "对 Omni Moderation 始终为空。请从 output 读取结构化审核结果。"
              },
              "output": {
                "$ref": "#/components/schemas/ModerationOutput",
                "description": "完整的 OpenAI 响应，审核完成后可用。"
              },
              "created_time": {
                "type": "string",
                "format": "date-time"
              },
              "progress": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "error_message": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "请求失败时的任务执行错误。已完成审核中被标记的内容不属于执行错误。"
              }
            }
          }
        }
      },
      "ModerationOutput": {
        "type": "object",
        "description": "完整的 OpenAI Moderations API 响应，原样保留，不会把审核结果转换为生成文件。",
        "required": [
          "id",
          "model",
          "results"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "description": "OpenAI 审核响应标识。"
          },
          "model": {
            "type": "string",
            "description": "OpenAI 返回的模型标识，可能解析为带日期的模型版本。"
          },
          "results": {
            "type": "array",
            "description": "OpenAI 返回的审核分类结果。",
            "items": {
              "type": "object",
              "required": [
                "flagged",
                "categories",
                "category_scores",
                "category_applied_input_types"
              ],
              "additionalProperties": true,
              "properties": {
                "flagged": {
                  "type": "boolean",
                  "description": "OpenAI 是否将被审核内容标记为 flagged。true 表示审核已完成，不代表任务失败。"
                },
                "categories": {
                  "type": "object",
                  "description": "OpenAI 类别名称到分类布尔值的映射。",
                  "additionalProperties": {
                    "type": "boolean"
                  }
                },
                "category_scores": {
                  "type": "object",
                  "description": "OpenAI 类别名称到置信度分数的映射。",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "category_applied_input_types": {
                  "type": "object",
                  "description": "每个类别所使用的输入模态。",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "text",
                        "image"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。"
          },
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  }
}
