            "description": "公开图片 URL 或图片 data URI。必须是可公开访问的 HTTP 或 HTTPS URL。",
            "format": "uri"
          },
          "enable_animation": {
            "type": "boolean",
            "default": false,
            "description": "应用动画；要求 enable_rigging=true。"
          },
          "target_polycount": {
            "default": 30000,
            "type": "integer",
            "minimum": 100,
            "maximum": 300000,
            "description": "100-300000 个面。智能拓扑：最多 15000，省略时默认 4000。"
          },
          "animation_action_id": {
            "type": "integer",
            "default": 92,
            "minimum": 0,
            "maximum": 696,
            "description": "动画预设 ID，0-696。"
          },
          "geometry_resolution": {
            "enum": [
              "standard",
              "2k",
              "4k"
            ],
            "type": "string",
            "description": "几何分辨率。仅当 model_type 为 standard（默认）时可用；smart-topology 时请省略。"
          },
          "rigging_height_meters": {
            "exclusiveMinimum": 0,
            "type": "number",
            "default": 1.7,
            "description": "角色身高（米），必须大于 0。"
          },
          "pose_mode": {
            "enum": [
              "a-pose",
              "t-pose",
              ""
            ],
            "type": "string",
            "default": "",
            "description": "角色姿势；空字符串表示不指定姿势。"
          },
          "symmetry_mode": {
            "enum": [
              "off",
              "auto",
              "on"
            ],
            "type": "string",
            "default": "auto",
            "description": "网格对称行为。"
          },
          "enable_safety_checker": {
            "type": "boolean",
            "default": true,
            "description": "启用输入安全检查。如适用，关闭此项需要账户授权。"
          },
          "enable_pbr": {
            "type": "boolean",
            "default": false,
            "description": "生成 PBR 纹理贴图。"
          },
          "enable_rigging": {
            "type": "boolean",
            "default": false,
            "description": "为生成的人形角色绑定骨骼。"
          },
          "topology": {
            "enum": [
              "quad",
              "triangle"
            ],
            "type": "string",
            "default": "triangle",
            "description": "输出网格拓扑。"
          },
          "texture_prompt": {
            "type": "string",
            "maxLength": 600,
            "description": "纹理引导文本，最多 600 个字符。"
          },
          "image_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "公开图片 URL 或图片 data URI。",
              "format": "uri"
            },
            "minItems": 1,
            "maxItems": 1,
            "description": "图片 URL。必须是可公开访问的 HTTP 或 HTTPS URL。"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": [
                "enable_animation"
              ],
              "properties": {
                "enable_animation": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "enable_rigging"
              ],
              "properties": {
                "enable_rigging": {
                  "const": true
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "model_type"
              ],
              "properties": {
                "model_type": {
                  "const": "smart-topology"
                }
              }
            },
            "then": {
              "properties": {
                "target_polycount": {
                  "maximum": 15000
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "geometry_resolution"
              ]
            },
            "then": {
              "properties": {
                "model_type": {
                  "const": "standard"
                }
              }
            }
          }
        ]
      },
      "MultiImageTo3DInput": {
        "type": "object",
        "required": [
          "image_urls"
        ],
        "properties": {
          "should_texture": {
            "type": "boolean",
            "default": true,
            "description": "生成纹理。"
          },
          "should_remesh": {
            "type": "boolean",
            "default": true,
            "description": "启用重新网格化。"
          },
          "texture_image_url": {
            "type": "string",
            "description": "公开图片 URL 或图片 data URI。必须是可公开访问的 HTTP 或 HTTPS URL。",
            "format": "uri"
          },
          "enable_animation": {
            "type": "boolean",
            "default": false,
            "description": "应用动画；要求 enable_rigging=true。"
          },
          "target_polycount": {
            "default": 30000,
            "type": "integer",
            "minimum": 100,
            "maximum": 300000,
            "description": "目标面数：100-300000。"
          },
          "animation_action_id": {
            "type": "integer",
            "default": 92,
            "minimum": 0,
            "maximum": 696,
            "description": "动画预设 ID，0-696。"
          },
          "geometry_resolution": {
            "enum": [
