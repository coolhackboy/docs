            ],
            "type": "string",
            "description": "几何分辨率；多图生成不支持 4k。"
          },
          "rigging_height_meters": {
            "exclusiveMinimum": 0,
            "type": "number",
            "default": 1.7,
            "description": "角色身高（米），必须大于 0。"
          },
          "pose_mode": {
            "enum": [
              "a-pose",
              "t-pose",
              ""
            ],
            "type": "string",
            "default": "",
            "description": "角色姿势；空字符串表示不指定姿势。"
          },
          "symmetry_mode": {
            "enum": [
              "off",
              "auto",
              "on"
            ],
            "type": "string",
            "default": "auto",
            "description": "网格对称行为。"
          },
          "enable_safety_checker": {
            "type": "boolean",
            "default": true,
            "description": "启用输入安全检查。如适用，关闭此项需要账户授权。"
          },
          "enable_pbr": {
            "type": "boolean",
            "default": false,
            "description": "生成 PBR 纹理贴图。"
          },
          "topology": {
            "enum": [
              "quad",
              "triangle"
            ],
            "type": "string",
            "default": "triangle",
            "description": "输出网格拓扑。"
          },
          "enable_rigging": {
            "type": "boolean",
            "default": false,
            "description": "为生成的人形角色绑定骨骼。"
          },
          "image_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "公开图片 URL 或图片 data URI。",
              "format": "uri"
            },
            "minItems": 1,
            "maxItems": 4,
            "description": "图片 URL。必须是可公开访问的 HTTP 或 HTTPS URL。"
          },
          "texture_prompt": {
            "type": "string",
            "maxLength": 600,
            "description": "纹理引导文本，最多 600 个字符。"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": [
                "enable_animation"
              ],
              "properties": {
                "enable_animation": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "enable_rigging"
              ],
              "properties": {
                "enable_rigging": {
                  "const": true
                }
              }
            }
          },
          {
            "if": {
              "anyOf": [
                {
                  "required": [
                    "enable_pbr"
                  ],
                  "properties": {
                    "enable_pbr": {
                      "const": true
                    }
                  }
                },
                {
                  "required": [
                    "texture_prompt"
                  ]
                },
                {
                  "required": [
                    "texture_image_url"
                  ]
                }
              ]
            },
            "then": {
              "properties": {
                "should_texture": {
                  "const": true
                }
              }
            }
          }
        ]
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "code",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。"
          },
          "data": {
            "type": "object",
            "required": [
              "task_id",
              "status",
              "created_time"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1757165031-uyujaw3d"
              },
              "status": {
                "type": "string",
                "enum": ["not_started", "running", "finished", "failed"],
                "example": "not_started",
                "description": "任务状态。提交后立即返回时始终为 `not_started`。后续状态请通过[查询任务状态](/zh/api-manual/task-management/status)接口或 `callback_url` 获取。\n\n- `not_started`：排队中，等待处理\n- `running`：生成中\n- `finished`：已完成，结果在 `files` 或 `output` 中\n- `failed`：失败，详情见 `error_message`"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2026-10-13T10:30:00+08:00"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。"
          },
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request parameters"
              },
              "type": {
                "type": "string",
                "example": "invalid_request_error"
              }
            }
          }
        }
      }
    }
  }
}
