{
  "openapi": "3.0.0",
  "info": {
    "title": "PoYo AI API",
    "description": "专业的图像、视频与 3D 生成 API",
    "version": "1.0.0",
    "contact": {
      "email": "support@poyo.ai"
    }
  },
  "servers": [
    {
      "url": "https://api.poyo.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/generate/submit": {
      "post": {
        "summary": "提交生成任务",
        "description": "提交图像或视频生成任务。该接口支持多种图像和视频生成模型。",
        "operationId": "submitGenerationTask",
        "tags": ["Generation"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "gpt-4o-image": {
                  "summary": "GPT-4o 图像生成",
                  "value": {
                    "model": "gpt-4o-image",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "A serene mountain landscape at sunset with vibrant colors",
                      "size": "1:1",
                      "n": 1
                    }
                  }
                },
                "gpt-4o-image-edit": {
                  "summary": "GPT-4o 图像编辑",
                  "value": {
                    "model": "gpt-4o-image-edit",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "Replace the sky with a starry night sky",
                      "image_urls": ["https://example.com/original-image.jpg"],
                      "mask_url": "https://example.com/mask.png",
                      "size": "1:1"
                    }
                  }
                },
                "nano-banana": {
                  "summary": "Nano Banana 图像生成",
                  "value": {
                    "model": "nano-banana",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "A cyberpunk street scene with neon signs and rain",
                      "size": "16:9"
                    }
                  }
                },
                "nano-banana-edit": {
                  "summary": "Nano Banana 图像编辑",
                  "value": {
                    "model": "nano-banana-edit",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "Add colorful flowers in the foreground",
                      "image_urls": ["https://example.com/landscape.jpg"],
                      "size": "16:9"
                    }
                  }
                },
                "sora-2": {
                  "summary": "Sora 2 视频生成",
                  "value": {
                    "model": "sora-2",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "A time-lapse of a bustling city street transitioning from day to night",
                      "duration": 15,
                      "aspect_ratio": "16:9"
                    }
                  }
                },
                "sora-2-pro": {
                  "summary": "Sora 2 Pro 视频生成",
                  "value": {
                    "model": "sora-2-pro",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "A cinematic drone shot flying through a misty forest at dawn",
                      "duration": 25,
                      "aspect_ratio": "16:9"
                    }
                  }
                },
                "veo3.1-fast": {
                  "summary": "VEO 3.1 Fast 视频生成",
                  "value": {
                    "model": "veo3.1-fast",
                    "callback_url": "https://your-domain.com/callback",
                    "input": {
                      "prompt": "A peaceful stream flowing through a lush green forest",
                      "duration": 8,
                      "aspect_ratio": "16:9"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "任务提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未授权：API Key 无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/generate/status/{task_id}": {
      "get": {
        "summary": "获取任务状态",
        "description": "查询生成任务的状态和结果",
        "operationId": "getTaskStatus",
        "tags": ["Task Management"],
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "任务唯一标识"
          }
        ],
        "responses": {
          "200": {
            "description": "成功获取任务状态",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          },
          "404": {
            "description": "任务不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "所有 API 接口都需要 Bearer Token 认证。\n\n创建 API Key：登录 PoYo，进入 **仪表盘 → API 密钥**（[poyo.ai/zh/dashboard/api-key](https://poyo.ai/zh/dashboard/api-key)），点击创建 Key。\n\n在请求头中添加：\n\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": ["model"],
        "properties": {
          "model": {
            "type": "string",
            "description": "用于图像或视频生成的模型标识"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "接收结果通知的 Webhook 回调 URL",
            "example": "https://your-domain.com/callback"
          },
          "input": {
            "type": "object",
            "required": ["prompt"],
            "description": "生成参数",
            "properties": {
              "prompt": {
                "type": "string",
                "description": "描述期望输出的生成提示词。提示词长度限制因模型而异，具体限制见各模型页面。",
                "maxLength": 20000,
                "example": "A beautiful sunset over the ocean"
              },
              "image_urls": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "description": "参考图片 URL（用于图像编辑或图生视频）",
                "example": []
              },
              "size": {
                "type": "string",
                "description": "图像尺寸（例如 '1:1'）",
                "example": "1:1"
              },
              "n": {
                "type": "integer",
                "description": "生成图像的数量",
                "minimum": 1,
                "maximum": 4,
                "example": 1
              },
              "duration": {
                "type": "integer",
                "description": "视频时长（秒）",
                "example": 15
              },
              "aspect_ratio": {
                "type": "string",
                "description": "视频宽高比",
                "example": "16:9"
              },
              "mask_url": {
                "type": "string",
                "format": "uri",
                "description": "用于编辑的蒙版图片 URL",
                "example": "https://example.com/mask.png"
              }
            }
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": ["code", "data"],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503]
          },
          "data": {
            "type": "object",
            "required": ["task_id", "status", "created_time"],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1757165031-uyujaw3d",
                "description": "任务唯一标识，用于查询任务状态"
              },
              "status": {
                "type": "string",
                "enum": ["not_started", "running", "finished", "failed"],
                "example": "not_started",
                "description": "任务状态。提交后立即返回时始终为 `not_started`。后续状态请通过[查询任务状态](/zh/api-manual/task-management/status)接口或 `callback_url` 获取。\n\n- `not_started`：排队中，等待处理\n- `running`：生成中\n- `finished`：已完成，结果在 `files` 或 `output` 中\n- `failed`：失败，详情见 `error_message`"
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2025-11-12T10:30:00",
                "description": "任务创建时间，ISO 8601 格式"
              }
            }
          }
        },
        "example": {
          "code": 200,
          "data": {
            "task_id": "task-unified-1757165031-uyujaw3d",
            "status": "not_started",
            "created_time": "2025-11-12T10:30:00"
          }
        }
      },
      "StatusResponse": {
        "type": "object",
        "required": ["code", "data"],
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503]
          },
          "data": {
            "type": "object",
            "required": ["task_id", "status", "credits_amount", "files", "created_time", "progress"],
            "properties": {
              "task_id": {
                "type": "string",
                "example": "task-unified-1757165031-uyujaw3d",
                "description": "任务唯一标识"
              },
              "status": {
                "type": "string",
                "enum": ["not_started", "running", "finished", "failed"],
                "example": "finished",
                "description": "任务状态。\n\n- `not_started`：排队中，等待处理\n- `running`：生成中\n- `finished`：已完成，结果在 `files` 或 `output` 中\n- `failed`：失败，详情见 `error_message`"
              },
              "credits_amount": {
                "type": "number",
                "example": 2,
                "description": "任务消耗的积分"
              },
              "output": {
                "type": "object",
                "additionalProperties": true,
                "description": "可选的结构化模型输出。任务完成后，Omni Moderation 会在此返回完整的 OpenAI 审核响应，其 files 数组为空。"
              },
              "files": {
                "type": "array",
                "description": "生成的媒体文件（status 为 finished 时填充）",
                "items": {
                  "type": "object",
                  "required": ["file_url", "file_type"],
                  "properties": {
                    "file_url": {
                      "type": "string",
                      "format": "uri",
                      "example": "https://storage.poyo.ai/generated/image-abc123.jpg",
                      "description": "生成文件的直链（有效期 24 小时）"
                    },
                    "file_type": {
                      "type": "string",
                      "enum": ["image", "video", "3d", "other"],
                      "example": "image",
                      "description": "生成文件的类型：'image'、'video'、'3d' 或 'other'"
                    },
                    "label": {
                      "type": "string",
                      "description": "可选的文件标签，常用于 3D 输出"
                    },
                    "format": {
                      "type": "string",
                      "description": "可选的文件格式，如 glb、fbx、obj、png 或 mp4"
                    },
                    "content_type": {
                      "type": "string",
                      "description": "可选的生成文件 MIME 类型"
                    },
                    "file_name": {
                      "type": "string",
                      "description": "可选的文件名"
                    },
                    "file_size": {
                      "type": "integer",
                      "description": "可选的文件大小（字节）"
                    }
                  }
                },
                "example": [
                  {
                    "file_url": "https://storage.poyo.ai/generated/image-abc123.jpg",
                    "file_type": "image"
                  }
                ]
              },
              "created_time": {
                "type": "string",
                "format": "date-time",
                "example": "2025-11-12T10:30:00",
                "description": "任务创建时间的 ISO 8601 时间戳"
              },
              "progress": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100,
                "example": 100,
                "description": "完成百分比"
              },
              "error_message": {
                "type": "string",
                "nullable": true,
                "example": null,
                "description": "错误描述（status 为 failed 时）"
              }
            }
          }
        },
        "example": {
          "code": 200,
          "data": {
            "task_id": "task-unified-1757165031-uyujaw3d",
            "status": "finished",
            "credits_amount": 2,
            "files": [
              {
                "file_url": "https://storage.poyo.ai/generated/image-abc123.jpg",
                "file_type": "image"
              }
            ],
            "created_time": "2025-11-12T10:30:00",
            "progress": 100,
            "error_message": null
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "enum": [200, 400, 401, 402, 403, 404, 408, 429, 500, 502, 503],
            "description": "业务状态码。`200` 表示成功，其他值都表示请求失败。请务必检查这个字段：部分参数校验错误会以 HTTP 200 返回，响应体里的 `code` 为 `400`。\n\n- `200`：成功\n- `400`：请求参数无效\n- `401`：API Key 缺失或无效\n- `402`：积分不足\n- `403`：没有权限\n- `404`：资源不存在\n- `408`：请求超时\n- `429`：请求频率超限\n- `500`：服务器内部错误\n- `502`：上游服务错误\n- `503`：服务暂不可用\n\n详见[错误码](/zh/api-manual/error-codes)。"
          },
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
